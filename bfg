-- Builder binding ---------------------------------------

BindBuilders = function(target, container, allowSection)
    for name, builder in pairs(Builders) do
        if allowSection or name ~= "Section" then
            local fn = function(_, o)
                return builder(container, o or {})
            end
            target["Create" .. name] = fn
            target["Add" .. name] = fn
        end
    end
end

--========================================================--
--  Window
--========================================================--

function Library:CreateWindow(opts)
    opts = opts or {}
    if opts.Theme then Library:SetTheme(opts.Theme) end
    if opts.ToggleKey then
        Library.ToggleKey = ResolveKey(opts.ToggleKey) or Library.ToggleKey
    end
    if opts.ConfigFolder then Library.ConfigFolder = opts.ConfigFolder end

    local Window = { Tabs = {}, Minimized = false, CurrentTab = nil }

    local size = opts.Size or UDim2.fromOffset(600, 440)
    if typeof(size) == "Vector2" then size = UDim2.fromOffset(size.X, size.Y) end
    local minSize = opts.MinSize or Vector2.new(460, 320)
    local offset = #Library.Windows * 24

    local main = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Background,
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = opts.Position or UDim2.new(0.5, offset, 0.5, offset),
        Size             = size,
        ClipsDescendants = true,
        Parent           = Library.ScreenGui,
    }), { BackgroundColor3 = "Background" })
    Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = main })
    Themed(Create("UIStroke", { Thickness = 1, Parent = main }), { Color = "Outline" })

    Window.Main = main
    Window.FullSize = size

    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            Library._zTop = Library._zTop + 1
            main.ZIndex = Library._zTop
        end
    end)

    -- Topbar
    local topbar = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Topbar,
        Size             = UDim2.new(1, 0, 0, 38),
        Parent           = main,
    }), { BackgroundColor3 = "Topbar" })
    Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = topbar })
    Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Topbar,
        Position         = UDim2.new(0, 0, 1, -10),
        Size             = UDim2.new(1, 0, 0, 10),
        BorderSizePixel  = 0,
        Parent           = topbar,
    }), { BackgroundColor3 = "Topbar" })

    local titleLabel = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 14, 0, 0),
        Size           = UDim2.new(0.6, 0, 1, 0),
        Font           = Enum.Font.GothamBold,
        Text           = tostring(opts.Title or "NebulaUI"),
        TextSize       = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent         = topbar,
    }), { TextColor3 = "Text" })

    local subLabel = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 18 + titleLabel.TextBounds.X, 0, 1),
        Size           = UDim2.new(0.3, 0, 1, 0),
        Font           = Enum.Font.Gotham,
        Text           = tostring(opts.SubTitle or ""),
        TextSize       = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent         = topbar,
    }), { TextColor3 = "SubText" })
    titleLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
        subLabel.Position = UDim2.new(0, 18 + titleLabel.TextBounds.X, 0, 1)
    end)

    local btnHolder = Create("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position    = UDim2.new(1, 0, 0, 0),
        Size        = UDim2.new(0, 68, 1, 0),
        Parent      = topbar,
    })

    local function TopbarButton(text, xOffset)
        local b = Themed(Create("TextButton", {
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Position = UDim2.new(0, xOffset, 0, 0),
            Size     = UDim2.new(0, 30, 1, 0),
            Font     = Enum.Font.GothamBold,
            Text     = text,
            TextSize = 14,
            Parent   = btnHolder,
        }), { TextColor3 = "SubText" })
        b.MouseEnter:Connect(function()
            Tween(b, { TextColor3 = Library.Theme.Text }, 0.1)
        end)
        b.MouseLeave:Connect(function()
            Tween(b, { TextColor3 = Library.Theme.SubText }, 0.1)
        end)
        return b
    end

    local minimizeBtn = TopbarButton("─", 4)
    local closeBtn = TopbarButton("✕", 34)

    -- Separator lines
    Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Outline,
        Position         = UDim2.new(0, 0, 0, 38),
        Size             = UDim2.new(1, 0, 0, 1),
        BorderSizePixel  = 0,
        Parent           = main,
    }), { BackgroundColor3 = "Outline" })
    Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Outline,
        Position         = UDim2.new(0, 150, 0, 39),
        Size             = UDim2.new(0, 1, 1, -39),
        BorderSizePixel  = 0,
        Parent           = main,
    }), { BackgroundColor3 = "Outline" })

    -- Sidebar
    local sidebar = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Sidebar,
        Position         = UDim2.new(0, 0, 0, 39),
        Size             = UDim2.new(0, 150, 1, -39),
        Parent           = main,
    }), { BackgroundColor3 = "Sidebar" })

    local tabList = Themed(Create("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel     = 0,
        Size                = UDim2.new(1, 0, 1, 0),
        CanvasSize          = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness  = 2,
        Parent              = sidebar,
    }, {
        Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
        Create("UIPadding", {
            PaddingTop   = UDim.new(0, 8),
            PaddingLeft  = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 8),
        }),
    }), { ScrollBarImageColor3 = "Accent" })

    -- Content
    local content = Create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 151, 0, 39),
        Size     = UDim2.new(1, -151, 1, -39),
        Parent   = main,
    })

    -- Dragging (exclude topbar buttons)
    MakeDraggable(topbar, main, { btnHolder })

    -- Resize grip
    local grip = Create("TextButton", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position    = UDim2.new(1, 0, 1, 0),
        Size        = UDim2.new(0, 18, 0, 18),
        Text        = "",
        ZIndex      = 10,
        Parent      = main,
    })
    Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.SubText,
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new(0.5, 2, 0.5, 2),
        Size             = UDim2.new(0, 10, 0, 1),
        Rotation         = -45,
        BorderSizePixel  = 0,
        Parent           = grip,
    }), { BackgroundColor3 = "SubText" })
    Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.SubText,
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new(0.5, 4, 0.5, 4),
        Size             = UDim2.new(0, 5, 0, 1),
        Rotation         = -45,
        BorderSizePixel  = 0,
        Parent           = grip,
    }), { BackgroundColor3 = "SubText" })
    if opts.Resizable ~= false then
        MakeResizable(grip, main, minSize, Window)
    else
        grip.Visible = false
    end

    -- Tabs
    function Window:CreateTab(tabOpts)
        if type(tabOpts) == "string" then tabOpts = { Title = tabOpts } end
        tabOpts = tabOpts or {}
        local Tab = { Title = tostring(tabOpts.Title or "Tab") }

        local btn = Themed(Create("TextButton", {
            Text             = "",
            AutoButtonColor  = false,
            BackgroundColor3 = Library.Theme.Element,
            BackgroundTransparency = 1,
            Size             = UDim2.new(1, 0, 0, 32),
            LayoutOrder      = #Window.Tabs + 1,
            Parent           = tabList,
        }), { BackgroundColor3 = "Element" })
        Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = btn })

        local indicator = Themed(Create("Frame", {
            BackgroundColor3 = Library.Theme.Accent,
            BackgroundTransparency = 1,
            AnchorPoint      = Vector2.new(0, 0.5),
            Position         = UDim2.new(0, 2, 0.5, 0),
            Size             = UDim2.new(0, 3, 0, 14),
            BorderSizePixel  = 0,
            Parent           = btn,
        }, {
            Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        }), { BackgroundColor3 = "Accent" })

        local textX = 12
        if tabOpts.Icon then
            local icon = tabOpts.Icon
            if type(icon) == "number" then icon = "rbxassetid://" .. icon end
            Create("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0, 0.5),
                Position    = UDim2.new(0, 10, 0.5, 0),
                Size        = UDim2.new(0, 16, 0, 16),
                Image       = icon,
                Parent      = btn,
            })
            textX = 32
        end

        local label = Create("TextLabel", {
            BackgroundTransparency = 1,
            Position       = UDim2.new(0, textX, 0, 0),
            Size           = UDim2.new(1, -textX - 4, 1, 0),
            Font           = Enum.Font.GothamMedium,
            Text           = Tab.Title,
            TextSize       = 13,
            TextColor3     = Library.Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate   = Enum.TextTruncate.AtEnd,
            Parent         = btn,
        })

        local page = Themed(Create("ScrollingFrame", {
            BackgroundTransparency = 1,
            BorderSizePixel     = 0,
            Size                = UDim2.new(1, 0, 1, 0),
            CanvasSize          = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness  = 3,
            Visible             = false,
            Parent              = content,
        }, {
            Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
            Create("UIPadding", {
                PaddingTop    = UDim.new(0, 10),
                PaddingBottom = UDim.new(0, 10),
                PaddingLeft   = UDim.new(0, 10),
                PaddingRight  = UDim.new(0, 10),
            }),
        }), { ScrollBarImageColor3 = "Accent" })

        Tab.Button = btn
        Tab.Label = label
        Tab.Indicator = indicator
        Tab.Page = page

        BindBuilders(Tab, page, true)

        btn.MouseButton1Click:Connect(function()
            Window:SelectTab(Tab)
        end)

        table.insert(Window.Tabs, Tab)
        if not Window.CurrentTab then
            Window:SelectTab(Tab)
        end
        return Tab
    end
    Window.AddTab = Window.CreateTab

    function Window:SelectTab(tab)
        if type(tab) == "number" then tab = Window.Tabs[tab] end
        if not tab then return end
        Window.CurrentTab = tab
        for _, t in ipairs(Window.Tabs) do
            local sel = (t == tab)
            t.Page.Visible = sel
            Tween(t.Button, { BackgroundTransparency = sel and 0 or 1 }, 0.15)
            Tween(t.Label, { TextColor3 = sel and Library.Theme.Text or Library.Theme.SubText }, 0.15)
            Tween(t.Indicator, { BackgroundTransparency = sel and 0 or 1 }, 0.15)
        end
    end

    table.insert(Library._themeCallbacks, function()
        for _, t in ipairs(Window.Tabs) do
            t.Label.TextColor3 = (t == Window.CurrentTab) and Library.Theme.Text or Library.Theme.SubText
        end
    end)

    -- Minimize / close
    local function SetMinimized(min)
        if min == Window.Minimized then return end
        Window.Minimized = min
        if min then
            Window.FullSize = main.Size
            Tween(main, { Size = UDim2.new(0, main.AbsoluteSize.X, 0, 39) }, 0.22)
        else
            Tween(main, { Size = Window.FullSize }, 0.22)
        end
        grip.Visible = (not min) and opts.Resizable ~= false
    end
    Window.SetMinimized = function(_, v) SetMinimized(v) end

    minimizeBtn.MouseButton1Click:Connect(function()
        SetMinimized(not Window.Minimized)
    end)
    closeBtn.MouseButton1Click:Connect(function()
        Library:Toggle(false)
        Library:Notify("NebulaUI", "UI hidden — press " .. KeyDisplay(Library.ToggleKey) .. " to reopen", 4)
    end)

    function Window:SetTitle(t) titleLabel.Text = tostring(t) end
    function Window:SetSubTitle(t) subLabel.Text = tostring(t) end

    function Window:Destroy()
        for i, w in ipairs(Library.Windows) do
            if w == Window then
                table.remove(Library.Windows, i)
                break
            end
        end
        main:Destroy()
    end

    -- Built-in settings tab
    function Window:CreateSettingsTab(icon)
        local tab = Window:CreateTab({ Title = "Settings", Icon = icon })

        local interface = tab:CreateSection("Interface")
        local themeNames = {}
        for name in pairs(Library.Themes) do table.insert(themeNames, name) end
        table.sort(themeNames)
        interface:CreateDropdown({
            Title = "Theme",
            Values = themeNames,
            Default = Library.CurrentThemeName,
            Flag = "_NebulaTheme",
            Callback = function(v)
                if type(v) == "string" then Library:SetTheme(v) end
            end,
        })
        interface:CreateKeybind({
            Title = "Toggle UI key",
            Default = Library.ToggleKey,
            Flag = "_NebulaToggleKey",
            OnChanged = function(key)
                if key then Library.ToggleKey = key end
            end,
        })

        local config = tab:CreateSection("Configs")
        local nameInput = config:CreateInput({
            Title = "Config name",
            Placeholder = "my-config",
            IgnoreConfig = true,
        })
        local configDropdown = config:CreateDropdown({
            Title = "Saved configs",
            Values = Library:GetConfigs(),
            IgnoreConfig = true,
        })
        local autoloadLabel

        local function RefreshConfigs()
            configDropdown:SetValues(Library:GetConfigs())
        end

        config:CreateButton({
            Title = "Save config",
            Callback = function()
                local name = nameInput.Value
                if name == nil or name == "" then name = configDropdown.Value end
                if name == nil or name == "" then
                    Library:Notify("Config", "Enter a config name first", 4)
                    return
                end
                local ok, err = Library:SaveConfig(tostring(name))
                if ok then
                    Library:Notify("Config", "Saved '" .. tostring(name) .. "'", 4)
                else
                    Library:Notify("Config", "Save failed: " .. tostring(err), 4)
                end
                RefreshConfigs()
            end,
        })
        config:CreateButton({
            Title = "Load config",
            Callback = function()
                local name = configDropdown.Value
                if name == nil then
                    Library:Notify("Config", "Select a config first", 4)
                    return
                end
                local ok, err = Library:LoadConfig(tostring(name))
                if ok then
                    Library:Notify("Config", "Loaded '" .. tostring(name) .. "'", 4)
                else
                    Library:Notify("Config", "Load failed: " .. tostring(err), 4)
                end
            end,
        })
        config:CreateButton({
            Title = "Delete config",
            Callback = function()
                local name = configDropdown.Value
                if name == nil then
                    Library:Notify("Config", "Select a config first", 4)
                    return
                end
                Library:DeleteConfig(tostring(name))
                Library:Notify("Config", "Deleted '" .. tostring(name) .. "'", 4)
                RefreshConfigs()
            end,
        })
        config:CreateButton({
            Title = "Refresh list",
            Callback = RefreshConfigs,
        })
        config:CreateButton({
            Title = "Set selected as autoload",
            Callback = function()
                local name = configDropdown.Value
                if name == nil then
                    Library:Notify("Config", "Select a config first", 4)
                    return
                end
                Library:SetAutoload(tostring(name))
                autoloadLabel:Set("Autoload: " .. tostring(name))
                Library:Notify("Config", "Autoload set to '" .. tostring(name) .. "'", 4)
            end,
        })
        autoloadLabel = config:CreateLabel("Autoload: " .. (Library:GetAutoload() or "none"))

        local misc = tab:CreateSection("Misc")
        misc:CreateLabel("NebulaUI v" .. Library.Version)
        misc:CreateButton({
            Title = "Unload UI",
            Description = "Removes the UI and disconnects everything",
            Callback = function()
                Library:Destroy()
            end,
        })

        return tab
    end

    table.insert(Library.Windows, Window)
    return Window
end

--========================================================--
--  Global toggle key / lifecycle
--========================================================--

function Library:Toggle(state)
    if Library.Unloaded then return end
    if state == nil then state = not Library.ScreenGui.Enabled end
    Library.ScreenGui.Enabled = state
end

function Library:SetToggleKey(key)
    local k = ResolveKey(key)
    if k then Library.ToggleKey = k end
end

table.insert(Library.Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or Library.Unloaded then return end
    if Library._bindingActive then return end
    if input == Library._lastBindInput then return end
    local k = Library.ToggleKey
    if not k then return end
    if (k.EnumType == Enum.KeyCode and input.KeyCode == k)
    or (k.EnumType == Enum.UserInputType and input.UserInputType == k) then
        Library:Toggle()
    end
end))

function Library:Destroy()
    if Library.Unloaded then return end
    Library.Unloaded = true
    for _, c in ipairs(Library.Connections) do
        pcall(function() c:Disconnect() end)
    end
    Library.Connections = {}
    pcall(function() Library.ScreenGui:Destroy() end)
    pcall(function() Library.NotifyGui:Destroy() end)
    Library.Windows = {}
    Library.Options = {}
end
Library.Unload = Library.Destroy

return Library
