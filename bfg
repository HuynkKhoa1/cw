local function attachTooltip(obj, text)
    if not text then return end
    track(obj.MouseEnter:Connect(function() Library:_ShowTooltip(text) end))
    track(obj.MouseMoved:Connect(function()
        if activeTooltip then
            local mouse = UserInputService:GetMouseLocation()
            activeTooltip.Position = UDim2.new(0, mouse.X + 14, 0, mouse.Y - 4)
        end
    end))
    track(obj.MouseLeave:Connect(function() Library:_HideTooltip() end))
end

local function ensureFolder()
    if not hasFS then return false end
    if not isfolder(Library.ConfigFolder) then
        pcall(makefolder, Library.ConfigFolder)
    end
    return true
end

local function encodeValue(value)
    if typeof(value) == "Color3" then
        return { __t = "Color3", r = value.R, g = value.G, b = value.B }
    elseif typeof(value) == "EnumItem" then
        return { __t = "Enum", et = tostring(value.EnumType), n = value.Name }
    end
    return value
end

local function decodeEnum(et, n)
    local ok, res = pcall(function()
        if et == "Enum.KeyCode" then return Enum.KeyCode[n]
        elseif et == "Enum.UserInputType" then return Enum.UserInputType[n]
        else return (Enum.KeyCode[n] or Enum.UserInputType[n]) end
    end)
    if ok then return res end
    return nil
end

local function decodeValue(value)
    if typeof(value) == "table" and value.__t == "Color3" then
        return Color3.new(value.r, value.g, value.b)
    elseif typeof(value) == "table" and value.__t == "Enum" then
        return decodeEnum(value.et, value.n)
    end
    return value
end

function Library:SaveConfig(name, silent)
    if not ensureFolder() then
        if not silent then Library:Notify({ Title = "Config", Content = "No filesystem access.", Type = "Error" }) end
        return false
    end
    name = name or Library._autoSaveName or "default"
    local data = {
        __theme  = Library.CurrentThemeName,
        __ui = {
            accent     = Library._accentOverride and encodeValue(Library._accentOverride) or nil,
            corner     = Library._cornerScale,
            anim       = Library._animSpeed,
            blur       = Library._blurEnabled,
            notif      = Library.NotifPosition,
            toggleKey  = Library.ToggleKey and Library.ToggleKey.Name or nil,
        },
        __flags = {},
    }
    for flag, value in pairs(_flagStore) do
        data.__flags[flag] = encodeValue(value)
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false end
    -- T2.4: sanitize name (can't escape folder) and report the real write result
    name = tostring(name):gsub("[^%w_%-]", "_")
    local wrote = pcall(writefile, Library.ConfigFolder .. "/" .. name .. ".json", encoded)
    if not wrote then
        if not silent then Library:Notify({ Title = "Config", Content = "Failed to write config file.", Type = "Error" }) end
        return false
    end
    if not silent then Library:Notify({ Title = "Config", Content = "Saved '" .. name .. "'.", Type = "Success" }) end
    return true
end

function Library:LoadConfig(name, silent)
    if not hasFS then return false end
    name = name or Library._autoSaveName or "default"
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    -- Some executors ship readfile/writefile but not isfile; only gate on
    -- isfile when it actually exists, otherwise just try to read.
    if typeof(isfile) == "function" and not isfile(path) then
        if not silent then Library:Notify({ Title = "Config", Content = "No config named '" .. name .. "'.", Type = "Warning" }) end
        return false
    end
    local ok, raw = pcall(readfile, path)
    if not ok or not raw or raw == "" then
        if not silent then Library:Notify({ Title = "Config", Content = "No config named '" .. name .. "'.", Type = "Warning" }) end
        return false
    end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 then return false end

    if data.__theme and Library.Themes[data.__theme] then
        Library:SetTheme(data.__theme)
    end
    if data.__ui then
        local ui = data.__ui
        if ui.accent then Library:SetAccent(decodeValue(ui.accent)) end
        if ui.corner then Library:SetCornerScale(ui.corner) end
        if ui.anim then Library:SetAnimationSpeed(ui.anim) end
        if ui.notif then Library:SetNotifPosition(ui.notif) end
        if ui.blur ~= nil then Library:EnableBlur(ui.blur) end
        if ui.toggleKey then
            local k = decodeEnum("Enum.KeyCode", ui.toggleKey) or decodeEnum("Enum.UserInputType", ui.toggleKey)
            if k then Library.ToggleKey = k end
        end
    end

    local flags = data.__flags or data
    for flag, value in pairs(flags) do
        if flag ~= "__theme" and flag ~= "__ui" and flag ~= "__flags" then
            local option = Library.Options[flag]
            value = decodeValue(value)
            if option then option:Set(value) else _flagStore[flag] = value end
        end
    end
    -- refresh built-in Settings controls (Theme/Notif/etc live in __ui, not
    -- __flags, so they aren't covered by the flag loop above)
    if Library._syncSettingsControls then Library._syncSettingsControls() end
    if not silent then Library:Notify({ Title = "Config", Content = "Loaded '" .. name .. "'.", Type = "Success" }) end
    return true
end

function Library:EnableAutoSave(name)
    Library._autoSaveName = name or "autosave"
    Library:LoadConfig(Library._autoSaveName, true)
    Library._autoSaveEnabled = true
    return Library._autoSaveName
end

function Library:DisableAutoSave()
    Library._autoSaveEnabled = false
end

function Library:ListConfigs()
    local list = {}
    if not hasFS or typeof(listfiles) ~= "function" or not isfolder(Library.ConfigFolder) then
        return list
    end
    for _, file in ipairs(listfiles(Library.ConfigFolder)) do
        local fname = file:match("([^/\\]+)%.json$")
        if fname then table.insert(list, fname) end
    end
    return list
end

function Library:AddTheme(name, theme)
    -- T2.3: validate required keys and fill from the current default so a broken
    -- table can't crash element creation later; always route through buildTheme.
    if typeof(theme) ~= "table" then return false end
    local d = Library.Theme
    local fallbacks = {
        Accent = d.Accent, AcrylicMain = d.AcrylicMain, AcrylicBorder = d.Stroke,
        Text = d.Text, SubText = d.SubText, Element = d.Surface,
    }
    for _, k in ipairs({ "Accent", "AcrylicMain", "AcrylicBorder", "Text", "SubText", "Element" }) do
        if theme[k] == nil then
            warn("[KoaUI] AddTheme '" .. tostring(name) .. "' missing key: " .. k)
            theme[k] = fallbacks[k]
        end
    end
    theme.Name = name
    theme.AcrylicGradient = theme.AcrylicGradient or ColorSequence.new(theme.AcrylicMain)
    Library.Themes[name] = buildTheme(theme)
    return true
end

Library._iconPack = nil

function Library:AddIcon(name, asset)
    if name and asset then Library.Icons[name] = asset end
end

function Library:AddIcons(tbl)
    if typeof(tbl) ~= "table" then return end
    for k, v in pairs(tbl) do Library.Icons[k] = v end
end

function Library:LoadIconPack(source)
    local pack = source
    if typeof(source) == "string" then
        local ok, res = pcall(function() return loadstring(game:HttpGet(source))() end)
        if ok and typeof(res) == "table" then pack = res else return false end
    end
    if typeof(pack) == "table" then
        Library._iconPack = pack
        return true
    end
    return false
end

function Library:GetIcon(name)
    if name == nil then return nil end
    if typeof(name) ~= "string" then return name end
    if name:match("^rbxassetid://") or name:match("^http") or name:match("^rbxasset://") then
        return name
    end
    if Library.Icons[name] then return Library.Icons[name] end
    local pack = Library._iconPack
    if pack then
        if pack[name] then return pack[name] end
        if pack["lucide-" .. name] then return pack["lucide-" .. name] end
    end
    return nil
end

function Library:SetTheme(name)
    local theme = Library.Themes[name]
    if not theme then return end
    Library.Theme = theme
    Library.CurrentThemeName = name
    for _, apply in ipairs(Library._themeCallbacks) do
        pcall(apply)
    end
    if Library._queueSave then Library._queueSave() end
end

function Library:SetAccent(color)
    Library._accentOverride = color
    for _, apply in ipairs(Library._themeCallbacks) do
        pcall(apply)
    end
    if Library._queueSave then Library._queueSave() end
end

function Library:SetCornerScale(scale)
    Library._cornerScale = scale or 1
    for _, entry in ipairs(Library._corners) do
        if entry.inst and entry.inst.Parent then
            entry.inst.CornerRadius = UDim.new(0, entry.base * Library._cornerScale)
        end
    end
    if Library._queueSave then Library._queueSave() end
end

function Library:GetFlags()
    local copy = {}
    for k, v in pairs(_flagStore) do copy[k] = v end
    return copy
end

function Library:SetAnimationSpeed(mult)
    Library._animSpeed = mult or 1
    if Library._queueSave then Library._queueSave() end
end

-- Frosts the UI's own glass panels (does NOT blur the 3D game world).
-- Roblox has no API to blur only the screen behind a GUI, so we make the
-- acrylic panels more see-through/frosted instead of adding a Lighting blur.
function Library:EnableBlur(enabled)
    Library._blurEnabled = enabled
    Library._seeThrough = enabled and true or false
    if Library._queueSave then Library._queueSave() end
    -- remove any legacy game-world blur left over from older versions
    if Library._activeBlur then
        local b = Library._activeBlur
        Library._activeBlur = nil
        pcall(function() b:Destroy() end)
    end
    local target = enabled and 0.72 or 0.25
    for i = #Library._acrylicBgs, 1, -1 do
        local bg = Library._acrylicBgs[i]
        if bg and bg.Parent then
            tween(bg, 0.25, { BackgroundTransparency = target })
        else
            table.remove(Library._acrylicBgs, i)
        end
    end
end

function Library:Unload()
    if Library.Unloaded then return end
    -- T1.11: disarm autosave BEFORE teardown so a pending queueSave can't write
    -- after the UI is gone; invalidate in-flight tokens; flush once so the last
    -- change isn't lost.
    local wasAutoSave = Library._autoSaveEnabled
    Library._autoSaveEnabled = false
    Library._saveToken = (Library._saveToken or 0) + 1
    if wasAutoSave then
        pcall(Library.SaveConfig, Library, Library._autoSaveName, true)
    end
    Library.Unloaded = true
    Library:EnableBlur(false)
    for _, conn in ipairs(Library.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Library.Connections)
    if ScreenGui then ScreenGui:Destroy() end
end

function Library:SetVisible(state)
    Library._hidden = not state
    for _, w in ipairs(Library.Windows) do
        if w.Root then w.Root.Visible = state end
    end
    if state then
        for _, restore in ipairs(Library._restoreCallbacks) do
            pcall(restore)
        end
    end
    if not state and Library._openPopup then
        Library._openPopup()
    end
    if Library._statusSync then Library._statusSync() end
    if Library._reopenSync then Library._reopenSync() end
end

