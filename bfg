        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 4,
        Parent = sidebar,
    })
    padding(tabList, 10, 10, 8, 8)
    vlist(tabList, 8, Enum.HorizontalAlignment.Center)

    -- Floating content panel, detached from the rail
    local content = new("Frame", {
        Position = UDim2.new(0, 76, 0, 0),
        Size = UDim2.new(1, -76, 1, 0),
        BackgroundColor3 = Library.Theme.Inset,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 4,
        Parent = body,
    })
    corner(content, 18)
    local contentStroke = stroke(content, 0.8)
    bindTheme(content, function(t) return { BackgroundColor3 = t.Inset } end)
    bindTheme(contentStroke, function(t) return { Color = t.Stroke } end)

    -- Big editorial tab title inside the panel
    local pageHeader = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 18, 0, 12),
        Size = UDim2.new(1, -36, 0, 28),
        Font = Library._fontBold,
        Text = "",
        TextColor3 = Library.Theme.Text,
        TextSize = 19,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5,
        Parent = content,
    })
    bindTheme(pageHeader, function(t) return { TextColor3 = t.Text } end)

    local pageHolder = new("Frame", {
        Position = UDim2.new(0, 0, 0, 46),
        Size = UDim2.new(1, 0, 1, -46),
        BackgroundTransparency = 1,
        ZIndex = 4,
        Parent = content,
    })

    -- Footer strip: version + theme name
    local footer = new("TextLabel", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 20, 1, -9),
        Size = UDim2.new(1, -40, 0, 16),
        BackgroundTransparency = 1,
        Font = Library._fontMedium,
        Text = "",
        TextColor3 = Library.Theme.SubText,
        TextSize = 11,
        TextTransparency = 0.25,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5,
        Parent = root,
    })
    bindTheme(footer, function(t)
        footer.Text = "KoaUI v" .. Library.Version .. "  -  " .. (t.Name or "Theme")
        return { TextColor3 = t.SubText }
    end)

    local resizeHandle = new("TextButton", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundTransparency = 1,
        Text = "◢",
        Font = Library._fontBold,
        TextSize = 12,
        TextColor3 = Library.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Bottom,
        AutoButtonColor = false,
        ZIndex = 7,
        Parent = root,
    })
    bindTheme(resizeHandle, function(t) return { TextColor3 = t.SubText } end)

    local resizing, resizeStart, startSize
    track(resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startSize = root.AbsoluteSize
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - resizeStart
            -- T3.3: clamp between MinSize and viewport (and optional MaxSize)
            local vp = Library.PopupLayer.AbsoluteSize
            local w = math.clamp(startSize.X + delta.X, minSize.X, vp.X - 24)
            local hgt = math.clamp(startSize.Y + delta.Y, minSize.Y, vp.Y - 24)
            if opts.MaxSize then
                w = math.min(w, opts.MaxSize.X)
                hgt = math.min(hgt, opts.MaxSize.Y)
            end
            root.Size = UDim2.new(0, w, 0, hgt)
            size = root.Size
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end))

    local minimized = false
    -- X asks for confirmation, then fully unloads everything
    makeTopBtn(Library.Icons.close, -12, function()
        Library:Dialog({
            Title = "Unload UI",
            Content = "Are you sure you want to unload the interface? This disables everything.",
            Buttons = {
                { Title = "Unload", Primary = true, Callback = function() Library:Unload() end },
                { Title = "Cancel" },
            },
        })
    end, true)
    makeTopBtn(Library.Icons.minimize, -44, function()
        minimized = not minimized
        if Library._openPopup then Library._openPopup() end
        if minimized then
            body.Visible = false
            footer.Visible = false
            resizeHandle.Visible = false
            tween(root, SPEED, { Size = UDim2.new(0, size.X.Offset, 0, 50) })
        else
            tween(root, SPEED, { Size = size })
            resizeHandle.Visible = true
            task.delay(aspeed(0.16), function() body.Visible = true footer.Visible = true end)
        end
    end)

    table.insert(Library._restoreCallbacks, function()
        if minimized then
            minimized = false
            root.Size = size
            resizeHandle.Visible = true
            body.Visible = true
            footer.Visible = true
        end
    end)
    windowObj._restoreIndex = #Library._restoreCallbacks

    windowObj._tabButtons = {}
    windowObj._tabPages = {}
    windowObj._tabs = {}

    local function applySearch(query)
        local tab = windowObj._tabs[windowObj.ActiveTab]
        if not tab then return end
        query = (query or ""):lower()
        for _, item in ipairs(tab._items) do
            item.frame.Visible = query == "" or item.title:find(query, 1, true) ~= nil
        end
    end

    if searchBox then
        track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            applySearch(searchBox.Text)
        end))
    end

    local function activate(name)
        if Library._openPopup then Library._openPopup() end
        for n, page in pairs(windowObj._tabPages) do
            page.Visible = (n == name)
        end
        for n, btn in pairs(windowObj._tabButtons) do
            local on = (n == name)
            btn.Label.TextColor3 = on and Library.Theme.AccentText or Library.Theme.SubText
            if btn.Icon then btn.Icon.ImageColor3 = on and Library.Theme.AccentText or Library.Theme.SubText end
            tween(btn.Indicator, 0.18, {
                Size = on and UDim2.new(0, 42, 0, 42) or UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = on and 0 or 0.85,
            })
        end
        windowObj.ActiveTab = name
        pageHeader.Text = name
        if searchBox then applySearch(searchBox.Text) end
    end

    function windowObj:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        local name = tabOpts.Title or ("Tab " .. (#windowObj.Tabs + 1))

        -- "Settings" is reserved: return the locked auto-created settings tab
        if name == "Settings" and windowObj.SettingsTab and not tabOpts._internal then
            return windowObj.SettingsTab
        end

        -- avoid clobbering a tab with a duplicate title
        if windowObj._tabPages[name] then
            local n = 2
            while windowObj._tabPages[name .. " (" .. n .. ")"] do n += 1 end
            name = name .. " (" .. n .. ")"
        end

        local tabBtn = new("TextButton", {
            Size = UDim2.new(0, 48, 0, 48),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = tabOpts._internal and 1000 or (#windowObj.Tabs + 1),
            ZIndex = 4,
            Parent = tabList,
        })
        corner(tabBtn, 999)

        -- accent disc that blooms behind the icon when active
        local indicator = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = accentColor(),
            BackgroundTransparency = 0.85,
            BorderSizePixel = 0,
            ZIndex = 4,
            Parent = tabBtn,
        })
        corner(indicator, 999)
        bindTheme(indicator, function() return { BackgroundColor3 = accentColor() } end)

        local iconImg
        if tabOpts.Icon then
            iconImg = new("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0, 20, 0, 20),
                Image = Library:GetIcon(tabOpts.Icon) or Library.Icons[tabOpts.Icon] or tabOpts.Icon,
                ImageColor3 = Library.Theme.SubText,
                ZIndex = 5,
                Parent = tabBtn,
            })
        end

        -- tabs without an icon get a monogram chip
        local tabLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 1, 0),
            Font = Library._fontBold,
            Text = string.upper(string.sub(name, 1, 1)),
            TextColor3 = Library.Theme.SubText,
            TextSize = 16,
            Visible = not tabOpts.Icon,
            ZIndex = 5,
            Parent = tabBtn,
        })
        attachTooltip(tabBtn, name)

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = accentColor(),
            ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 4,
            Parent = pageHolder,
        })
        padding(page, 6, 16, 14, 14)
        vlist(page, 10)

        windowObj._tabButtons[name] = { Frame = tabBtn, Label = tabLabel, Indicator = indicator, Icon = iconImg }
        windowObj._tabPages[name] = page

        track(tabBtn.MouseEnter:Connect(function()
            if windowObj.ActiveTab ~= name then tabLabel.TextColor3 = Library.Theme.Text end
        end))
        track(tabBtn.MouseLeave:Connect(function()
            if windowObj.ActiveTab ~= name then tabLabel.TextColor3 = Library.Theme.SubText end
        end))
        track(tabBtn.MouseButton1Click:Connect(function() activate(name) end))

        local tabObj = setmetatable({ Page = page, Window = windowObj, Name = name, _items = {} }, { __index = Elements })
        windowObj._tabs[name] = tabObj
        table.insert(windowObj.Tabs, tabObj)

        -- first user tab (non-settings) becomes the default active tab
        if not tabOpts._internal and not windowObj._firstUserTab then
            windowObj._firstUserTab = name
            activate(name)
        elseif #windowObj.Tabs == 1 then
            activate(name)
        end
        return tabObj
    end

    function windowObj:Destroy()
        if Library._openPopup then Library._openPopup() end
        for i, w in ipairs(Library.Windows) do
            if w == windowObj then table.remove(Library.Windows, i) break end
        end
        -- prune this window's restore callback
        if windowObj._restoreIndex then
            Library._restoreCallbacks[windowObj._restoreIndex] = function() end
        end
        tween(root, 0.2, { Size = UDim2.new(0, size.X.Offset * 0.9, 0, 0) })
        task.delay(0.22, function()
            if root then root:Destroy() end
            -- drop theme callbacks / acrylic bgs / corners whose instances are gone
            for i = #Library._acrylicBgs, 1, -1 do
                local bg = Library._acrylicBgs[i]
                if not (bg and bg.Parent) then table.remove(Library._acrylicBgs, i) end
            end
            for i = #Library._corners, 1, -1 do
                local entry = Library._corners[i]
                if not (entry.inst and entry.inst.Parent) then table.remove(Library._corners, i) end
            end
        end)
        if #Library.Windows == 0 then Library:EnableBlur(false) end
    end

    function windowObj:Select(name)
        if windowObj._tabPages[name] then activate(name) end
    end

    root.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0)
    tween(root, 0.35, { Size = size })

    table.insert(Library.Windows, windowObj)

    -- Locked Settings tab: every window always has one, pinned at the end
    windowObj.SettingsTab = Library:CreateSettingsTab(windowObj, opts.ConfigName)

    return windowObj
end

function Library:CreateSettingsTab(window, configName)
    -- idempotent: a window only ever has one Settings tab
    if window.SettingsTab then
        if configName then window._settingsConfigName = configName end
        return window.SettingsTab
    end
    configName = configName or window._settingsConfigName or "default"
    local tab = window:CreateTab({ Title = "Settings", Icon = "settings", _internal = true })
    window.SettingsTab = tab

    tab:Section({ Title = "Appearance" })

    local themeNames = {}
    for name in pairs(Library.Themes) do table.insert(themeNames, name) end
    table.sort(themeNames)

    local themeDrop = tab:Dropdown({
        Title = "Theme",
        Values = themeNames,
        Default = Library.CurrentThemeName,
        Search = true,
        Callback = function(v) Library:SetTheme(v) end,
    })

    local accentPick = tab:ColorPicker({
        Title = "Accent Override",
        Default = accentColor(),
        Callback = function(c) Library:SetAccent(c) end,
    })

    local cornerSlider = tab:Slider({
        Title = "Corner Radius",
        Min = 0, Max = 2, Decimals = 2, Default = Library._cornerScale,
        Callback = function(v) Library:SetCornerScale(v) end,
    })

    local animSlider = tab:Slider({
        Title = "Anim Duration", -- T2.12: it multiplies tween duration (higher = slower)
        Suffix = "x",
        Tooltip = "Multiplies animation duration — higher is slower",
        Min = 0.25, Max = 2, Decimals = 2, Default = Library._animSpeed,
        Callback = function(v) Library:SetAnimationSpeed(v) end,
    })

    local blurToggle = tab:Toggle({
        Title = "Background Blur",
        Default = Library._blurEnabled,
        Callback = function(v) Library:EnableBlur(v) end,
    })

    tab:Section({ Title = "Interface" })

    local toggleKeybind = tab:Keybind({
        Title = "Toggle UI Key",
        Default = Library.ToggleKey,
        OnChanged = function(k) Library.ToggleKey = k; if Library._queueSave then Library._queueSave() end end,
    })

    local notifDrop = tab:Dropdown({
        Title = "Notification Position",
        Values = { "TopRight", "TopLeft", "BottomRight", "BottomLeft" },
        Default = Library.NotifPosition,
        Callback = function(v) Library:SetNotifPosition(v) end,
    })

    -- keep visible Settings controls in sync with values applied by LoadConfig
    Library._syncSettingsControls = function()
        pcall(function() themeDrop:Set(Library.CurrentThemeName) end)
        pcall(function() if Library._accentOverride then accentPick:Set(Library._accentOverride) end end)
        pcall(function() cornerSlider:Set(Library._cornerScale, true) end)
        pcall(function() animSlider:Set(Library._animSpeed, true) end)
        pcall(function() blurToggle:Set(Library._blurEnabled) end)
        pcall(function() notifDrop:Set(Library.NotifPosition) end)
        pcall(function() toggleKeybind:Set(Library.ToggleKey) end)
    end

    tab:Section({ Title = "Configuration" })

    local configList = tab:Dropdown({
        Title = "Saved Configs",
        Values = Library:ListConfigs(),
        Search = true,
    })

    local nameInput = tab:Input({
        Title = "Config Name",
        Default = configName,
        Placeholder = "config name",
    })

    tab:Button({
        Title = "Save Config",
        Callback = function()
            Library:SaveConfig(nameInput:Get())
            configList:Refresh(Library:ListConfigs(), true)
        end,
    })
    tab:Button({
        Title = "Load Config",
        Callback = function()
            local sel = configList:Get() or nameInput:Get()
            Library:LoadConfig(sel)
        end,
    })

    tab:Section({ Title = "Server" })

    local function serverHop(lowest)
        local ok, servers = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(
                "https://games.roblox.com/v1/games/" .. game.PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"
            ))
        end)
        if not ok or not servers or not servers.data then
            Library:Notify({ Title = "Server", Content = "Failed to fetch servers.", Type = "Error" })
            return
        end
        local best
        for _, s in ipairs(servers.data) do
            if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                if not best then
                    best = s
                elseif lowest and s.playing < best.playing then
                    best = s
                elseif not lowest then
                    best = s
                    break
                end
            end
        end
        if best then
            -- T2.5: teleport can throw (blocked / rate-limited)
            local tok = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, best.id, LocalPlayer)
            if not tok then
                Library:Notify({ Title = "Server", Content = "Teleport failed (blocked or rate-limited).", Type = "Error" })
            end
        else
            Library:Notify({ Title = "Server", Content = "No suitable server found.", Type = "Warning" })
        end
    end

    tab:Button({
        Title = "Rejoin Server",
        Callback = function()
            -- T2.5
            local ok = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, game.JobId, LocalPlayer)
            if not ok then
                Library:Notify({ Title = "Server", Content = "Teleport failed (blocked or rate-limited).", Type = "Error" })
            end
        end,
    })
    tab:Button({
        Title = "Server Hop",
        Description = "Joins a different public server",
        Callback = function() serverHop(false) end,
    })
    tab:Button({
        Title = "Low Server Join",
        Description = "Joins the emptiest available server",
        Callback = function() serverHop(true) end,
    })
    tab:Button({
        Title = "Copy Job ID",
        Callback = function()
            if typeof(setclipboard) == "function" then
                pcall(setclipboard, game.JobId)
                Library:Notify({ Title = "Server", Content = "Job ID copied.", Type = "Success" })
            else
                Library:Notify({ Title = "Server", Content = "Clipboard not supported.", Type = "Warning" })
            end
        end,
    })

    tab:Toggle({
        Title = "Anti-AFK",
        Flag = "KoaUI_AntiAFK",
        Default = true,
        Callback = function() end,
    })
    -- T2.7: only hook Idled once across all windows, else N windows = N clicks
    if not Library._antiAfkHooked then
        Library._antiAfkHooked = true
        track(LocalPlayer.Idled:Connect(function()
            if Library.Flags.KoaUI_AntiAFK then
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new())
                end)
            end
        end))
    end

    tab:Section({ Title = "Danger" })
    tab:Button({
        Title = "Unload UI",
        Description = "Removes the interface completely.",
        Callback = function()
            Library:Dialog({
                Title = "Unload UI",
                Content = "Are you sure you want to unload the interface?",
                Buttons = {
                    { Title = "Unload", Primary = true, Callback = function() Library:Unload() end },
                    { Title = "Cancel" },
                },
            })
        end,
    })

    return tab
end

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if Library._bindingActive then return end
    -- T1.3: accept Touch as well as MouseButton1 so popups dismiss on phones.
    if (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) and Library._openPopup then
        -- T1.1: input.Position is in the SAME inset-excluded space as
        -- AbsolutePosition (GetMouseLocation is NOT — it includes the inset),
        -- so the hit-rect math is valid on any topbar size.
        local pos = Vector2.new(input.Position.X, input.Position.Y)
        local insidePopup = false
        for _, child in ipairs(Library.PopupLayer:GetChildren()) do
            local p, sz = child.AbsolutePosition, child.AbsoluteSize
            if pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y then
                insidePopup = true
                break
            end
        end
        -- a click on the open dropdown's own header is "inside" so its Toggle handles open/close
        if not insidePopup and Library._openDropdown and Library._openDropdown._frame then
            local hf = Library._openDropdown._frame
            local p, sz = hf.AbsolutePosition, hf.AbsoluteSize
            if pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y then
                insidePopup = true
            end
        end
        -- T1.1 hardening: the engine's own hit-testing (popup.InputBegan) is
        -- immune to coordinate drift during the open/close tween. Treat the
        -- press as inside if EITHER the rect test passes OR the press landed
        -- on the popup per the engine.
        if Library._pressInsidePopup then insidePopup = true end
        if not insidePopup then
            task.defer(function()
                if Library._openPopup and Library._openDropdown then
                    Library._openDropdown:Close()
                end
            end)
        end
        Library._pressInsidePopup = false
    end
    if gpe then return end
    if input.KeyCode == Library.ToggleKey or input.UserInputType == Library.ToggleKey then
        Library:ToggleVisible()
    end
end))

return Library
