--========================================================--
--  Internal utilities
--========================================================--

local function track(conn)
    table.insert(Library.Connections, conn)
    return conn
end

local function new(class, props, children)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then
                inst[k] = v
            end
        end
        if props.Parent then
            inst.Parent = props.Parent
        end
    end
    if children then
        for _, c in ipairs(children) do
            c.Parent = inst
        end
    end
    return inst
end

local function corner(parent, radius)
    return new("UICorner", {
        CornerRadius = UDim.new(0, radius or 12),
        Parent = parent,
    })
end

-- Hairline glass border (white stroke at high transparency)
local function hairline(parent, transparency)
    return new("UIStroke", {
        Color = Library.Theme.Outline,
        Thickness = 1,
        Transparency = transparency or 0.9,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function tween(inst, time, props, style, dir)
    local t = TweenService:Create(inst,
        TweenInfo.new(time, style or EASE, dir or DIR), props)
    t:Play()
    return t
end

-- Register an instance to react to theme changes.
local function bindTheme(inst, mapper)
    local function apply()
        local props = mapper(Library.Theme)
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    apply()
    table.insert(Library._themeCallbacks, apply)
    return inst
end

-- Top-edge shine gradient that gives panels a frosted-glass highlight.
local function addShine(parent)
    return new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.86),
            NumberSequenceKeypoint.new(0.4, 0.97),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Parent = parent,
    })
end

-- Soft radial glow used behind accents/active elements.
local function makeGlow(parent, color, transparency)
    local glow = new("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084", -- soft radial gradient
        ImageColor3 = color or Library.Theme.Accent,
        ImageTransparency = transparency or 0.55,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(24, 24, 24, 24),
        Size = UDim2.new(1, 30, 1, 30),
        Position = UDim2.new(0, -15, 0, -15),
        ZIndex = 0,
        Parent = parent,
    })
    return glow
end

local function keyName(input)
    if typeof(input) == "EnumItem" then
        if input.EnumType == Enum.KeyCode then
            return input.Name
        elseif input.EnumType == Enum.UserInputType then
            return (input.Name:gsub("MouseButton", "MB"))
        end
    end
    return tostring(input)
end

