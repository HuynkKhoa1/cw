        Size = UDim2.new(0, 162, 1, 0),
        BackgroundColor3 = Library.Theme.Sidebar,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = body,
    })
    bindTheme(sidebar, function(t) return { BackgroundColor3 = t.Sidebar } end)
    local sideStroke = new("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Library.Theme.Stroke,
        BackgroundTransparency = 0.92,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = sidebar,
    })
    bindTheme(sideStroke, function(t) return { BackgroundColor3 = t.Stroke } end)

    local tabList = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 2,
        Parent = sidebar,
    })
    padding(tabList, 12, 12, 10, 10)
    vlist(tabList, 5)

    local content = new("Frame", {
        Position = UDim2.new(0, 162, 0, 0),
        Size = UDim2.new(1, -162, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 2,
        Parent = body,
    })

    local resizeHandle = new("TextButton", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundTransparency = 1,
        Text = "◢",
        Font = Library._fontBold,
        TextSize = 12,
        TextColor3 = Library.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Bottom,
        AutoButtonColor = false,
        ZIndex = 5,
        Parent = root,
    })
    bindTheme(resizeHandle, function(t) return { TextColor3 = t.SubText } end)

    local resizing, resizeStart, startSize
    track(resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startSize = root.AbsoluteSize
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - resizeStart
            local w = math.max(minSize.X, startSize.X + delta.X)
            local hgt = math.max(minSize.Y, startSize.Y + delta.Y)
            root.Size = UDim2.new(0, w, 0, hgt)
            size = root.Size
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end))

    local minimized = false
    makeTopBtn(Library.Icons.close, -12, function() windowObj:Destroy() end, true)
    makeTopBtn("rbxassetid://10734896206", -44, function()
        minimized = not minimized
        if Library._openPopup then Library._openPopup() end
        if minimized then
            body.Visible = false
            resizeHandle.Visible = false
            tween(root, SPEED, { Size = UDim2.new(0, size.X.Offset, 0, 44) })
        else
            tween(root, SPEED, { Size = size })
            resizeHandle.Visible = true
            task.delay(aspeed(0.16), function() body.Visible = true end)
        end
    end)

    windowObj._tabButtons = {}
    windowObj._tabPages = {}
    windowObj._tabs = {}

    local function applySearch(query)
        local tab = windowObj._tabs[windowObj.ActiveTab]
        if not tab then return end
        query = (query or ""):lower()
        for _, item in ipairs(tab._items) do
            item.frame.Visible = query == "" or item.title:find(query, 1, true) ~= nil
        end
    end

    if searchBox then
        track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            applySearch(searchBox.Text)
        end))
    end

    local function activate(name)
        if Library._openPopup then Library._openPopup() end
        for n, page in pairs(windowObj._tabPages) do
            page.Visible = (n == name)
        end
        for n, btn in pairs(windowObj._tabButtons) do
            local on = (n == name)
            tween(btn.Frame, 0.18, {
                BackgroundColor3 = on and Library.Theme.Surface or Library.Theme.Sidebar,
                BackgroundTransparency = on and 0 or 1,
            })
            btn.Label.TextColor3 = on and Library.Theme.Text or Library.Theme.SubText
            if btn.Icon then btn.Icon.ImageColor3 = on and accentColor() or Library.Theme.SubText end
            tween(btn.Indicator, 0.18, {
                Size = on and UDim2.new(0, 3, 0.6, 0) or UDim2.new(0, 3, 0, 0),
            })
        end
        windowObj.ActiveTab = name
        if searchBox then applySearch(searchBox.Text) end
    end

    function windowObj:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        local name = tabOpts.Title or ("Tab " .. (#windowObj.Tabs + 1))

        local tabBtn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Library.Theme.Surface,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 2,
            Parent = tabList,
        })
        corner(tabBtn, 8)
        bindTheme(tabBtn, function(t) return { BackgroundColor3 = t.Surface } end)

        local indicator = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 3, 0, 0),
            BackgroundColor3 = accentColor(),
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = tabBtn,
        })
        corner(indicator, 2)
        bindTheme(indicator, function() return { BackgroundColor3 = accentColor() } end)

        local iconImg, labelX = nil, 14
        if tabOpts.Icon then
            iconImg = new("ImageLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 16, 0, 16),
                Image = Library.Icons[tabOpts.Icon] or tabOpts.Icon,
                ImageColor3 = Library.Theme.SubText,
                ZIndex = 3,
                Parent = tabBtn,
            })
            labelX = 36
        end

        local tabLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, labelX, 0, 0),
            Size = UDim2.new(1, -(labelX + 4), 1, 0),
            Font = Library._fontMedium,
            Text = name,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 3,
            Parent = tabBtn,
        })

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = accentColor(),
            ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 2,
            Parent = content,
        })
        padding(page, 14, 16, 14, 14)
        vlist(page, 9)

        windowObj._tabButtons[name] = { Frame = tabBtn, Label = tabLabel, Indicator = indicator, Icon = iconImg }
        windowObj._tabPages[name] = page

        track(tabBtn.MouseEnter:Connect(function()
            if windowObj.ActiveTab ~= name then tabLabel.TextColor3 = Library.Theme.Text end
        end))
        track(tabBtn.MouseLeave:Connect(function()
            if windowObj.ActiveTab ~= name then tabLabel.TextColor3 = Library.Theme.SubText end
        end))
        track(tabBtn.MouseButton1Click:Connect(function() activate(name) end))

        local tabObj = setmetatable({ Page = page, Window = windowObj, Name = name, _items = {} }, { __index = Elements })
        windowObj._tabs[name] = tabObj
        table.insert(windowObj.Tabs, tabObj)

        if #windowObj.Tabs == 1 then activate(name) end
        return tabObj
    end

    function windowObj:Destroy()
        if Library._openPopup then Library._openPopup() end
        for i, w in ipairs(Library.Windows) do
            if w == windowObj then table.remove(Library.Windows, i) break end
        end
        tween(root, 0.2, { BackgroundTransparency = 1, Size = UDim2.new(0, size.X.Offset * 0.9, 0, 0) })
        task.delay(0.22, function() if root then root:Destroy() end end)
    end

    function windowObj:Select(name)
        if windowObj._tabPages[name] then activate(name) end
    end

    root.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0)
    root.BackgroundTransparency = 1
    tween(root, 0.35, { Size = size, BackgroundTransparency = 0 })

    table.insert(Library.Windows, windowObj)
    return windowObj
end

function Library:CreateSettingsTab(window, configName)
    configName = configName or "default"
    local tab = window:CreateTab({ Title = "Settings", Icon = "settings" })

    tab:Section({ Title = "Appearance" })

    local themeNames = {}
    for name in pairs(Library.Themes) do table.insert(themeNames, name) end
    table.sort(themeNames)

    tab:Dropdown({
        Title = "Theme",
        Values = themeNames,
        Default = Library.CurrentThemeName,
        Search = true,
        Callback = function(v) Library:SetTheme(v) end,
    })

    tab:ColorPicker({
        Title = "Accent Override",
        Default = accentColor(),
        Callback = function(c) Library:SetAccent(c) end,
    })

    tab:Slider({
        Title = "Corner Radius",
        Min = 0, Max = 2, Decimals = 2, Default = 1,
        Callback = function(v) Library:SetCornerScale(v) end,
    })

    tab:Slider({
        Title = "Animation Speed",
        Min = 0.25, Max = 2, Decimals = 2, Default = 1,
        Callback = function(v) Library:SetAnimationSpeed(v) end,
    })

    tab:Toggle({
        Title = "Background Blur",
        Default = Library._blurEnabled,
        Callback = function(v) Library:EnableBlur(v) end,
    })

    tab:Section({ Title = "Interface" })

    tab:Keybind({
        Title = "Toggle UI Key",
        Default = Library.ToggleKey,
        Callback = function() Library:ToggleVisible() end,
    })

    tab:Dropdown({
        Title = "Notification Position",
        Values = { "TopRight", "TopLeft", "BottomRight", "BottomLeft" },
        Default = Library.NotifPosition,
        Callback = function(v) Library:SetNotifPosition(v) end,
    })

    tab:Section({ Title = "Configuration" })

    local configList = tab:Dropdown({
        Title = "Saved Configs",
        Values = Library:ListConfigs(),
        Search = true,
    })

    local nameInput = tab:Input({
        Title = "Config Name",
        Default = configName,
        Placeholder = "config name",
    })

    tab:Button({
        Title = "Save Config",
        Callback = function()
            Library:SaveConfig(nameInput:Get())
            configList:Refresh(Library:ListConfigs(), true)
        end,
    })
    tab:Button({
        Title = "Load Config",
        Callback = function()
            local sel = configList:Get() or nameInput:Get()
            Library:LoadConfig(sel)
        end,
    })

    tab:Section({ Title = "Danger" })
    tab:Button({
        Title = "Unload UI",
        Description = "Removes the interface completely.",
        Callback = function()
            Library:Dialog({
                Title = "Unload UI",
                Content = "Are you sure you want to unload the interface?",
                Buttons = {
                    { Title = "Unload", Primary = true, Callback = function() Library:Unload() end },
                    { Title = "Cancel" },
                },
            })
        end,
    })

    return tab
end

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if Library._bindingActive then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and Library._openPopup then
        local pos = UserInputService:GetMouseLocation()
        local popup = Library.PopupLayer:FindFirstChildWhichIsA("Frame")
        local insidePopup = false
        for _, child in ipairs(Library.PopupLayer:GetChildren()) do
            local p, sz = child.AbsolutePosition, child.AbsoluteSize
            if pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y then
                insidePopup = true
                break
            end
        end
        if not insidePopup then
            task.defer(function()
                if Library._openPopup and Library._openDropdown then
                    Library._openDropdown:Close()
                end
            end)
        end
    end
    if gpe then return end
    if input.KeyCode == Library.ToggleKey then
        Library:ToggleVisible()
    end
end))

return Library
