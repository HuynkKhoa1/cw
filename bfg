Builders.Toggle = function(container, opts)
    local Toggle = {
        Type = "Toggle",
        Value = opts.Default == true,
        Callback = opts.Callback,
        Flag = opts.Flag,
        IgnoreConfig = opts.IgnoreConfig,
        _changed = opts.OnChanged,
    }
    local base = BaseElement(container, opts, 38, 60)
    Toggle.Frame = base.Frame
    Toggle._conns = base.Conns

    local switch = Create("Frame", {
        AnchorPoint      = Vector2.new(1, 0.5),
        Position         = UDim2.new(1, -12, 0, base.Height / 2),
        Size             = UDim2.new(0, 36, 0, 18),
        BackgroundColor3 = Library.Theme.Disabled,
        Parent           = base.Frame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local knob = Create("Frame", {
        AnchorPoint      = Vector2.new(0, 0.5),
        Position         = UDim2.new(0, 2, 0.5, 0),
        Size             = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent           = switch,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local function Render(instant)
        local on = Toggle.Value
        local trackColor = on and Library.Theme.Accent or Library.Theme.Disabled
        local knobPos = on and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        if instant then
            switch.BackgroundColor3 = trackColor
            knob.Position = knobPos
        else
            Tween(switch, { BackgroundColor3 = trackColor }, 0.15)
            Tween(knob, { Position = knobPos }, 0.15)
        end
    end
    Render(true)
    table.insert(Library._themeCallbacks, function() Render(true) end)

    local click = Create("TextButton", {
        BackgroundTransparency = 1,
        Text   = "",
        Size   = UDim2.new(1, 0, 1, 0),
        Parent = base.Frame,
    })
    AttachHover(click, base.Frame)
    click.MouseButton1Click:Connect(function()
        Toggle:Set(not Toggle.Value)
    end)

    function Toggle:Set(v)
        v = v == true
        if v == Toggle.Value then return end
        Toggle.Value = v
        if Toggle.Flag then Library.Flags[Toggle.Flag] = v end
        Render(false)
        SafeCall(Toggle.Callback, v)
        SafeCall(Toggle._changed, v)
    end
    function Toggle:OnChanged(fn) Toggle._changed = fn end
    function Toggle:GetSaveValue() return Toggle.Value end
    function Toggle:LoadSaveValue(v) Toggle:Set(v == true) end
    Toggle.Destroy = ElementDestroy

    RegisterOption(Toggle, Toggle.Value)
    return Toggle
end

-- Slider ------------------------------------------------

Builders.Slider = function(container, opts)
    local min = tonumber(opts.Min) or 0
    local max = tonumber(opts.Max) or 100
    local inc = tonumber(opts.Increment) or 1
    if max < min then max = min end

    local Slider = {
        Type = "Slider",
        Min = min, Max = max, Increment = inc,
        Suffix = opts.Suffix or "",
        Callback = opts.Callback,
        Flag = opts.Flag,
        IgnoreConfig = opts.IgnoreConfig,
        Value = math.clamp(Round(tonumber(opts.Default) or min, inc), min, max),
        _changed = opts.OnChanged,
    }

    local base = BaseElement(container, opts, 50, 110, true)
    Slider.Frame = base.Frame
    Slider._conns = base.Conns

    local decimals = CountDecimals(inc)
    local function FormatValue(v)
        return string.format("%." .. decimals .. "f", v)
    end

    local valueLabel = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint    = Vector2.new(1, 0),
        Position       = UDim2.new(1, -12, 0, 4),
        Size           = UDim2.new(0, 95, 0, 20),
        Font           = Enum.Font.GothamMedium,
        Text           = "",
        TextSize       = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent         = base.Frame,
    }), { TextColor3 = "SubText" })

    local bar = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Disabled,
        Position         = UDim2.new(0, 12, 1, -14),
        Size             = UDim2.new(1, -24, 0, 6),
        Parent           = base.Frame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    }), { BackgroundColor3 = "Disabled" })

    local fill = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Accent,
        Size             = UDim2.new(0, 0, 1, 0),
        Parent           = bar,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    }), { BackgroundColor3 = "Accent" })

    local function Render()
        local rel = 0
        if max > min then rel = (Slider.Value - min) / (max - min) end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valueLabel.Text = FormatValue(Slider.Value) .. Slider.Suffix
    end

    local function SetValue(v, fireAnyway)
        v = math.clamp(Round(tonumber(v) or Slider.Value, inc), min, max)
        local changed = v ~= Slider.Value
        Slider.Value = v
        if Slider.Flag then Library.Flags[Slider.Flag] = v end
        Render()
        if changed or fireAnyway then
            SafeCall(Slider.Callback, v)
            SafeCall(Slider._changed, v)
        end
    end
    Render()

    local hitbox = Create("TextButton", {
        BackgroundTransparency = 1,
        Text   = "",
        Position = UDim2.new(0, 8, 1, -26),
        Size     = UDim2.new(1, -16, 0, 24),
        Parent   = base.Frame,
    })

    local dragging = false
    local function UpdateFromMouse()
        local relX = RelativeMouse(bar)
        SetValue(min + (max - min) * relX)
    end

    Track(base.Conns, hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromMouse()
        end
    end))
    Track(base.Conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromMouse()
        end
    end))
    Track(base.Conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    function Slider:Set(v) SetValue(v) end
    function Slider:OnChanged(fn) Slider._changed = fn end
    function Slider:GetSaveValue() return Slider.Value end
    function Slider:LoadSaveValue(v)
        if tonumber(v) then SetValue(tonumber(v)) end
    end
    Slider.Destroy = ElementDestroy

    RegisterOption(Slider, Slider.Value)
    return Slider
end

