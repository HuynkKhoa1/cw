    KoaUI — Modern Luau UI Library for Roblox executors
    Version 1.0.0

    Quick start:
        local Koa    = loadstring(readfile("Koa_UI_LIB/KoaUI.lua"))()
        local Window = Koa:CreateWindow({ Title = "Koa Hub", SubTitle = "v1.0" })
        local Tab    = Window:CreateTab({ Title = "Main", Icon = "" })

        Tab:Button({ Title = "Click me", Callback = function() print("hi") end })
        Tab:Toggle({ Title = "God Mode", Default = false, Flag = "GodMode",
            Callback = function(v) print(v) end })
