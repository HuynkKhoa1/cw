local function ElementDestroy(self)
    for _, c in ipairs(self._conns or {}) do
        pcall(function() c:Disconnect() end)
    end
    if self.Flag then Library.Options[self.Flag] = nil end
    if self.Frame then pcall(function() self.Frame:Destroy() end) end
end

local function RegisterOption(obj, initial)
    if obj.Flag then
        Library.Options[obj.Flag] = obj
        Library.Flags[obj.Flag] = initial
    end
end

local function AttachHover(trigger, frame)
    trigger.MouseEnter:Connect(function()
        Tween(frame, { BackgroundColor3 = Library.Theme.ElementHover }, 0.12)
    end)
    trigger.MouseLeave:Connect(function()
        Tween(frame, { BackgroundColor3 = Library.Theme.Element }, 0.12)
    end)
end

local function BaseElement(container, opts, baseHeight, titleRightPad, topAligned)
    local hasDesc = opts.Description ~= nil and opts.Description ~= ""
    local height = baseHeight + (hasDesc and 16 or 0)

    local frame = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Element,
        Size             = UDim2.new(1, 0, 0, height),
        ClipsDescendants = true,
        LayoutOrder      = NextOrder(container),
        Parent           = container,
    }), { BackgroundColor3 = "Element" })
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = frame })
    Themed(Create("UIStroke", { Thickness = 1, Parent = frame }), { Color = "Outline" })

    local titleY, titleH
    if hasDesc or topAligned then
        titleY, titleH = 4, 20
    else
        titleY, titleH = 0, height
    end

    local title = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 12, 0, titleY),
        Size           = UDim2.new(1, -(titleRightPad or 60) - 12, 0, titleH),
        Font           = Enum.Font.GothamMedium,
        Text           = tostring(opts.Title or "Element"),
        TextSize       = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate   = Enum.TextTruncate.AtEnd,
        Parent         = frame,
    }), { TextColor3 = "Text" })

    local desc
    if hasDesc then
        desc = Themed(Create("TextLabel", {
            BackgroundTransparency = 1,
            Position       = UDim2.new(0, 12, 0, titleY + 20),
            Size           = UDim2.new(1, -24, 0, 14),
            Font           = Enum.Font.Gotham,
            Text           = tostring(opts.Description),
            TextSize       = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate   = Enum.TextTruncate.AtEnd,
            Parent         = frame,
        }), { TextColor3 = "SubText" })
    end

    return { Frame = frame, Title = title, Desc = desc, Height = height, Conns = {} }
end

