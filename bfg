        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Parent = valOverlay,
    })

    local hueBar = new("ImageButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 14, 1, 0),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Parent = panel,
    })
    corner(hueBar, 5)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
        }),
        Parent = hueBar,
    })

    local object = {}
    local open = false

    local function setHeight()
        if open then
            tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, 174) })
        else
            tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, 38) })
        end
    end

    local function rebuild()
        color = Color3.fromHSV(h, s, v)
        satMap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        preview.BackgroundColor3 = color
        if flag then Library.Flags[flag] = color end
        if opts.Callback then task.spawn(opts.Callback, color) end
    end

    function object:Set(c)
        color = c
        h, s, v = c:ToHSV()
        rebuild()
    end
    function object:Get() return color end

    track(preview.MouseButton1Click:Connect(function()
        open = not open
        setHeight()
    end))

    local satDrag = false
    local function updateSat(input)
        local px = math.clamp((input.Position.X - satMap.AbsolutePosition.X) / satMap.AbsoluteSize.X, 0, 1)
        local py = math.clamp((input.Position.Y - satMap.AbsolutePosition.Y) / satMap.AbsoluteSize.Y, 0, 1)
        s = px
        v = 1 - py
        rebuild()
    end
    track(satMap.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            satDrag = true
            updateSat(input)
        end
    end))

    local hueDrag = false
    local function updateHue(input)
        local py = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
        h = py
        rebuild()
    end
    track(hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            hueDrag = true
            updateHue(input)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            if satDrag then updateSat(input) end
            if hueDrag then updateHue(input) end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            satDrag = false
            hueDrag = false
        end
    end))

    if flag then
        Library.Flags[flag] = color
        Library.Options[flag] = object
    end
    return object
end

