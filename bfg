local function makeDraggable(handle, target)
    local dragging, dragStart, startPos
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Library:CreateWindow(opts)
    opts = opts or {}
    local windowObj = { Tabs = {} }

    local size = opts.Size or UDim2.new(0, 620, 0, 440)
    local minSize = opts.MinSize or Vector2.new(440, 300)
    local offset = #Library.Windows * 28

    local root = new("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, offset, 0.5, offset),
        Size = size,
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = not Library._hidden,
        Parent = ScreenGui,
    })
    corner(root, 12)
    local rootStroke = stroke(root, 0.86)
    bindTheme(root, function(t) return { BackgroundColor3 = t.Background } end)
    bindTheme(rootStroke, function(t) return { Color = t.Stroke } end)
    windowObj.Root = root

    local topbar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Library.Theme.Topbar,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = root,
    })
    local topStroke = new("Frame", {
        Position = UDim2.new(0, 0, 1, -1),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Library.Theme.Stroke,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = topbar,
    })
    bindTheme(topbar, function(t) return { BackgroundColor3 = t.Topbar } end)
    bindTheme(topStroke, function(t) return { BackgroundColor3 = t.Stroke } end)
    makeDraggable(topbar, root)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0),
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = Enum.Font.GothamBold,
        Text = opts.Title or "KoaUI",
        TextColor3 = Library.Theme.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
        Parent = topbar,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if opts.SubTitle then
        local subLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = Enum.Font.Gotham,
            Text = opts.SubTitle,
            TextColor3 = Library.Theme.SubText,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            Parent = topbar,
        })
        bindTheme(subLabel, function(t) return { TextColor3 = t.SubText } end)
        local function place()
            subLabel.Position = UDim2.new(0, 16 + titleLabel.AbsoluteSize.X + 8, 0, 1)
        end
        place()
        track(titleLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(place))
    end

    local searchWrap, searchBox
    if opts.Search ~= false then
        searchWrap = new("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -78, 0.5, 0),
            Size = UDim2.new(0, 160, 0, 28),
            BackgroundColor3 = Library.Theme.Surface,
            BorderSizePixel = 0,
            ZIndex = 4,
            Parent = topbar,
        })
        corner(searchWrap, 8)
        local ssz = stroke(searchWrap, 0.88)
        bindTheme(searchWrap, function(t) return { BackgroundColor3 = t.Surface } end)
        bindTheme(ssz, function(t) return { Color = t.Stroke } end)
        searchBox = new("TextBox", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(1, -18, 1, 0),
            Font = Enum.Font.Gotham,
            PlaceholderText = "Search...",
            Text = "",
            TextColor3 = Library.Theme.Text,
            PlaceholderColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            ZIndex = 5,
            Parent = searchWrap,
        })
        bindTheme(searchBox, function(t) return { TextColor3 = t.Text, PlaceholderColor3 = t.SubText } end)
    end

    local function makeTopBtn(symbol, xOff, callback)
        local b = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, xOff, 0.5, 0),
            Size = UDim2.new(0, 26, 0, 26),
            BackgroundColor3 = Library.Theme.Surface,
            Font = Enum.Font.GothamBold,
            Text = symbol,
            TextColor3 = Library.Theme.SubText,
            TextSize = 14,
            AutoButtonColor = false,
            ZIndex = 4,
            Parent = topbar,
        })
        corner(b, 7)
        bindTheme(b, function(t) return { BackgroundColor3 = t.Surface, TextColor3 = t.SubText } end)
        local hoverColor = symbol == "✕" and Library.Theme.Error or Library.Theme.Accent
        track(b.MouseEnter:Connect(function()
            tween(b, 0.15, { BackgroundColor3 = symbol == "✕" and Library.Theme.Error or Library.Theme.SurfaceHi })
            b.TextColor3 = symbol == "✕" and Library.Theme.AccentText or Library.Theme.Text
        end))
        track(b.MouseLeave:Connect(function()
            tween(b, 0.15, { BackgroundColor3 = Library.Theme.Surface })
            b.TextColor3 = Library.Theme.SubText
        end))
        track(b.MouseButton1Click:Connect(callback))
        return b
    end

    local body = new("Frame", {
        Position = UDim2.new(0, 0, 0, 44),
        Size = UDim2.new(1, 0, 1, -44),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = root,
    })

    local sidebar = new("Frame", {
        Size = UDim2.new(0, 158, 1, 0),
        BackgroundColor3 = Library.Theme.Sidebar,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = body,
    })
    bindTheme(sidebar, function(t) return { BackgroundColor3 = t.Sidebar } end)
    local sideStroke = new("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Library.Theme.Stroke,
        BackgroundTransparency = 0.92,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = sidebar,
    })
    bindTheme(sideStroke, function(t) return { BackgroundColor3 = t.Stroke } end)

    local tabList = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 2,
        Parent = sidebar,
    })
    padding(tabList, 12, 12, 10, 10)
    vlist(tabList, 5)

    local content = new("Frame", {
        Position = UDim2.new(0, 158, 0, 0),
        Size = UDim2.new(1, -158, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 2,
        Parent = body,
    })

    local resizeHandle = new("TextButton", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundTransparency = 1,
        Text = "◢",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Library.Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Bottom,
        AutoButtonColor = false,
        ZIndex = 5,
        Parent = root,
    })
    bindTheme(resizeHandle, function(t) return { TextColor3 = t.SubText } end)

    local resizing, resizeStart, startSize
    track(resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startSize = root.AbsoluteSize
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - resizeStart
            local w = math.max(minSize.X, startSize.X + delta.X)
            local hgt = math.max(minSize.Y, startSize.Y + delta.Y)
            root.Size = UDim2.new(0, w, 0, hgt)
            size = root.Size
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end))

    local minimized = false
    makeTopBtn("✕", -12, function() windowObj:Destroy() end)
    makeTopBtn("—", -44, function()
        minimized = not minimized
        if minimized then
            body.Visible = false
            resizeHandle.Visible = false
            tween(root, SPEED, { Size = UDim2.new(0, size.X.Offset, 0, 44) })
        else
            tween(root, SPEED, { Size = size })
            resizeHandle.Visible = true
            task.delay(0.16, function() body.Visible = true end)
        end
    end)

    windowObj._tabButtons = {}
    windowObj._tabPages = {}
    windowObj._tabs = {}

    local function applySearch(query)
        local tab = windowObj._tabs[windowObj.ActiveTab]
        if not tab then return end
        query = (query or ""):lower()
        for _, item in ipairs(tab._items) do
            item.frame.Visible = query == "" or item.title:find(query, 1, true) ~= nil
        end
    end

    if searchBox then
        track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            applySearch(searchBox.Text)
        end))
    end

    local function activate(name)
        for n, page in pairs(windowObj._tabPages) do
            page.Visible = (n == name)
        end
        for n, btn in pairs(windowObj._tabButtons) do
            local on = (n == name)
            tween(btn.Frame, 0.18, {
                BackgroundColor3 = on and Library.Theme.Surface or Library.Theme.Sidebar,
                BackgroundTransparency = on and 0 or 1,
            })
            btn.Label.TextColor3 = on and Library.Theme.Text or Library.Theme.SubText
            tween(btn.Indicator, 0.18, {
                Size = on and UDim2.new(0, 3, 0.6, 0) or UDim2.new(0, 3, 0, 0),
            })
        end
        windowObj.ActiveTab = name
        if searchBox then applySearch(searchBox.Text) end
    end

    function windowObj:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        local name = tabOpts.Title or ("Tab " .. (#windowObj.Tabs + 1))

        local tabBtn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Library.Theme.Surface,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 2,
            Parent = tabList,
        })
        corner(tabBtn, 8)
        bindTheme(tabBtn, function(t) return { BackgroundColor3 = t.Surface } end)

        local indicator = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 3, 0, 0),
            BackgroundColor3 = Library.Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = tabBtn,
        })
        corner(indicator, 2)
        bindTheme(indicator, function(t) return { BackgroundColor3 = t.Accent } end)

        local tabLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 14, 0, 0),
            Size = UDim2.new(1, -18, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = (tabOpts.Icon and (tabOpts.Icon .. "  ") or "") .. name,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 3,
            Parent = tabBtn,
        })

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.Theme.Accent,
            ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 2,
            Parent = content,
        })
        padding(page, 14, 16, 14, 14)
        vlist(page, 9)

        windowObj._tabButtons[name] = { Frame = tabBtn, Label = tabLabel, Indicator = indicator }
        windowObj._tabPages[name] = page

        track(tabBtn.MouseEnter:Connect(function()
            if windowObj.ActiveTab ~= name then tabLabel.TextColor3 = Library.Theme.Text end
        end))
        track(tabBtn.MouseLeave:Connect(function()
            if windowObj.ActiveTab ~= name then tabLabel.TextColor3 = Library.Theme.SubText end
        end))
        track(tabBtn.MouseButton1Click:Connect(function() activate(name) end))

        local tabObj = setmetatable({ Page = page, Window = windowObj, Name = name, _items = {} }, { __index = Elements })
        windowObj._tabs[name] = tabObj
        table.insert(windowObj.Tabs, tabObj)

        if #windowObj.Tabs == 1 then activate(name) end
        return tabObj
    end

    function windowObj:Destroy()
        for i, w in ipairs(Library.Windows) do
            if w == windowObj then table.remove(Library.Windows, i) break end
        end
        tween(root, 0.2, { BackgroundTransparency = 1 })
        root:Destroy()
    end

    function windowObj:Select(name)
        if windowObj._tabPages[name] then activate(name) end
    end

    root.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0)
    root.BackgroundTransparency = 1
    tween(root, 0.35, { Size = size, BackgroundTransparency = 0 })

    table.insert(Library.Windows, windowObj)
    return windowObj
end

function Library:CreateSettingsTab(window, configName)
    configName = configName or "default"
    local tab = window:CreateTab({ Title = "Settings", Icon = "⚙" })

    tab:Section({ Title = "Appearance" })

    local themeNames = {}
    for name in pairs(Library.Themes) do table.insert(themeNames, name) end
    table.sort(themeNames)

    tab:Dropdown({
        Title = "Theme",
        Values = themeNames,
        Default = Library.CurrentThemeName,
        Callback = function(v) Library:SetTheme(v) end,
    })

    tab:Section({ Title = "Interface" })

    tab:Keybind({
        Title = "Toggle UI Key",
        Default = Library.ToggleKey,
        Callback = function() Library:ToggleVisible() end,
    })

    tab:Section({ Title = "Configuration" })

    local nameInput = tab:Input({
        Title = "Config Name",
        Default = configName,
        Placeholder = "config name",
    })

    tab:Button({
        Title = "Save Config",
        Callback = function() Library:SaveConfig(nameInput:Get()) end,
    })
    tab:Button({
        Title = "Load Config",
        Callback = function() Library:LoadConfig(nameInput:Get()) end,
    })

    tab:Section({ Title = "Danger" })
    tab:Button({
        Title = "Unload UI",
        Description = "Removes the interface completely.",
        Callback = function()
            Library:Dialog({
                Title = "Unload UI",
                Content = "Are you sure you want to unload the interface?",
                Buttons = {
                    { Title = "Unload", Primary = true, Callback = function() Library:Unload() end },
                    { Title = "Cancel" },
                },
            })
        end,
    })

    return tab
end

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if Library._bindingActive then return end
    if gpe then return end
    if input.KeyCode == Library.ToggleKey then
        Library:ToggleVisible()
    end
end))

return Library
