Builders.Paragraph = function(container, opts)
    if type(opts) == "string" then opts = { Title = opts } end
    local Paragraph = { Type = "Paragraph" }
    local frame = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Element,
        Size             = UDim2.new(1, 0, 0, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        LayoutOrder      = NextOrder(container),
        Parent           = container,
    }), { BackgroundColor3 = "Element" })
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = frame })
    Themed(Create("UIStroke", { Thickness = 1, Parent = frame }), { Color = "Outline" })
    Create("UIPadding", { PaddingBottom = UDim.new(0, 10), Parent = frame })

    local title = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 12, 0, 8),
        Size           = UDim2.new(1, -24, 0, 16),
        Font           = Enum.Font.GothamBold,
        Text           = tostring(opts.Title or ""),
        TextSize       = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate   = Enum.TextTruncate.AtEnd,
        Parent         = frame,
    }), { TextColor3 = "Text" })

    local content = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 12, 0, 28),
        Size           = UDim2.new(1, -24, 0, 0),
        AutomaticSize  = Enum.AutomaticSize.Y,
        Font           = Enum.Font.Gotham,
        Text           = tostring(opts.Content or ""),
        TextSize       = 12,
        TextWrapped    = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent         = frame,
    }), { TextColor3 = "SubText" })

    Paragraph.Frame = frame
    Paragraph._conns = {}
    function Paragraph:Set(a, b)
        if type(a) == "table" then
            if a.Title then title.Text = tostring(a.Title) end
            if a.Content then content.Text = tostring(a.Content) end
        else
            if a ~= nil then title.Text = tostring(a) end
            if b ~= nil then content.Text = tostring(b) end
        end
    end
    Paragraph.Destroy = ElementDestroy
    return Paragraph
end

