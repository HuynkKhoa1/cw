Builders.Dropdown = function(container, opts)
    local Dropdown = {
        Type = "Dropdown",
        Multi = opts.Multi == true,
        Values = {},
        Callback = opts.Callback,
        Flag = opts.Flag,
        IgnoreConfig = opts.IgnoreConfig,
        Open = false,
        _changed = opts.OnChanged,
    }
    for _, v in ipairs(opts.Values or {}) do
        table.insert(Dropdown.Values, v)
    end

    if Dropdown.Multi then
        Dropdown.Value = {}
        for _, v in ipairs(opts.Default or {}) do Dropdown.Value[v] = true end
    else
        Dropdown.Value = opts.Default
    end

    local base = BaseElement(container, opts, 38, 150)
    Dropdown.Frame = base.Frame
    Dropdown._conns = base.Conns
    local headerH = base.Height
    base.Title.Size = UDim2.new(0.5, -12, 0, base.Title.Size.Y.Offset)

    local valueLabel = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint    = Vector2.new(1, 0.5),
        Position       = UDim2.new(1, -30, 0, headerH / 2),
        Size           = UDim2.new(0.42, 0, 0, headerH),
        Font           = Enum.Font.Gotham,
        Text           = "None",
        TextSize       = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate   = Enum.TextTruncate.AtEnd,
        Parent         = base.Frame,
    }), { TextColor3 = "SubText" })

    local arrow = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position    = UDim2.new(1, -10, 0, headerH / 2),
        Size        = UDim2.new(0, 16, 0, 16),
        Font        = Enum.Font.GothamBold,
        Text        = "▼",
        TextSize    = 9,
        Parent      = base.Frame,
    }), { TextColor3 = "SubText" })

    local listFrame = Themed(Create("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Position               = UDim2.new(0, 10, 0, headerH + 2),
        Size                   = UDim2.new(1, -20, 0, 0),
        CanvasSize             = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        ScrollBarThickness     = 2,
        Parent                 = base.Frame,
    }, {
        Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
    }), { ScrollBarImageColor3 = "Accent" })

    local function Selection()
        if Dropdown.Multi then
            local arr = {}
            for _, v in ipairs(Dropdown.Values) do
                if Dropdown.Value[v] then table.insert(arr, v) end
            end
            return arr
        end
        return Dropdown.Value
    end

    local function DisplayText()
        if Dropdown.Multi then
            local sel = Selection()
            if #sel == 0 then return "None" end
            local names = {}
            for _, v in ipairs(sel) do table.insert(names, tostring(v)) end
            return table.concat(names, ", ")
        end
        if Dropdown.Value ~= nil then return tostring(Dropdown.Value) end
        return "None"
    end

    local function FireChanged()
        local sel = Selection()
        if Dropdown.Flag then Library.Flags[Dropdown.Flag] = sel end
        SafeCall(Dropdown.Callback, sel)
        SafeCall(Dropdown._changed, sel)
    end

    local optionButtons = {}

    local function UpdateOptionVisuals()
        for value, entry in pairs(optionButtons) do
            local selected
            if Dropdown.Multi then
                selected = Dropdown.Value[value] == true
            else
                selected = Dropdown.Value == value
            end
            entry.Label.TextColor3 = selected and Library.Theme.Accent or Library.Theme.SubText
        end
        valueLabel.Text = DisplayText()
    end

    local function ListHeight()
        local visible = math.min(#Dropdown.Values, 6)
        if visible <= 0 then return 0 end
        return visible * 26 - 2
    end

    local function SetOpen(open)
        Dropdown.Open = open
        local lh = open and ListHeight() or 0
        if open then
            listFrame.Size = UDim2.new(1, -20, 0, lh)
        else
            listFrame.Size = UDim2.new(1, -20, 0, 0)
        end
        Tween(base.Frame, { Size = UDim2.new(1, 0, 0, headerH + (open and lh + 10 or 0)) }, 0.18)
        Tween(arrow, { Rotation = open and 180 or 0 }, 0.18)
    end

    local function Rebuild()
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        optionButtons = {}
        for i, value in ipairs(Dropdown.Values) do
            local optBtn = Create("TextButton", {
                Text             = "",
                AutoButtonColor  = false,
                BackgroundColor3 = Library.Theme.ElementHover,
                BackgroundTransparency = 1,
                Size             = UDim2.new(1, 0, 0, 24),
                LayoutOrder      = i,
                Parent           = listFrame,
            }, {
                Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
            })
            local lbl = Create("TextLabel", {
                BackgroundTransparency = 1,
                Position       = UDim2.new(0, 8, 0, 0),
                Size           = UDim2.new(1, -16, 1, 0),
                Font           = Enum.Font.Gotham,
                Text           = tostring(value),
                TextSize       = 12,
                TextColor3     = Library.Theme.SubText,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate   = Enum.TextTruncate.AtEnd,
                Parent         = optBtn,
            })
            optBtn.MouseEnter:Connect(function()
                Tween(optBtn, { BackgroundTransparency = 0.4 }, 0.1)
            end)
            optBtn.MouseLeave:Connect(function()
                Tween(optBtn, { BackgroundTransparency = 1 }, 0.1)
            end)
            optBtn.MouseButton1Click:Connect(function()
                if Dropdown.Multi then
                    if Dropdown.Value[value] then
                        Dropdown.Value[value] = nil
                    else
                        Dropdown.Value[value] = true
                    end
                    FireChanged()
                else
                    Dropdown.Value = value
                    FireChanged()
                    SetOpen(false)
                end
                UpdateOptionVisuals()
            end)
            optionButtons[value] = { Btn = optBtn, Label = lbl }
        end
        if Dropdown.Open then
            local lh = ListHeight()
            listFrame.Size = UDim2.new(1, -20, 0, lh)
            base.Frame.Size = UDim2.new(1, 0, 0, headerH + lh + 10)
        end
        UpdateOptionVisuals()
    end

    table.insert(Library._themeCallbacks, UpdateOptionVisuals)

    local header = Create("TextButton", {
        BackgroundTransparency = 1,
        Text   = "",
        Size   = UDim2.new(1, 0, 0, headerH),
        Parent = base.Frame,
    })
    AttachHover(header, base.Frame)
    header.MouseButton1Click:Connect(function()
        SetOpen(not Dropdown.Open)
    end)

    function Dropdown:Set(v)
        if Dropdown.Multi then
            local set = {}
            if type(v) == "table" then
                for _, item in ipairs(v) do set[item] = true end
            end
            Dropdown.Value = set
        else
            Dropdown.Value = v
        end
        UpdateOptionVisuals()
        FireChanged()
    end

    function Dropdown:SetValues(values)
        Dropdown.Values = {}
        for _, v in ipairs(values or {}) do table.insert(Dropdown.Values, v) end
        if Dropdown.Multi then
            local newSet = {}
            for _, v in ipairs(Dropdown.Values) do
                if Dropdown.Value[v] then newSet[v] = true end
            end
            Dropdown.Value = newSet
        else
            if Dropdown.Value ~= nil and not table.find(Dropdown.Values, Dropdown.Value) then
                Dropdown.Value = nil
            end
        end
        Rebuild()
    end

    function Dropdown:GetValue() return Selection() end
    function Dropdown:OnChanged(fn) Dropdown._changed = fn end
    function Dropdown:GetSaveValue() return Selection() end
    function Dropdown:LoadSaveValue(v) Dropdown:Set(v) end
    Dropdown.Destroy = ElementDestroy

    Rebuild()
    RegisterOption(Dropdown, Selection())
    return Dropdown
end

-- Keybind -----------------------------------------------

Builders.Keybind = function(container, opts)
    local Keybind = {
        Type = "Keybind",
        Mode = opts.Mode or "Always", -- "Always" | "Toggle" | "Hold"
        State = false,
        Key = ResolveKey(opts.Default),
        Callback = opts.Callback,
        Flag = opts.Flag,
        IgnoreConfig = opts.IgnoreConfig,
        _changed = opts.OnChanged or opts.ChangedCallback,
    }
    local base = BaseElement(container, opts, 38, 110)
    Keybind.Frame = base.Frame
    Keybind._conns = base.Conns

    local btn = Themed(Create("TextButton", {
        AnchorPoint      = Vector2.new(1, 0.5),
        Position         = UDim2.new(1, -12, 0, base.Height / 2),
        Size             = UDim2.new(0, 90, 0, 24),
        BackgroundColor3 = Library.Theme.Background,
        AutoButtonColor  = false,
        Text             = "",
        Parent           = base.Frame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    }), { BackgroundColor3 = "Background" })
    Themed(Create("UIStroke", { Thickness = 1, Parent = btn }), { Color = "Outline" })

    local label = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Size     = UDim2.new(1, 0, 1, 0),
        Font     = Enum.Font.Gotham,
        Text     = KeyDisplay(Keybind.Key),
        TextSize = 12,
        Parent   = btn,
    }), { TextColor3 = "SubText" })

    local listening = false
    local function SetDisplay()
        label.Text = listening and "..." or KeyDisplay(Keybind.Key)
    end

    function Keybind:Set(key)
        Keybind.Key = ResolveKey(key)
        SetDisplay()
        if Keybind.Flag then
            Library.Flags[Keybind.Flag] = Keybind.Key and Keybind.Key.Name or "None"
        end
        SafeCall(Keybind._changed, Keybind.Key)
    end

    btn.MouseButton1Click:Connect(function()
        listening = true
        Library._bindingActive = true
        SetDisplay()
    end)

    Track(base.Conns, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if listening then
            local newKey
            local done = false
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    done = true
                elseif input.KeyCode == Enum.KeyCode.Backspace then
                    newKey, done = nil, true
                    Keybind.Key = nil
                else
                    newKey, done = input.KeyCode, true
                end
            elseif input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                newKey, done = input.UserInputType, true
            end
            if done then
                listening = false
                Library._bindingActive = false
                Library._lastBindInput = input
                if newKey ~= nil or input.KeyCode == Enum.KeyCode.Backspace then
                    Keybind:Set(newKey)
                else
                    SetDisplay()
                end
            end
            return
        end

        if gameProcessed then return end
        if not InputMatches(input, Keybind.Key) then return end

        if Keybind.Mode == "Always" then
            SafeCall(Keybind.Callback, Keybind.Key)
        elseif Keybind.Mode == "Toggle" then
            Keybind.State = not Keybind.State
            SafeCall(Keybind.Callback, Keybind.State)
        elseif Keybind.Mode == "Hold" then
            Keybind.State = true
            SafeCall(Keybind.Callback, true)
        end
    end))

    Track(base.Conns, UserInputService.InputEnded:Connect(function(input)
        if Keybind.Mode == "Hold" and Keybind.State and InputMatches(input, Keybind.Key) then
            Keybind.State = false
            SafeCall(Keybind.Callback, false)
        end
    end))

    function Keybind:GetState() return Keybind.State end
    function Keybind:OnChanged(fn) Keybind._changed = fn end
    function Keybind:GetSaveValue()
        if not Keybind.Key then return { Kind = "None" } end
        local kind = Keybind.Key.EnumType == Enum.KeyCode and "KeyCode" or "UserInputType"
        return { Kind = kind, Name = Keybind.Key.Name }
    end
    function Keybind:LoadSaveValue(v)
        if type(v) ~= "table" then return end
        if v.Kind == "None" then
            Keybind:Set(nil)
        elseif v.Kind == "KeyCode" or v.Kind == "UserInputType" then
            local ok, item = pcall(function() return Enum[v.Kind][v.Name] end)
            if ok and item then Keybind:Set(item) end
        end
    end
    Keybind.Destroy = ElementDestroy

    RegisterOption(Keybind, Keybind.Key and Keybind.Key.Name or "None")
    return Keybind
end

