function Library:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "Notification"
    local content = opts.Content or ""
    local duration = opts.Duration or 4

    local card = new("Frame", {
        BackgroundColor3 = Library.Theme.Topbar,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = NotifHolder,
    })
    corner(card, 8)
    local cardStroke = stroke(card, Library.Theme.Outline, 1)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 12),
        Parent = card,
    })
    bindTheme(card, function(t) return { BackgroundColor3 = t.Topbar } end)
    bindTheme(cardStroke, function(t) return { Color = t.Outline } end)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
        Parent = card,
    })

    local accentBar = new("Frame", {
        BackgroundColor3 = Library.Theme.Accent,
        Size = UDim2.new(0, 3, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = card,
    })
    corner(accentBar, 2)
    bindTheme(accentBar, function(t) return { BackgroundColor3 = t.Accent } end)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        Parent = card,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if content ~= "" then
        local contentLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = content,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            Parent = card,
        })
        bindTheme(contentLabel, function(t) return { TextColor3 = t.SubText } end)
    end

    card.BackgroundTransparency = 1
    tween(card, 0.25, { BackgroundTransparency = 0 })

    task.delay(duration, function()
        if card and card.Parent then
            tween(card, 0.25, { BackgroundTransparency = 1 })
            task.wait(0.25)
            card:Destroy()
        end
    end)
end

--========================================================--
--  Config save / load
--========================================================--

local function ensureFolder()
    if not hasFS then return false end
    if not isfolder(Library.ConfigFolder) then
        pcall(makefolder, Library.ConfigFolder)
    end
    return true
end

function Library:SaveConfig(name)
    if not ensureFolder() then
        Library:Notify({ Title = "Config", Content = "No filesystem access.", Duration = 3 })
        return false
    end
    name = name or "default"
    local data = {}
    for flag, value in pairs(Library.Flags) do
        if typeof(value) == "Color3" then
            data[flag] = { __t = "Color3", r = value.R, g = value.G, b = value.B }
        elseif typeof(value) == "EnumItem" then
            data[flag] = { __t = "Enum", n = value.Name }
        else
            data[flag] = value
        end
    end
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not ok then return false end
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    pcall(writefile, path, encoded)
    Library:Notify({ Title = "Config", Content = "Saved '" .. name .. "'.", Duration = 3 })
    return true
end

function Library:LoadConfig(name)
    if not hasFS then return false end
    name = name or "default"
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    if typeof(isfile) ~= "function" or not isfile(path) then return false end
    local ok, raw = pcall(readfile, path)
    if not ok then return false end
    local ok2, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok2 then return false end

    for flag, value in pairs(data) do
        local option = Library.Options[flag]
        if typeof(value) == "table" and value.__t == "Color3" then
            value = Color3.new(value.r, value.g, value.b)
        elseif typeof(value) == "table" and value.__t == "Enum" then
            value = Enum.KeyCode[value.n] or value.n
        end
        if option then
            option:Set(value)
        else
            Library.Flags[flag] = value
        end
    end
    Library:Notify({ Title = "Config", Content = "Loaded '" .. name .. "'.", Duration = 3 })
    return true
end

function Library:ListConfigs()
    local list = {}
    if not hasFS or typeof(listfiles) ~= "function" or not isfolder(Library.ConfigFolder) then
        return list
    end
    for _, file in ipairs(listfiles(Library.ConfigFolder)) do
        local fname = file:match("([^/\\]+)%.json$")
        if fname then table.insert(list, fname) end
    end
    return list
end

--========================================================--
--  Theme switching
--========================================================--

function Library:SetTheme(name)
    local theme = Library.Themes[name]
    if not theme then return end
    Library.Theme = theme
    Library.CurrentThemeName = name
    for _, apply in ipairs(Library._themeCallbacks) do
        pcall(apply)
    end
end

--========================================================--
--  Unload / global toggle
--========================================================--

function Library:Unload()
    if Library.Unloaded then return end
    Library.Unloaded = true
    for _, conn in ipairs(Library.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Library.Connections)
    if ScreenGui then ScreenGui:Destroy() end
end

function Library:SetVisible(state)
    Library._hidden = not state
    for _, w in ipairs(Library.Windows) do
        w.Root.Visible = state
    end
end

function Library:ToggleVisible()
    Library:SetVisible(Library._hidden)
end

--========================================================--
--  Shared element builders
--========================================================--

local function makeElementBase(parent, height)
    local frame = new("Frame", {
        BackgroundColor3 = Library.Theme.Element,
        Size = UDim2.new(1, 0, 0, height or 38),
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(frame, 6)
    local s = stroke(frame, Library.Theme.Outline, 1)
    bindTheme(frame, function(t) return { BackgroundColor3 = t.Element } end)
    bindTheme(s, function(t) return { Color = t.Outline } end)
    return frame
end

local function makeTitle(parent, text, rightPad)
    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -(rightPad or 24), 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = parent,
    })
    bindTheme(label, function(t) return { TextColor3 = t.Text } end)
    return label
end

