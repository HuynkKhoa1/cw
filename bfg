local function elementBase(parent, height)
    local frame = new("Frame", {
        BackgroundColor3 = Library.Theme.Surface,
        Size = UDim2.new(1, 0, 0, height or 40),
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(frame, 8)
    local s = stroke(frame, 0.92)
    bindTheme(frame, function(t) return { BackgroundColor3 = t.Surface } end)
    bindTheme(s, function(t) return { Color = t.Stroke } end)
    return frame
end

local function hoverFill(frame)
    track(frame.MouseEnter:Connect(function()
        tween(frame, 0.18, { BackgroundColor3 = Library.Theme.SurfaceHi })
    end))
    track(frame.MouseLeave:Connect(function()
        tween(frame, 0.18, { BackgroundColor3 = Library.Theme.Surface })
    end))
end

