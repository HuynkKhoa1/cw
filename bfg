-- Self-calibrating coordinate conversion (T1.1/T1.2). PopupLayer is a full
-- screen child at canvas (0,0); its AbsolutePosition IS the offset between
-- canvas space and AbsolutePosition (inset-excluded) space, whatever the
-- platform/executor reports. Prefer this over hard-coding GuiService inset.
local function absToCanvas(absPos)
    local origin = Library.PopupLayer.AbsolutePosition -- (0, -inset) normally
    return absPos - origin
end
local function screenRectAbs()
    local origin = Library.PopupLayer.AbsolutePosition
    local size   = Library.PopupLayer.AbsoluteSize
    return origin, origin + size
end

