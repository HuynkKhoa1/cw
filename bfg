            ZIndex = 4,
            Parent = row,
        })
        dots[val] = { outer = outer, inner = inner }
        track(btn.MouseButton1Click:Connect(function() object:Set(val) end))
    end

    table.insert(Library._themeCallbacks, refresh) -- T2.1: re-apply radio ring colors on theme switch
    if flag then
        seedFlag(flag, selected) -- T1.7
        Library.Options[flag] = object
    end
    if selected ~= nil then refresh() end
    return object
