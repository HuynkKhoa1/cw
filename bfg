    })
end

local function tween(inst, time, props, style, dir)
    local t = TweenService:Create(inst, TweenInfo.new(aspeed(time), style or EASE, dir or DIR), props)
    t:Play()
    return t
end

local function bindTheme(inst, mapper)
    local function apply()
        local ok, res = pcall(mapper, Library.Theme)
        if ok and res then
            for k, v in pairs(res) do
                pcall(function() inst[k] = v end)
            end
        end
    end
    apply()
    table.insert(Library._themeCallbacks, apply)
    return inst
end

