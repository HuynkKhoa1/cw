function Elements:Stepper(opts)
    opts = opts or {}
    local flag = opts.Flag
    local min = opts.Min or 0
    local max = opts.Max or 100
    local step = opts.Step or 1
    local value = math.clamp(adoptFlag(flag, opts.Default or min, "number"), min, max) -- T1.7

    local frame = elementBase(self.Page, 40)
    elemTitle(frame, opts.Title or "Stepper", 116)
    register(self, frame, opts.Title)
    attachTooltip(frame, opts.Tooltip)

    local holder = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 96, 0, 26),
        BackgroundColor3 = Library.Theme.Inset,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(holder, 8)
    bindTheme(holder, function(t) return { BackgroundColor3 = t.Inset } end)

    local minus = new("TextButton", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 26, 1, 0),
        BackgroundTransparency = 1,
        Font = Library._fontBold,
        Text = "−",
        TextColor3 = accentColor(),
        TextSize = 16,
        ZIndex = 3,
        Parent = holder,
    })
    bindTheme(minus, function() return { TextColor3 = accentColor() } end)

    local valLabel = new("TextLabel", {
        Position = UDim2.new(0, 26, 0, 0),
        Size = UDim2.new(0, 44, 1, 0),
        BackgroundTransparency = 1,
        Font = Library._fontMedium,
        Text = tostring(value),
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        ZIndex = 3,
        Parent = holder,
    })
    bindTheme(valLabel, function(t) return { TextColor3 = t.Text } end)

    local plus = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 26, 1, 0),
        BackgroundTransparency = 1,
        Font = Library._fontBold,
        Text = "+",
        TextColor3 = accentColor(),
        TextSize = 16,
        ZIndex = 3,
        Parent = holder,
    })
    bindTheme(plus, function() return { TextColor3 = accentColor() } end)

    -- T3.6: snap to the step grid and round to the step's decimal places so
    -- 0.1 steps don't accumulate float error (0.30000000000000004).
    local stepDecimals = 0
    do
        local sstr = tostring(step)
        local dot = sstr:find("%.")
        if dot then stepDecimals = #sstr - dot end
    end
    local function snap(v)
        local snapped = math.floor((v / step) + 0.5) * step
        local m = 10 ^ stepDecimals
        return math.floor(snapped * m + 0.5) / m
    end

    local object = {}
    function object:Set(val)
        value = math.clamp(snap(val), min, max)
        valLabel.Text = tostring(value)
        if flag then Library.Flags[flag] = value end
        if opts.Callback then task.spawn(opts.Callback, value) end
    end
    function object:Get() return value end

    track(minus.MouseButton1Click:Connect(function() object:Set(value - step) end))
    track(plus.MouseButton1Click:Connect(function() object:Set(value + step) end))

    if flag then
        seedFlag(flag, value) -- T1.7
        Library.Options[flag] = object
    end
    return object
end

function Elements:Radio(opts)
