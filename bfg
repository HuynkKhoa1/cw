            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 2,
            Parent = frame,
        })
        bindTheme(desc, function(t) return { TextColor3 = t.SubText } end)
    end

    local pill = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 46, 0, 24),
        BackgroundColor3 = Library.Theme.Disabled,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(pill, 12)
    local pillStroke = stroke(pill, 0.5)
    bindTheme(pillStroke, function(t) return { Color = t.Stroke } end)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 18, 0, 18),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = pill,
    })
    corner(knob, 9)

    local btn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 4,
        Parent = frame,
    })

    local object = {}
    local function visual()
        if state then
            tween(pill, SPEED, { BackgroundColor3 = accentColor() })
            tween(knob, SPEED, { Position = UDim2.new(1, -21, 0.5, 0) })
        else
            tween(pill, SPEED, { BackgroundColor3 = Library.Theme.Disabled })
            tween(knob, SPEED, { Position = UDim2.new(0, 3, 0.5, 0) })
        end
    end

    function object:Set(v)
        state = v == true
        if flag then Library.Flags[flag] = state end
        visual()
        if opts.Callback then task.spawn(opts.Callback, state) end
    end
    function object:Get() return state end
    function object:Toggle() object:Set(not state) end

    hoverFill(frame)
    track(btn.MouseButton1Click:Connect(function() object:Set(not state) end))
    table.insert(Library._themeCallbacks, visual) -- T2.1: re-apply OFF pill color on theme switch

    -- Optional inline keybind: a compact key button left of the pill, on the same
    -- row. Pass Keybind (default key) and/or KeybindFlag. Pressing the key toggles
    -- this same toggle. Saved under KeybindFlag like a standalone Keybind.
    if opts.Keybind ~= nil or opts.KeybindFlag then
        local kbFlag = opts.KeybindFlag
        local kbKey = adoptFlag(kbFlag, opts.Keybind, nil)
        local kbMode = opts.KeybindMode or "Toggle"
        local kbListening = false

        local kbBtn = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -68, 0.5, 0), -- pill is 46 wide ending at -14; sit just left of it
            Size = UDim2.new(0, 64, 0, 24),
            BackgroundColor3 = Library.Theme.Inset,
            Font = Library._fontMedium,
            Text = kbKey and keyName(kbKey) or "None",
            TextColor3 = Library.Theme.SubText,
            TextSize = 12,
            AutoButtonColor = false,
            ZIndex = 2,
            Parent = frame,
        })
        corner(kbBtn, 8)
        local kbStroke = stroke(kbBtn, 0.6)
        bindTheme(kbBtn, function(t) return { BackgroundColor3 = t.Inset, TextColor3 = t.SubText } end)
        bindTheme(kbStroke, function(t) return { Color = t.Stroke } end)

        local kbObject = {}
        function kbObject:Set(v)
            kbKey = v
            kbBtn.Text = kbKey and keyName(kbKey) or "None"
            if kbFlag then Library.Flags[kbFlag] = kbKey end
        end
        function kbObject:Get() return kbKey end

        track(kbBtn.MouseButton1Click:Connect(function()
            kbListening = true
            Library._bindingActive = true
            kbBtn.Text = "..."
            tween(kbStroke, 0.18, { Color = accentColor(), Transparency = 0.1 })
        end))

        track(UserInputService.InputBegan:Connect(function(input, gpe)
            if kbListening then
                local v
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    v = input.KeyCode
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    v = input.UserInputType
                end
                if v == Enum.KeyCode.Escape then
                    kbListening = false
                    kbBtn.Text = kbKey and keyName(kbKey) or "None"
                    tween(kbStroke, 0.18, { Color = Library.Theme.Stroke, Transparency = 0.6 })
                    task.defer(function() Library._bindingActive = false end)
                    return
                end
                if v then
                    if v == Enum.KeyCode.Backspace then kbObject:Set(nil) else kbObject:Set(v) end
                    kbListening = false
                    tween(kbStroke, 0.18, { Color = Library.Theme.Stroke, Transparency = 0.6 })
                    task.defer(function() Library._bindingActive = false end)
                end
                return
            end
            if gpe then return end
            if Library._bindingActive then return end
            if kbKey == nil then return end
            if (input.KeyCode == kbKey) or (input.UserInputType == kbKey) then
                if kbMode == "Hold" then object:Set(true) else object:Set(not state) end
            end
        end))

        if kbMode == "Hold" then
            track(UserInputService.InputEnded:Connect(function(input)
                if Library._bindingActive then return end
                if kbKey and ((input.KeyCode == kbKey) or (input.UserInputType == kbKey)) then
                    object:Set(false)
                end
            end))
        end

        if kbFlag then
            seedFlag(kbFlag, kbKey)
            Library.Options[kbFlag] = kbObject
        end
    end

    if flag then
        seedFlag(flag, state) -- T1.7: bypass queueSave while building
        Library.Options[flag] = object
    end
    object:Set(state)
    return object
end

function Elements:Slider(opts)
    opts = opts or {}
    local flag = opts.Flag
    local min = opts.Min or 0
    local max = opts.Max or 100
    local decimals = opts.Decimals or 0
    local value = math.clamp(adoptFlag(flag, opts.Default or min, "number"), min, max) -- T1.7
    local suffix = opts.Suffix or ""

    local frame = elementBase(self.Page, 54)
    register(self, frame, opts.Title)
    attachTooltip(frame, opts.Tooltip)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 9),
        Size = UDim2.new(1, -84, 0, 16),
        Font = Library._fontMedium,
        Text = opts.Title or "Slider",
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(title, function(t) return { TextColor3 = t.Text } end)

    local valueBox = new("TextBox", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, 9),
        Size = UDim2.new(0, 72, 0, 16),
        Font = Library._fontBold,
        Text = tostring(value) .. suffix,
        TextColor3 = accentColor(),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        ClearTextOnFocus = false,
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(valueBox, function() return { TextColor3 = accentColor() } end)

    local barBack = new("Frame", {
        Position = UDim2.new(0, 14, 1, -18),
        Size = UDim2.new(1, -28, 0, 8),
        BackgroundColor3 = Library.Theme.Inset,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(barBack, 4)
    bindTheme(barBack, function(t) return { BackgroundColor3 = t.Inset } end)

    local barFill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = accentColor(),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = barBack,
    })
    corner(barFill, 4)
    bindTheme(barFill, function() return { BackgroundColor3 = accentColor() } end)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = barFill,
    })
    corner(knob, 7)

    local object = {}
    local function round(v)
        local mult = 10 ^ decimals
        return math.floor(v * mult + 0.5) / mult
    end

    function object:Set(v, skipCb)
        value = round(math.clamp(v, min, max))
        if flag then Library.Flags[flag] = value end
        local alpha = (max - min == 0) and 0 or (value - min) / (max - min)
        tween(barFill, 0.1, { Size = UDim2.new(alpha, 0, 1, 0) }, Enum.EasingStyle.Quad)
        valueBox.Text = tostring(value) .. suffix
        if opts.Callback and not skipCb then task.spawn(opts.Callback, value) end
    end
    function object:Get() return value end

    local function stripSuffix(text)
        if suffix ~= "" then
            local idx = text:find(suffix, 1, true)
            if idx then text = text:sub(1, idx - 1) end
        end
        return text
    end
    track(valueBox.FocusLost:Connect(function()
        local num = tonumber(stripSuffix(valueBox.Text))
        if num then object:Set(num) else valueBox.Text = tostring(value) .. suffix end
    end))

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - barBack.AbsolutePosition.X) / barBack.AbsoluteSize.X, 0, 1)
        object:Set(min + (max - min) * rel)
    end

    track(barBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tween(knob, 0.1, { Size = UDim2.new(0, 18, 0, 18) })
            update(input)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then tween(knob, 0.1, { Size = UDim2.new(0, 14, 0, 14) }) end
            dragging = false
        end
    end))

    if flag then
        seedFlag(flag, value) -- T1.7
        Library.Options[flag] = object
    end
    object:Set(value, true)
    return object
end

function Elements:Dropdown(opts)
    opts = opts or {}
    local flag = opts.Flag
    local values = opts.Values or {}
    local multi = opts.Multi == true
    local searchable = opts.Search == true
    local maxListHeight = opts.MaxHeight or 200
    local selected = multi and {} or nil

    if multi and opts.Default then
        for _, v in ipairs(opts.Default) do selected[v] = true end
    elseif not multi then
        selected = opts.Default
    end

    local frame = elementBase(self.Page, 40)
    elemTitle(frame, opts.Title or "Dropdown", 150)
    register(self, frame, opts.Title)
    attachTooltip(frame, opts.Tooltip)

    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -36, 0, 0),
        Size = UDim2.new(0, 118, 1, 0),
        Font = Library._font,
        Text = "None",
        TextColor3 = Library.Theme.SubText,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(valueLabel, function(t) return { TextColor3 = t.SubText } end)

    local arrow = new("ImageLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
        Image = Library.Icons.chevron,
        Rotation = 90,
        ImageColor3 = accentColor(),
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(arrow, function() return { ImageColor3 = accentColor() } end)

    local headBtn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 3,
        Parent = frame,
    })
    hoverFill(frame)

    local popup, listContainer, listLayout, searchBox
    local optionButtons = {}
    local open = false
    local object = {}

    local function labelText()
        if multi then
            local parts = {}
            for _, v in ipairs(values) do
                if selected[v] then table.insert(parts, tostring(v)) end
            end
            return #parts > 0 and table.concat(parts, ", ") or "None"
        else
            return selected ~= nil and tostring(selected) or "None"
        end
    end

    local function refreshHighlights()
        for v, b in pairs(optionButtons) do
            local on = multi and selected[v] or (selected == v)
            tween(b.frame, 0.15, { BackgroundColor3 = on and accentColor() or Library.Theme.Inset })
            b.label.TextColor3 = on and Library.Theme.AccentText or Library.Theme.SubText
            b.tick.ImageTransparency = on and 0 or 1
            b.tick.ImageColor3 = Library.Theme.AccentText
        end
        valueLabel.Text = labelText()
    end

    local function destroyPopup()
        if popup then popup:Destroy() popup = nil end
        optionButtons = {}
        listContainer = nil
        listLayout = nil
        searchBox = nil
    end

    local function buildPopup()
        destroyPopup()
        popup = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, frame.AbsoluteSize.X, 0, 0),
            ClipsDescendants = true,
            Active = true, -- T1.4: sink clicks in the gaps between option rows
            ZIndex = 601,
            Parent = PopupLayer,
        })
        acrylicGlass(popup, 10, 601)

        -- T1.1 engine-truth hardening: GuiObject.InputBegan fires per the
        -- engine's real hit-testing, immune to coordinate drift during the
        -- open/close tween. Mark the press as inside so the global outside-click
        -- handler never closes a popup the user actually pressed on.
        local function markInside(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                Library._pressInsidePopup = true
            end
        end
        track(popup.InputBegan:Connect(markInside))
        track(frame.InputBegan:Connect(markInside))

        local inner = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 604,
            Parent = popup,
        })
        padding(inner, 6, 6, 6, 6)
        vlist(inner, 5)

        if searchable then
            local searchWrap = new("Frame", {
