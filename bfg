function Elements:Toggle(opts)
    opts = opts or {}
    local flag = opts.Flag
    local state = opts.Default == true
    local frame = elementBase(self.Page, 40)
    elemTitle(frame, opts.Title or "Toggle", 66)
    register(self, frame, opts.Title)

    local pill = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 42, 0, 22),
        BackgroundColor3 = Library.Theme.Disabled,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(pill, 11)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = pill,
    })
    corner(knob, 8)

    local btn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 4,
        Parent = frame,
    })

    local object = {}

    local function visual()
        if state then
            tween(pill, SPEED, { BackgroundColor3 = Library.Theme.Accent })
            tween(knob, SPEED, { Position = UDim2.new(1, -19, 0.5, 0) })
        else
            tween(pill, SPEED, { BackgroundColor3 = Library.Theme.Disabled })
            tween(knob, SPEED, { Position = UDim2.new(0, 3, 0.5, 0) })
        end
    end

