local function makeDraggable(handle, target)
    local dragging, dragStart, startPos
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Library:CreateWindow(opts)
    opts = opts or {}
    local windowObj = { Tabs = {} }

    local size = opts.Size or UDim2.new(0, 600, 0, 420)
    local offset = #Library.Windows * 30

    local root = new("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, offset, 0.5, offset),
        Size = size,
        BackgroundColor3 = Library.Theme.BgBottom,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = not Library._hidden,
        Parent = ScreenGui,
    })
    corner(root, 16)
    local rootStroke = hairline(root, 0.82)
    bindTheme(root, function(t) return { BackgroundColor3 = t.BgBottom } end)
    bindTheme(rootStroke, function(t) return { Color = t.Outline } end)
    windowObj.Root = root

    -- Gradient canvas
    local bgGradient = new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(Library.Theme.BgTop, Library.Theme.BgBottom),
        Parent = root,
    })
    bindTheme(bgGradient, function(t)
        return { Color = ColorSequence.new(t.BgTop, t.BgBottom) }
    end)

    -- Animated ambient light blobs (drift slowly behind content)
    local blobLayer = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 0,
        Parent = root,
    })
    local function makeBlob(themeKey, startPos, blobSize)
        local blob = new("ImageLabel", {
            BackgroundTransparency = 1,
            Image = "rbxassetid://5028857084",
            ImageColor3 = Library.Theme[themeKey],
            ImageTransparency = 0.78,
            ScaleType = Enum.ScaleType.Fit,
            Size = blobSize,
            Position = startPos,
            ZIndex = 0,
            Parent = blobLayer,
        })
        bindTheme(blob, function(t) return { ImageColor3 = t[themeKey] } end)
        return blob
    end
    local blob1 = makeBlob("Blob1", UDim2.new(-0.1, 0, -0.15, 0), UDim2.new(0, 280, 0, 280))
    local blob2 = makeBlob("Blob2", UDim2.new(0.7, 0, 0.5, 0), UDim2.new(0, 260, 0, 260))
    local blob3 = makeBlob("Blob3", UDim2.new(0.3, 0, 0.7, 0), UDim2.new(0, 220, 0, 220))

    task.spawn(function()
        while not Library.Unloaded and root.Parent do
            tween(blob1, 6, { Position = UDim2.new(0.15, 0, 0.1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            tween(blob2, 7, { Position = UDim2.new(0.55, 0, 0.2, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            tween(blob3, 8, { Position = UDim2.new(0.1, 0, 0.55, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(8)
            if Library.Unloaded or not root.Parent then break end
            tween(blob1, 6, { Position = UDim2.new(-0.1, 0, -0.15, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            tween(blob2, 7, { Position = UDim2.new(0.7, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            tween(blob3, 8, { Position = UDim2.new(0.3, 0, 0.7, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(8)
        end
    end)

    -- Topbar (glass)
    local topbar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = Library.Theme.Glass,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = root,
    })
    addShine(topbar)
    local topStroke = new("Frame", {
        Position = UDim2.new(0, 0, 1, -1),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Library.Theme.Outline,
        BackgroundTransparency = 0.88,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = topbar,
    })
    bindTheme(topbar, function(t) return { BackgroundColor3 = t.Glass } end)
    bindTheme(topStroke, function(t) return { BackgroundColor3 = t.Outline } end)
    makeDraggable(topbar, root)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 18, 0, 0),
        Size = UDim2.new(0.6, 0, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = opts.Title or "KoaUI",
        TextColor3 = Library.Theme.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
        Parent = topbar,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if opts.SubTitle then
        local subLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 18 + titleLabel.TextBounds.X + 10, 0, 0),
            Size = UDim2.new(0, 120, 1, 0),
            Font = Enum.Font.Gotham,
            Text = opts.SubTitle,
            TextColor3 = Library.Theme.SubText,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            Parent = topbar,
        })
        bindTheme(subLabel, function(t) return { TextColor3 = t.SubText } end)
    end

    local function makeTopBtn(symbol, xOff, callback)
        local b = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, xOff, 0.5, 0),
            Size = UDim2.new(0, 26, 0, 26),
            BackgroundColor3 = Library.Theme.Surface,
            BackgroundTransparency = 0.2,
            Font = Enum.Font.GothamBold,
            Text = symbol,
            TextColor3 = Library.Theme.SubText,
            TextSize = 14,
            AutoButtonColor = false,
            ZIndex = 4,
            Parent = topbar,
        })
        corner(b, 8)
        bindTheme(b, function(t) return { BackgroundColor3 = t.Surface, TextColor3 = t.SubText } end)
        track(b.MouseEnter:Connect(function()
            tween(b, 0.2, { BackgroundColor3 = Library.Theme.Accent })
            b.TextColor3 = Library.Theme.AccentText
        end))
        track(b.MouseLeave:Connect(function()
            tween(b, 0.2, { BackgroundColor3 = Library.Theme.Surface })
            b.TextColor3 = Library.Theme.SubText
        end))
        track(b.MouseButton1Click:Connect(callback))
        return b
    end

    local body = new("Frame", {
        Position = UDim2.new(0, 0, 0, 46),
        Size = UDim2.new(1, 0, 1, -46),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = root,
    })

    -- Sidebar (glass)
    local sidebar = new("Frame", {
        Size = UDim2.new(0, 160, 1, 0),
        BackgroundColor3 = Library.Theme.Glass,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = body,
    })
    bindTheme(sidebar, function(t) return { BackgroundColor3 = t.Glass } end)
    local sideStroke = new("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Library.Theme.Outline,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = sidebar,
    })
    bindTheme(sideStroke, function(t) return { BackgroundColor3 = t.Outline } end)

    local tabList = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 2,
        Parent = sidebar,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        Parent = tabList,
    })
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = tabList,
    })

    -- Content container
    local content = new("Frame", {
        Position = UDim2.new(0, 160, 0, 0),
        Size = UDim2.new(1, -160, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = body,
    })

    local minimized = false
    makeTopBtn("✕", -10, function()
        windowObj:Destroy()
    end)
    makeTopBtn("—", -42, function()
        minimized = not minimized
        if minimized then
            body.Visible = false
            tween(root, 0.3, { Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 46) })
        else
            tween(root, 0.3, { Size = size })
            task.delay(0.18, function() body.Visible = true end)
        end
    end)

    windowObj._tabButtons = {}
    windowObj._tabPages = {}

    local function activate(name)
        for n, page in pairs(windowObj._tabPages) do
            page.Visible = (n == name)
        end
        for n, btn in pairs(windowObj._tabButtons) do
            local on = (n == name)
            tween(btn.Frame, 0.25, {
                BackgroundColor3 = on and Library.Theme.Surface or Library.Theme.Glass,
                BackgroundTransparency = on and 0.1 or 1,
            })
            btn.Label.TextColor3 = on and Library.Theme.Text or Library.Theme.SubText
            tween(btn.Indicator, 0.25, {
                Size = on and UDim2.new(0, 3, 0.55, 0) or UDim2.new(0, 3, 0, 0),
            })
            btn.Glow.ImageTransparency = on and 0.6 or 1
        end
        windowObj.ActiveTab = name
    end

    function windowObj:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        local name = tabOpts.Title or ("Tab " .. (#windowObj.Tabs + 1))

        local tabBtn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Library.Theme.Glass,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 2,
            Parent = tabList,
        })
        corner(tabBtn, 9)

        local glow = makeGlow(tabBtn, Library.Theme.Accent, 1)
        bindTheme(glow, function(t) return { ImageColor3 = t.Accent } end)

        local indicator = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 3, 0, 0),
            BackgroundColor3 = Library.Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = tabBtn,
        })
        corner(indicator, 2)
        bindTheme(indicator, function(t) return { BackgroundColor3 = t.Accent } end)

        local tabLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 14, 0, 0),
            Size = UDim2.new(1, -18, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = (tabOpts.Icon and (tabOpts.Icon .. "  ") or "") .. name,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 3,
            Parent = tabBtn,
        })

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.Theme.Accent,
            ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 2,
            Parent = content,
        })
        new("UIPadding", {
            PaddingTop = UDim.new(0, 14),
            PaddingBottom = UDim.new(0, 14),
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 14),
            Parent = page,
        })
        new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 9),
            Parent = page,
        })

        windowObj._tabButtons[name] = { Frame = tabBtn, Label = tabLabel, Indicator = indicator, Glow = glow }
        windowObj._tabPages[name] = page

        track(tabBtn.MouseEnter:Connect(function()
            if windowObj.ActiveTab ~= name then
                tabLabel.TextColor3 = Library.Theme.Text
            end
        end))
        track(tabBtn.MouseLeave:Connect(function()
            if windowObj.ActiveTab ~= name then
                tabLabel.TextColor3 = Library.Theme.SubText
            end
        end))
        track(tabBtn.MouseButton1Click:Connect(function()
            activate(name)
        end))

        local tabObj = setmetatable({ Page = page, Window = windowObj, Name = name }, { __index = Elements })
        table.insert(windowObj.Tabs, tabObj)

        if #windowObj.Tabs == 1 then
            activate(name)
        end

        return tabObj
    end

    function windowObj:Destroy()
        for i, w in ipairs(Library.Windows) do
            if w == windowObj then table.remove(Library.Windows, i) break end
        end
        root:Destroy()
    end

    function windowObj:Select(name)
        if windowObj._tabPages[name] then activate(name) end
    end

    -- Entrance animation
    root.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0)
    tween(root, 0.45, { Size = size })

    table.insert(Library.Windows, windowObj)
    return windowObj
end

--========================================================--
--  Built-in Settings tab
--========================================================--

function Library:CreateSettingsTab(window, configName)
    configName = configName or "default"
    local tab = window:CreateTab({ Title = "Settings", Icon = "⚙" })

    tab:Section({ Title = "Appearance" })

    local themeNames = {}
    for name in pairs(Library.Themes) do table.insert(themeNames, name) end
    table.sort(themeNames)

    tab:Dropdown({
        Title = "Theme",
        Values = themeNames,
        Default = Library.CurrentThemeName,
        Callback = function(v)
            Library:SetTheme(v)
        end,
    })

    tab:Section({ Title = "Interface" })

    tab:Keybind({
        Title = "Toggle UI Key",
        Default = Library.ToggleKey,
        Callback = function()
            Library:ToggleVisible()
        end,
    })

    tab:Section({ Title = "Configuration" })

    local nameInput = tab:Input({
        Title = "Config Name",
        Default = configName,
        Placeholder = "config name",
    })

    tab:Button({
        Title = "Save Config",
        Callback = function()
            Library:SaveConfig(nameInput:Get())
        end,
    })
    tab:Button({
        Title = "Load Config",
        Callback = function()
            Library:LoadConfig(nameInput:Get())
        end,
    })

    tab:Section({ Title = "Danger" })
    tab:Button({
        Title = "Unload UI",
        Callback = function()
            Library:Unload()
        end,
    })

    return tab
end

--========================================================--
--  Global toggle key listener
--========================================================--

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if Library._bindingActive then return end
    if gpe then return end
    if input.KeyCode == Library.ToggleKey then
        Library:ToggleVisible()
    end
end))

return Library
