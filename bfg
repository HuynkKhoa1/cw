local function ripple(button, holder)
    -- T1.12: MouseButton1Down gives (x, y) already in AbsolutePosition space,
    -- so subtracting holder.AbsolutePosition lands the ripple exactly under the
    -- cursor regardless of topbar size (GetMouseLocation included the inset).
    track(button.MouseButton1Down:Connect(function(x, y)
        local abs = holder.AbsolutePosition
        local circle = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, x - abs.X, 0, y - abs.Y),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0.75,
            BorderSizePixel = 0,
            ZIndex = (holder.ZIndex or 1) + 5,
            Parent = holder,
        })
        corner(circle, 999)
        local maxSize = math.max(holder.AbsoluteSize.X, holder.AbsoluteSize.Y) * 2
        tween(circle, 0.5, { Size = UDim2.new(0, maxSize, 0, maxSize), BackgroundTransparency = 1 })
        task.delay(0.5, function() if circle then circle:Destroy() end end)
    end))
end

local function keyName(input)
    if typeof(input) == "EnumItem" then
        if input.EnumType == Enum.KeyCode then
            return input.Name
        elseif input.EnumType == Enum.UserInputType then
            return (input.Name:gsub("MouseButton", "MB"))
        end
    end
    return tostring(input)
end

-- Singleton: if a previous KoaUI instance is still around (re-executed the
-- script), destroy it so only one UI exists at a time.
do
    local parent = getParentGui()
    for _, gui in ipairs(parent:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name:match("^KoaUI_") then
            pcall(function() gui:Destroy() end)
        end
    end
    -- clear any leftover game-world blur from an older instance
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("BlurEffect") and fx.Name == "KoaUIBlur" then
            pcall(function() fx:Destroy() end)
        end
    end
end

