local function makeElementBase(parent, height)
    local frame = new("Frame", {
        BackgroundColor3 = Library.Theme.Surface,
        BackgroundTransparency = 0.15,
        Size = UDim2.new(1, 0, 0, height or 40),
        BorderSizePixel = 0,
        Parent = parent,
    })
    corner(frame, 12)
    addShine(frame)
    local s = hairline(frame, 0.9)
    bindTheme(frame, function(t) return { BackgroundColor3 = t.Surface } end)
    bindTheme(s, function(t) return { Color = t.Outline } end)
    return frame
end

local function hoverLift(frame)
    track(frame.MouseEnter:Connect(function()
        tween(frame, 0.25, { BackgroundColor3 = Library.Theme.SurfaceHi })
    end))
    track(frame.MouseLeave:Connect(function()
        tween(frame, 0.25, { BackgroundColor3 = Library.Theme.Surface })
    end))
end

local function makeTitle(parent, text, rightPad)
    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 0),
        Size = UDim2.new(1, -(rightPad or 26), 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 2,
        Parent = parent,
    })
    bindTheme(label, function(t) return { TextColor3 = t.Text } end)
    return label
end

