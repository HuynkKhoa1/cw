        destroyPopup()
        popup = new("Frame", {
            BackgroundColor3 = Library.Theme.Topbar,
            BorderSizePixel = 0,
            Size = UDim2.new(0, frame.AbsoluteSize.X, 0, 0),
            ClipsDescendants = true,
            ZIndex = 520,
            Parent = PopupLayer,
        })
        corner(popup, 8)
        stroke(popup, 0.78)
        shadow(popup, 0.55, 26)
        bindTheme(popup, function(t) return { BackgroundColor3 = t.Topbar } end)

        local inner = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 521,
            Parent = popup,
        })
        padding(inner, 6, 6, 6, 6)
        vlist(inner, 5)

        if searchable then
            local searchWrap = new("Frame", {
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = Library.Theme.Inset,
                BorderSizePixel = 0,
                LayoutOrder = 1,
                ZIndex = 522,
                Parent = inner,
            })
            corner(searchWrap, 7)
            bindTheme(searchWrap, function(t) return { BackgroundColor3 = t.Inset } end)
            searchBox = new("TextBox", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -18, 1, 0),
                Font = Library._font,
                PlaceholderText = "Search...",
                Text = "",
                TextColor3 = Library.Theme.Text,
                PlaceholderColor3 = Library.Theme.SubText,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                ZIndex = 523,
                Parent = searchWrap,
            })
            bindTheme(searchBox, function(t) return { TextColor3 = t.Text, PlaceholderColor3 = t.SubText } end)
        end

        listContainer = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = accentColor(),
            ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            LayoutOrder = 2,
            ZIndex = 522,
            Parent = inner,
        })
        listLayout = vlist(listContainer, 4)

        for _, v in ipairs(values) do
            local optFrame = new("Frame", {
                BackgroundColor3 = Library.Theme.Inset,
                Size = UDim2.new(1, 0, 0, 30),
                BorderSizePixel = 0,
                ClipsDescendants = true,
                ZIndex = 523,
                Parent = listContainer,
            })
            corner(optFrame, 7)
            local optLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -38, 1, 0),
                Font = Library._font,
                Text = tostring(v),
                TextColor3 = Library.Theme.SubText,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 524,
                Parent = optFrame,
            })
            local tick = new("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14),
                Image = Library.Icons.check,
                ImageTransparency = 1,
                ZIndex = 524,
                Parent = optFrame,
            })
            local optBtn = new("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                ZIndex = 525,
                Parent = optFrame,
            })
            optionButtons[v] = { frame = optFrame, label = optLabel, tick = tick }
            track(optBtn.MouseEnter:Connect(function()
                local on = multi and selected[v] or (selected == v)
                if not on then tween(optFrame, 0.12, { BackgroundColor3 = Library.Theme.SurfaceHi }) end
            end))
            track(optBtn.MouseLeave:Connect(function()
                local on = multi and selected[v] or (selected == v)
                if not on then tween(optFrame, 0.12, { BackgroundColor3 = Library.Theme.Inset }) end
            end))
            track(optBtn.MouseButton1Click:Connect(function()
                if multi then
                    selected[v] = (not selected[v]) or nil
                    local arr = {}
                    for _, val in ipairs(values) do
                        if selected[val] then table.insert(arr, val) end
                    end
                    object:Set(arr)
                else
                    object:Set(v)
                    object:Close()
                end
            end))
        end

        if searchBox then
            track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local q = searchBox.Text:lower()
                for v, b in pairs(optionButtons) do
                    b.frame.Visible = q == "" or tostring(v):lower():find(q, 1, true) ~= nil
                end
                object:_Reposition()
            end))
        end

        refreshHighlights()
    end

    local animating = false
    function object:_TotalHeight()
        local contentH = listLayout and listLayout.AbsoluteContentSize.Y or 0
        local listH = math.min(maxListHeight, contentH)
        if listContainer then
            listContainer.Size = UDim2.new(1, 0, 0, listH)
            listContainer.CanvasSize = UDim2.new(0, 0, 0, contentH)
        end
        local searchH = searchable and 33 or 0
        return listH + searchH + 12
    end

    function object:_Reposition()
        if not popup or not open then return end
        local pos = frame.AbsolutePosition
        local sz = frame.AbsoluteSize
        local totalH = object:_TotalHeight()
        local screenH = ScreenGui.AbsoluteSize.Y
        local belowY = pos.Y + sz.Y + 6
        local fitsBelow = (belowY + totalH) <= (screenH - 8)
        local finalY = fitsBelow and belowY or (pos.Y - totalH - 6)
        if not animating then
            popup.Size = UDim2.new(0, sz.X, 0, totalH)
            popup.Position = UDim2.new(0, pos.X, 0, finalY)
        else
            popup.Position = UDim2.new(0, pos.X, 0, finalY)
        end
    end

    local repoConn
    function object:Open()
        if open then return end
        if Library._openPopup then Library._openPopup() end
        open = true
        buildPopup()
        tween(arrow, SPEED, { Rotation = -90 })
        local sz = frame.AbsoluteSize
        local totalH = object:_TotalHeight()
        animating = true
        popup.Size = UDim2.new(0, sz.X, 0, 0)
        popup.BackgroundTransparency = 1
        object:_Reposition()
        tween(popup, SPEED, { Size = UDim2.new(0, sz.X, 0, totalH), BackgroundTransparency = 0 })
        task.delay(aspeed(SPEED), function() animating = false end)
        Library._openDropdown = object
        Library._openPopup = function() object:Close() end
        repoConn = RunService.RenderStepped:Connect(function()
            object:_Reposition()
        end)
    end

    function object:Close()
        if not open then return end
        open = false
        tween(arrow, SPEED, { Rotation = 90 })
        if repoConn then repoConn:Disconnect() repoConn = nil end
        if popup then
            tween(popup, SPEED * 0.8, { Size = UDim2.new(0, frame.AbsoluteSize.X, 0, 0), BackgroundTransparency = 1 })
            local p = popup
            popup = nil
            task.delay(aspeed(SPEED), function() if p then p:Destroy() end end)
            optionButtons = {}
        end
        if Library._openDropdown == object then Library._openDropdown = nil end
        if Library._openPopup then Library._openPopup = nil end
    end

    function object:Toggle()
        if open then object:Close() else object:Open() end
    end

    function object:Set(v)
        if multi then
            selected = {}
            if typeof(v) == "table" then
                for _, item in ipairs(v) do selected[item] = true end
            end
            if flag then
                local arr = {}
                for _, val in ipairs(values) do
                    if selected[val] then table.insert(arr, val) end
                end
                Library.Flags[flag] = arr
            end
        else
            selected = v
            if flag then Library.Flags[flag] = selected end
        end
        if open then refreshHighlights() else valueLabel.Text = labelText() end
        if opts.Callback then task.spawn(opts.Callback, selected) end
    end
    function object:Get() return selected end

    function object:Refresh(newValues, keepSelection)
        values = newValues or values
        if not keepSelection then
            if multi then selected = {} else selected = nil end
        end
        if open then
            buildPopup()
            object:_Reposition()
        else
            valueLabel.Text = labelText()
        end
    end

    track(headBtn.MouseButton1Click:Connect(function() object:Toggle() end))

    valueLabel.Text = labelText()
    if multi and opts.Default then
        object:Set(opts.Default)
    elseif not multi and opts.Default ~= nil then
        object:Set(opts.Default)
    end

    if flag then Library.Options[flag] = object end
    return object
end

