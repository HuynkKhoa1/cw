function Elements:Keybind(opts)
    opts = opts or {}
    local flag = opts.Flag
    local mode = opts.Mode or "Toggle"
    local key = adoptFlag(flag, opts.Default, nil) -- T1.7 (EnumItem already decoded)
    local held = false
    local allowMouse = opts.AllowMouse == true -- T1.9

    local frame = elementBase(self.Page, 40)
    elemTitle(frame, opts.Title or "Keybind", 116)
    register(self, frame, opts.Title)
    attachTooltip(frame, opts.Tooltip)

    local keyBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 94, 0, 26),
        BackgroundColor3 = Library.Theme.Inset,
        Font = Library._fontMedium,
        Text = key and keyName(key) or "None",
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        AutoButtonColor = false,
        ZIndex = 2,
        Parent = frame,
    })
    corner(keyBtn, 8)
    local keyStroke = stroke(keyBtn, 0.6)
    bindTheme(keyBtn, function(t) return { BackgroundColor3 = t.Inset, TextColor3 = t.Text } end)
    bindTheme(keyStroke, function(t) return { Color = t.Stroke } end)

    local object = {}
    local listening = false

    function object:Set(v)
        key = v
        keyBtn.Text = key and keyName(key) or "None"
        if flag then Library.Flags[flag] = key end
        if opts.OnChanged then task.spawn(opts.OnChanged, key) end
    end
    function object:Get() return key end

    track(keyBtn.MouseButton1Click:Connect(function()
        listening = true
        Library._bindingActive = true
        keyBtn.Text = "..."
        tween(keyStroke, 0.18, { Color = accentColor(), Transparency = 0.1 })
    end))

    track(UserInputService.InputBegan:Connect(function(input, gpe)
        if listening then
            local v
            if input.UserInputType == Enum.UserInputType.Keyboard then
                v = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                v = input.UserInputType
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 and allowMouse then
                v = input.UserInputType -- T1.9: only bind MB1 when explicitly allowed
            end
            if v == Enum.KeyCode.Escape then -- T3.7: cancel capture, keep old binding
                listening = false
                keyBtn.Text = key and keyName(key) or "None"
                tween(keyStroke, 0.18, { Color = Library.Theme.Stroke, Transparency = 0.6 })
                task.defer(function() Library._bindingActive = false end)
                return
            end
            if v then
                if v == Enum.KeyCode.Backspace then object:Set(nil) else object:Set(v) end
                listening = false
                tween(keyStroke, 0.18, { Color = Library.Theme.Stroke, Transparency = 0.6 })
                task.defer(function() Library._bindingActive = false end)
            end
            return
        end
        if gpe then return end
        if Library._bindingActive then return end -- T1.8: ignore while ANY keybind captures
        if key == nil then return end
        local match = (input.KeyCode == key) or (input.UserInputType == key)
        if match then
            if mode == "Hold" then
                held = true
                if opts.Callback then task.spawn(opts.Callback, true) end
            else
                if opts.Callback then task.spawn(opts.Callback) end
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if Library._bindingActive then return end -- T1.8
        if mode == "Hold" and held and key then
            local match = (input.KeyCode == key) or (input.UserInputType == key)
            if match then
                held = false
                if opts.Callback then task.spawn(opts.Callback, false) end
            end
        end
    end))

    if flag then
        seedFlag(flag, key) -- T1.7
        Library.Options[flag] = object
    end
    return object
end

