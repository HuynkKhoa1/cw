local EASE  = Enum.EasingStyle.Quart
local DIR   = Enum.EasingDirection.Out
local SPEED = 0.22

local function aspeed(n)
    return (n or SPEED) * Library._animSpeed
end

local function getParentGui()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok = pcall(function() return CoreGui:GetFullName() end)
    if ok then return CoreGui end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function protectGui(gui)
    if syn and syn.protect_gui then
        pcall(syn.protect_gui, gui)
    elseif protect_gui then
        pcall(protect_gui, gui)
    end
end

local hasFS = (typeof(writefile) == "function")
