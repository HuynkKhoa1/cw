Builders.Label = function(container, opts)
    if type(opts) == "string" then opts = { Title = opts } end
    local Label = { Type = "Label" }
    local frame = Create("Frame", {
        BackgroundTransparency = 1,
        Size        = UDim2.new(1, 0, 0, 20),
        LayoutOrder = NextOrder(container),
        Parent      = container,
    })
    local text = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 2, 0, 0),
        Size           = UDim2.new(1, -4, 1, 0),
        Font           = Enum.Font.Gotham,
        Text           = tostring(opts.Title or opts.Text or ""),
        TextSize       = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate   = Enum.TextTruncate.AtEnd,
        Parent         = frame,
    }), { TextColor3 = "SubText" })
