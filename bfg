        Position         = UDim2.new(s, 0, 1 - v, 0),
        Size             = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = defaultColor,
        ZIndex           = 3,
        Parent           = svBox,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        Create("UIStroke", { Thickness = 2, Color = Color3.fromRGB(255, 255, 255) }),
    })

    -- Hue bar
    local hueKeypoints = {}
    for i = 0, 6 do
        table.insert(hueKeypoints, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
    end
    local hueBar = Create("Frame", {
        AnchorPoint      = Vector2.new(1, 0),
        Position         = UDim2.new(1, -12, 0, headerH + 4),
        Size             = UDim2.new(0, 18, 0, 110),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent           = base.Frame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(hueKeypoints) }),
    })

    local hueCursor = Create("Frame", {
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.new(0.5, 0, h, 0),
        Size             = UDim2.new(1, 4, 0, 4),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex           = 3,
        Parent           = hueBar,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    -- Hex row
    local hexBox = Themed(Create("TextBox", {
        Position         = UDim2.new(0, 12, 0, headerH + 122),
        Size             = UDim2.new(0, 86, 0, 24),
        BackgroundColor3 = Library.Theme.Background,
        Font             = Enum.Font.Code,
        Text             = ColorToHex(defaultColor),
        TextSize         = 12,
        ClearTextOnFocus = false,
        Parent           = base.Frame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    }), { BackgroundColor3 = "Background", TextColor3 = "Text" })
    Themed(Create("UIStroke", { Thickness = 1, Parent = hexBox }), { Color = "Outline" })

    local rgbLabel = Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 108, 0, headerH + 122),
        Size           = UDim2.new(1, -120, 0, 24),
        Font           = Enum.Font.Gotham,
        Text           = "",
        TextSize       = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent         = base.Frame,
    }), { TextColor3 = "SubText" })

    local function ApplyHSV(nh, ns, nv, fire)
        ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Val = nh, ns, nv
        ColorPicker.Value = Color3.fromHSV(nh, ns, nv)
        local c = ColorPicker.Value
        swatch.BackgroundColor3 = c
        svBox.BackgroundColor3 = Color3.fromHSV(nh, 1, 1)
        svCursor.Position = UDim2.new(ns, 0, 1 - nv, 0)
        svCursor.BackgroundColor3 = c
        hueCursor.Position = UDim2.new(0.5, 0, nh, 0)
        if not hexBox:IsFocused() then
            hexBox.Text = ColorToHex(c)
        end
        rgbLabel.Text = string.format("%d, %d, %d",
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5))
        if ColorPicker.Flag then Library.Flags[ColorPicker.Flag] = c end
        if fire then
            SafeCall(ColorPicker.Callback, c)
            SafeCall(ColorPicker._changed, c)
        end
    end
    ApplyHSV(h, s, v, false)

    local function SetOpen(open)
        ColorPicker.Open = open
        Tween(base.Frame, { Size = UDim2.new(1, 0, 0, open and expandedH or headerH) }, 0.18)
    end

    local header = Create("TextButton", {
        BackgroundTransparency = 1,
        Text   = "",
        Size   = UDim2.new(1, 0, 0, headerH),
        Parent = base.Frame,
    })
    AttachHover(header, base.Frame)
    header.MouseButton1Click:Connect(function()
        SetOpen(not ColorPicker.Open)
    end)

    local draggingSV, draggingHue = false, false

    Track(base.Conns, svBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            local relX, relY = RelativeMouse(svBox)
            ApplyHSV(ColorPicker.Hue, relX, 1 - relY, true)
        end
    end))
    Track(base.Conns, hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            local _, relY = RelativeMouse(hueBar)
            ApplyHSV(relY, ColorPicker.Sat, ColorPicker.Val, true)
        end
    end))
    Track(base.Conns, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if draggingSV then
            local relX, relY = RelativeMouse(svBox)
            ApplyHSV(ColorPicker.Hue, relX, 1 - relY, true)
        elseif draggingHue then
            local _, relY = RelativeMouse(hueBar)
            ApplyHSV(relY, ColorPicker.Sat, ColorPicker.Val, true)
        end
    end))
    Track(base.Conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV, draggingHue = false, false
        end
    end))

    Track(base.Conns, hexBox.FocusLost:Connect(function()
        local c = HexToColor(hexBox.Text)
        if c then
            local nh, ns, nv = Color3.toHSV(c)
            ApplyHSV(nh, ns, nv, true)
        else
            hexBox.Text = ColorToHex(ColorPicker.Value)
        end
    end))

    function ColorPicker:Set(color)
        if typeof(color) ~= "Color3" then return end
        local nh, ns, nv = Color3.toHSV(color)
        ApplyHSV(nh, ns, nv, true)
    end
    function ColorPicker:OnChanged(fn) ColorPicker._changed = fn end
    function ColorPicker:GetSaveValue() return ColorToHex(ColorPicker.Value) end
    function ColorPicker:LoadSaveValue(v)
        local c = HexToColor(v)
        if c then ColorPicker:Set(c) end
    end
    ColorPicker.Destroy = ElementDestroy

    RegisterOption(ColorPicker, ColorPicker.Value)
    return ColorPicker
end

