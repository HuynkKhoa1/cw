function Library:SetNotifPosition(pos)
    Library.NotifPosition = pos
    if Library._queueSave then Library._queueSave() end
    if pos == "TopRight" then
        NotifHolder.AnchorPoint = Vector2.new(1, 0)
        NotifHolder.Position = UDim2.new(1, -16, 0, 16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    elseif pos == "TopLeft" then
        NotifHolder.AnchorPoint = Vector2.new(0, 0)
        NotifHolder.Position = UDim2.new(0, 16, 0, 16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    elseif pos == "BottomRight" then
        NotifHolder.AnchorPoint = Vector2.new(1, 1)
        NotifHolder.Position = UDim2.new(1, -16, 1, -16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    elseif pos == "BottomLeft" then
        NotifHolder.AnchorPoint = Vector2.new(0, 1)
        NotifHolder.Position = UDim2.new(0, 16, 1, -16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    end
end

function Library:Notify(opts)
    if Library.Unloaded then return { Dismiss = function() end } end -- T1.10
    opts = opts or {}
    local title = opts.Title or "Notification"
    local content = opts.Content or ""
    local duration = opts.Duration or 4
    local kind = opts.Type or "Info"

    local accent = accentColor()
    local iconId = Library.Icons.info
    if kind == "Success" then accent = Library.Theme.Success; iconId = Library.Icons.check
    elseif kind == "Warning" then accent = Library.Theme.Warning; iconId = Library.Icons.warning
    elseif kind == "Error" then accent = Library.Theme.Error; iconId = Library.Icons.error end

    local card = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 56),
        ClipsDescendants = true,
        ZIndex = 801,
        Parent = NotifHolder,
    })
    local glass = acrylicGlass(card, 12, 801)
    glass.BackgroundTransparency = 1
    tween(glass, 0.3, { BackgroundTransparency = 0.9 })

    local notifBar = new("Frame", {
        BackgroundColor3 = accent,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.new(0, 3, 1, -24),
        BorderSizePixel = 0,
        ZIndex = 805,
        Parent = card,
    })
    corner(notifBar, 999)

    new("ImageLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 18, 0, 13),
        Size = UDim2.new(0, 18, 0, 18),
        Image = iconId,
        ImageColor3 = accent,
        ZIndex = 805,
        Parent = card,
    })

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 46, 0, 0),
        Size = UDim2.new(1, -60, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 805,
        Parent = card,
    })
    padding(holder, 12, 14, 0, 0)
    vlist(holder, 4)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Library._fontBold,
        Text = title,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        ZIndex = 805,
        Parent = holder,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if content ~= "" then
        local contentLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Library._font,
            Text = content,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            ZIndex = 805,
            Parent = holder,
        })
        bindTheme(contentLabel, function(t) return { TextColor3 = t.SubText } end)
    end

    local progress
    if duration > 0 then
        progress = new("Frame", {
            BackgroundColor3 = accent,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 2),
            BorderSizePixel = 0,
            BackgroundTransparency = 0.3,
            ZIndex = 805,
            Parent = card,
        })
    end

    local function resize()
        card.Size = UDim2.new(1, 0, 0, holder.AbsoluteSize.Y)
    end
    local resizeConn = holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    task.defer(resize)

    if progress then
        -- T1.10: raw duration (no aspeed) so the bar empties exactly when the
        -- task.delay(duration) dismissal fires, regardless of _animSpeed.
        TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { Size = UDim2.new(0, 0, 0, 2) }):Play()
    end

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        if resizeConn then resizeConn:Disconnect() end
        tween(glass, 0.25, { BackgroundTransparency = 1 })
        tween(card, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
        -- T1.10: destroy delay must outlast the exit tween at any anim speed.
        task.delay(aspeed(0.25) + 0.05, function() if card then card:Destroy() end end)
    end

    local clickBtn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 806,
        Parent = card,
    })
    track(clickBtn.MouseButton1Click:Connect(function()
        dismiss()
        if opts.Callback then task.spawn(opts.Callback) end
    end))

    if duration > 0 then
        task.delay(duration, dismiss)
    end

    return { Dismiss = dismiss }
end

local activeTooltip
function Library:_ShowTooltip(text)
    if activeTooltip then activeTooltip:Destroy() end
    local tip = new("Frame", {
        BackgroundColor3 = Library.Theme.Inset,
        AutomaticSize = Enum.AutomaticSize.XY,
        ZIndex = 901,
        Parent = TooltipHolder,
    })
    corner(tip, 8)
    stroke(tip, 0.7)
    padding(tip, 6, 6, 10, 10)
    new("TextLabel", {
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.XY,
        Font = Library._font,
        Text = text,
        TextColor3 = Library.Theme.Text,
        TextSize = 12,
        ZIndex = 902,
        Parent = tip,
    })
    local mouse = UserInputService:GetMouseLocation()
    tip.Position = UDim2.new(0, mouse.X + 14, 0, mouse.Y - 4)
    activeTooltip = tip
    return tip
end

function Library:_HideTooltip()
    if activeTooltip then activeTooltip:Destroy() activeTooltip = nil end
end

function Library:CreateStatus(opts)
    opts = opts or {}
    if Library._statusObj then return Library._statusObj end

    local pill = new("TextButton", {
        Name = "Status",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = opts.Position or UDim2.new(0.5, 0, 0, 12),
        Size = UDim2.new(0, opts.Width or 156, 0, 32),
        BackgroundColor3 = Library.Theme.AcrylicMain,
        BackgroundTransparency = 0.2,
        AutoButtonColor = false,
        Text = "",
        ZIndex = 650,
        Parent = ScreenGui,
    })
    corner(pill, 999)
    local pStroke = new("UIStroke", {
        Color = accentColor(),
        Transparency = 0.4,
        Thickness = 1,
        Parent = pill,
    })
    bindTheme(pill, function(t) return { BackgroundColor3 = t.AcrylicMain } end)
    bindTheme(pStroke, function() return { Color = accentColor() } end)

    local dot = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 12, 0.5, 0),
        Size = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = accentColor(),
        BorderSizePixel = 0,
        ZIndex = 651,
        Parent = pill,
    })
    corner(dot, 999)
    bindTheme(dot, function() return { BackgroundColor3 = accentColor() } end)

    local label = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 28, 0, 0),
        Size = UDim2.new(1, -36, 1, 0),
        Font = Library._fontMedium,
        Text = opts.Text or "KoaUI",
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 651,
        Parent = pill,
    })
    bindTheme(label, function(t) return { TextColor3 = t.Text } end)

    local didDrag = false
    do
        local dragging, dragStart, startPos
        track(pill.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                didDrag = false
                dragStart = input.Position
                startPos = pill.Position
            end
        end))
        track(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                if delta.Magnitude > 5 then didDrag = true end
                pill.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end

    track(pill.MouseButton1Click:Connect(function()
        if didDrag then didDrag = false; return end
        if opts.Callback then opts.Callback() else Library:ToggleVisible() end
    end))

    local fpsConn
    if opts.ShowFPS ~= false then
        local frames, acc = 0, 0
        local base = opts.Text or "KoaUI"
        fpsConn = track(RunService.RenderStepped:Connect(function(dt)
            if not pill.Visible then frames, acc = 0, 0; return end -- T3.13: no work while hidden
            frames += 1
            acc += dt
            if acc >= 0.5 then
                label.Text = base .. "  |  " .. math.floor(frames / acc + 0.5) .. " fps"
                frames, acc = 0, 0
            end
        end))
    end

    local object = {}
    object.Instance = pill
    function object:Set(text) label.Text = text end
    function object:SetVisible(state)
        object._wanted = state and true or false
        pill.Visible = object._wanted and not Library._hidden
    end
    function object:Destroy()
        if fpsConn then fpsConn:Disconnect() end
        pill:Destroy()
        Library._statusObj = nil
    end
    object._wanted = true

    Library._statusObj = object
    Library._statusSync = function()
        pill.Visible = object._wanted and not Library._hidden
    end
    return object
end

