    end
end

function Library:SetCornerScale(scale)
    Library._cornerScale = scale or 1
end

function Library:SetAnimationSpeed(mult)
    Library._animSpeed = mult or 1
end

function Library:EnableBlur(enabled)
    Library._blurEnabled = enabled
    if enabled then
        if not Library._activeBlur then
            local blur = Instance.new("BlurEffect")
            blur.Size = 0
            blur.Parent = Lighting
            Library._activeBlur = blur
            tween(blur, 0.3, { Size = 12 })
        end
    else
        if Library._activeBlur then
            local b = Library._activeBlur
            Library._activeBlur = nil
            tween(b, 0.3, { Size = 0 })
            task.delay(0.32, function() if b then b:Destroy() end end)
        end
    end
end

function Library:Unload()
    if Library.Unloaded then return end
    Library.Unloaded = true
    Library:EnableBlur(false)
    for _, conn in ipairs(Library.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Library.Connections)
    if ScreenGui then ScreenGui:Destroy() end
end

function Library:SetVisible(state)
    Library._hidden = not state
    for _, w in ipairs(Library.Windows) do
        if w.Root then w.Root.Visible = state end
    end
    if not state and Library._openPopup then
        Library._openPopup()
    end
end

function Library:ToggleVisible()
