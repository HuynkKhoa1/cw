function Library:Notify(a, b, c)
    local opts = type(a) == "table" and a or { Title = a, Content = b, Duration = c }
    local title    = tostring(opts.Title or "Notification")
    local content  = tostring(opts.Content or "")
    local duration = tonumber(opts.Duration) or 5

    local textH = 0
    if #content > 0 then
        local ok, sz = pcall(function()
            return TextService:GetTextSize(content, 12, Enum.Font.Gotham, Vector2.new(250, 1000))
        end)
        textH = (ok and sz) and sz.Y or 14
    end
    local cardH = 30 + (textH > 0 and textH + 8 or 4)

    local holder = Create("Frame", {
        BackgroundTransparency = 1,
        ClipsDescendants       = true,
        Size                   = UDim2.new(1, 0, 0, cardH),
        LayoutOrder            = NextOrder(Library.NotifyHolder),
        Parent                 = Library.NotifyHolder,
    })

    local card = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Topbar,
        Position         = UDim2.new(1, 10, 0, 0),
        Size             = UDim2.new(1, 0, 1, 0),
        Parent           = holder,
    }), { BackgroundColor3 = "Topbar" })
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = card })
    Themed(Create("UIStroke", { Thickness = 1, Parent = card }), { Color = "Outline" })

    Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Accent,
        Position         = UDim2.new(0, 0, 0, 6),
        Size             = UDim2.new(0, 3, 1, -12),
        Parent           = card,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    }), { BackgroundColor3 = "Accent" })

    Themed(Create("TextLabel", {
        BackgroundTransparency = 1,
        Position       = UDim2.new(0, 12, 0, 6),
        Size           = UDim2.new(1, -24, 0, 16),
        Font           = Enum.Font.GothamBold,
        Text           = title,
        TextSize       = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate   = Enum.TextTruncate.AtEnd,
        Parent         = card,
    }), { TextColor3 = "Text" })

    if #content > 0 then
        Themed(Create("TextLabel", {
            BackgroundTransparency = 1,
            Position       = UDim2.new(0, 12, 0, 24),
            Size           = UDim2.new(1, -22, 0, textH),
            Font           = Enum.Font.Gotham,
            Text           = content,
            TextSize       = 12,
            TextWrapped    = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            Parent         = card,
        }), { TextColor3 = "SubText" })
    end

    local progress = Themed(Create("Frame", {
        BackgroundColor3 = Library.Theme.Accent,
        Position         = UDim2.new(0, 0, 1, -2),
        Size             = UDim2.new(1, 0, 0, 2),
        Parent           = card,
    }), { BackgroundColor3 = "Accent" })

    local dismissed = false
    local function Dismiss()
        if dismissed then return end
        dismissed = true
        Tween(card, { Position = UDim2.new(1, 10, 0, 0) }, 0.25)
        task.delay(0.28, function()
            pcall(function() holder:Destroy() end)
        end)
    end

    local clickArea = Create("TextButton", {
        BackgroundTransparency = 1,
        Text   = "",
        Size   = UDim2.new(1, 0, 1, 0),
        Parent = card,
    })
    clickArea.MouseButton1Click:Connect(Dismiss)

    Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.25)
    Tween(progress, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, Dismiss)
end

--========================================================--
--  Theme switching
--========================================================--

function Library:SetTheme(theme)
    local name = "Custom"
    if type(theme) == "string" then
        name = theme
        theme = Library.Themes[theme]
    end
    if type(theme) ~= "table" then return false end

    local merged = {}
    for k, v in pairs(Library.Themes.Dark) do
        merged[k] = theme[k] or v
    end
    Library.Theme = merged
    Library.CurrentThemeName = name

    for obj, props in pairs(ThemeMap) do
        for prop, key in pairs(props) do
            pcall(function() obj[prop] = merged[key] end)
        end
    end
    for _, fn in ipairs(Library._themeCallbacks) do
        pcall(fn)
    end
    return true
end

--========================================================--
--  Config system
--========================================================--

local function EnsureConfigFolders()
    if not (isfolder and makefolder) then return false end
    local ok = pcall(function()
        if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
        local cfg = Library.ConfigFolder .. "/configs"
        if not isfolder(cfg) then makefolder(cfg) end
    end)
    return ok
end

function Library:SaveConfig(name)
    if type(name) ~= "string" or name == "" then return false, "invalid name" end
    if not writefile then return false, "executor lacks file API" end
    EnsureConfigFolders()

    local data = {}
    for flag, option in pairs(Library.Options) do
        if not option.IgnoreConfig and option.GetSaveValue then
            local ok, value = pcall(option.GetSaveValue, option)
            if ok then
                data[flag] = { Type = option.Type, Value = value }
            end
        end
    end

    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false, "encode failed" end

    local ok2, err = pcall(writefile, Library.ConfigFolder .. "/configs/" .. name .. ".json", encoded)
    if not ok2 then return false, tostring(err) end
    return true
end

function Library:LoadConfig(name)
    if not (readfile and isfile) then return false, "executor lacks file API" end
    local path = Library.ConfigFolder .. "/configs/" .. tostring(name) .. ".json"
    if not isfile(path) then return false, "config not found" end

    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false, "decode failed" end

    for flag, entry in pairs(data) do
        local option = Library.Options[flag]
        if option and option.LoadSaveValue and type(entry) == "table" then
            pcall(option.LoadSaveValue, option, entry.Value)
        end
    end
    return true
end

function Library:GetConfigs()
    local out = {}
    if not (listfiles and isfolder) then return out end
    EnsureConfigFolders()
    local ok, files = pcall(listfiles, Library.ConfigFolder .. "/configs")
    if ok and type(files) == "table" then
        for _, f in ipairs(files) do
            local n = tostring(f):match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end
    table.sort(out)
    return out
end

function Library:DeleteConfig(name)
    if not (delfile and isfile) then return false end
    local path = Library.ConfigFolder .. "/configs/" .. tostring(name) .. ".json"
    if isfile(path) then
        pcall(delfile, path)
        return true
    end
    return false
end

function Library:GetAutoload()
    if not (isfile and readfile) then return nil end
    local p = Library.ConfigFolder .. "/autoload.txt"
    local ok, content = pcall(function()
        if isfile(p) then return readfile(p) end
        return nil
    end)
    if ok and content and #content > 0 then return content end
    return nil
end

function Library:SetAutoload(name)
    if not writefile then return false end
    EnsureConfigFolders()
    pcall(writefile, Library.ConfigFolder .. "/autoload.txt", name or "")
    return true
end

function Library:LoadAutoloadConfig()
    local name = Library:GetAutoload()
    if name then
        local ok = Library:LoadConfig(name)
        if ok then
            Library:Notify("Config", "Autoloaded '" .. name .. "'", 4)
        end
    end
end

--========================================================--
--  Drag / resize
--========================================================--

local function MakeDraggable(handle, target, excludes)
    local dragging = false
    local dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        for _, ex in ipairs(excludes or {}) do
            if PointIn(ex) then return end
        end
        dragging = true
        dragStart = input.Position
        startPos = target.Position
    end)

    table.insert(Library.Connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = input.Position - dragStart
        target.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end))

    table.insert(Library.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

local function MakeResizable(grip, target, minSize, window)
    local resizing = false
    local startMouse, startSize

    grip.InputBegan:Connect(function(input)
        if window.Minimized then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        resizing = true
        startMouse = input.Position
        startSize = target.AbsoluteSize
    end)

    table.insert(Library.Connections, UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = input.Position - startMouse
        target.Size = UDim2.fromOffset(
            math.max(minSize.X, startSize.X + delta.X),
            math.max(minSize.Y, startSize.Y + delta.Y)
        )
    end))

    table.insert(Library.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if resizing then
                resizing = false
                window.FullSize = target.Size
            end
        end
    end))
end

