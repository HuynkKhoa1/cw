    Library.NotifPosition = pos
    if pos == "TopRight" then
        NotifHolder.AnchorPoint = Vector2.new(1, 0)
        NotifHolder.Position = UDim2.new(1, -16, 0, 16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    elseif pos == "TopLeft" then
        NotifHolder.AnchorPoint = Vector2.new(0, 0)
        NotifHolder.Position = UDim2.new(0, 16, 0, 16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        notifLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    elseif pos == "BottomRight" then
        NotifHolder.AnchorPoint = Vector2.new(1, 1)
        NotifHolder.Position = UDim2.new(1, -16, 1, -16)
        notifLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
