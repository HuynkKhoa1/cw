    bindTheme(keyBtn, function(t) return { BackgroundColor3 = t.Inset, TextColor3 = t.Text } end)
    bindTheme(keyStroke, function(t) return { Color = t.Stroke } end)

    local object = {}
    local listening = false

    function object:Set(v)
        key = v
        keyBtn.Text = key and keyName(key) or "None"
        if flag then Library.Flags[flag] = key end
    end
    function object:Get() return key end

    track(keyBtn.MouseButton1Click:Connect(function()
        listening = true
        Library._bindingActive = true
        keyBtn.Text = "..."
        tween(keyStroke, 0.18, { Color = accentColor(), Transparency = 0.2 })
    end))

    track(UserInputService.InputBegan:Connect(function(input, gpe)
        if listening then
            local v
            if input.UserInputType == Enum.UserInputType.Keyboard then
                v = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2 then
                v = input.UserInputType
            end
            if v then
                if v == Enum.KeyCode.Backspace then object:Set(nil) else object:Set(v) end
                listening = false
                tween(keyStroke, 0.18, { Color = Library.Theme.Stroke, Transparency = 0.86 })
                task.defer(function() Library._bindingActive = false end)
            end
            return
        end
        if gpe then return end
        if key == nil then return end
        local match = (input.KeyCode == key) or (input.UserInputType == key)
        if match then
            if mode == "Hold" then
                held = true
                if opts.Callback then task.spawn(opts.Callback, true) end
            else
                if opts.Callback then task.spawn(opts.Callback) end
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if mode == "Hold" and held and key then
            local match = (input.KeyCode == key) or (input.UserInputType == key)
            if match then
                held = false
                if opts.Callback then task.spawn(opts.Callback, false) end
            end
        end
    end))

    if flag then
        Library.Flags[flag] = key
        Library.Options[flag] = object
    end
    return object
end

