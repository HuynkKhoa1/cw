local function makeDraggable(handle, target)
    local dragging, dragStart, startPos
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Library:CreateWindow(opts)
    opts = opts or {}
    local windowObj = { Tabs = {} }

    local size = opts.Size or UDim2.new(0, 560, 0, 400)
    local offset = #Library.Windows * 30

    local root = new("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, offset, 0.5, offset),
        Size = size,
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        Visible = not Library._hidden,
        Parent = ScreenGui,
    })
    corner(root, 10)
    local rootStroke = stroke(root, Library.Theme.Outline, 1)
    bindTheme(root, function(t) return { BackgroundColor3 = t.Background } end)
    bindTheme(rootStroke, function(t) return { Color = t.Outline } end)
    windowObj.Root = root

    -- Topbar
    local topbar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Library.Theme.Topbar,
        BorderSizePixel = 0,
        Parent = root,
    })
    corner(topbar, 10)
    new("Frame", {  -- mask bottom rounded corners of topbar
        Position = UDim2.new(0, 0, 1, -10),
        Size = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = Library.Theme.Topbar,
        BorderSizePixel = 0,
        Parent = topbar,
    })
    bindTheme(topbar, function(t) return { BackgroundColor3 = t.Topbar } end)
    for _, c in ipairs(topbar:GetChildren()) do
        if c:IsA("Frame") then
            bindTheme(c, function(t) return { BackgroundColor3 = t.Topbar } end)
        end
    end
    makeDraggable(topbar, root)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0),
        Size = UDim2.new(0.6, 0, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = opts.Title or "KoaUI",
        TextColor3 = Library.Theme.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topbar,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if opts.SubTitle then
        local subLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16 + titleLabel.TextBounds.X + 8, 0, 0),
            Size = UDim2.new(0, 120, 1, 0),
            Font = Enum.Font.Gotham,
            Text = opts.SubTitle,
            TextColor3 = Library.Theme.SubText,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = topbar,
        })
        bindTheme(subLabel, function(t) return { TextColor3 = t.SubText } end)
    end

    -- Topbar buttons (minimize + close)
    local function makeTopBtn(symbol, xOff, callback)
        local b = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, xOff, 0.5, 0),
            Size = UDim2.new(0, 24, 0, 24),
            BackgroundColor3 = Library.Theme.Element,
            Font = Enum.Font.GothamBold,
            Text = symbol,
            TextColor3 = Library.Theme.SubText,
            TextSize = 14,
            AutoButtonColor = false,
            Parent = topbar,
        })
        corner(b, 6)
        bindTheme(b, function(t) return { BackgroundColor3 = t.Element, TextColor3 = t.SubText } end)
        track(b.MouseEnter:Connect(function()
            tween(b, 0.15, { BackgroundColor3 = Library.Theme.ElementHover })
        end))
        track(b.MouseLeave:Connect(function()
            tween(b, 0.15, { BackgroundColor3 = Library.Theme.Element })
        end))
        track(b.MouseButton1Click:Connect(callback))
        return b
    end

    local body = new("Frame", {
        Position = UDim2.new(0, 0, 0, 42),
        Size = UDim2.new(1, 0, 1, -42),
        BackgroundTransparency = 1,
        Parent = root,
    })

    -- Sidebar (tab list)
    local sidebar = new("Frame", {
        Size = UDim2.new(0, 150, 1, 0),
        BackgroundColor3 = Library.Theme.Sidebar,
        BorderSizePixel = 0,
        Parent = body,
    })
    bindTheme(sidebar, function(t) return { BackgroundColor3 = t.Sidebar } end)

    local tabList = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    })
    new("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
        Parent = tabList,
    })
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = tabList,
    })

    -- Content container
    local content = new("Frame", {
        Position = UDim2.new(0, 150, 0, 0),
        Size = UDim2.new(1, -150, 1, 0),
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        Parent = body,
    })
    bindTheme(content, function(t) return { BackgroundColor3 = t.Background } end)

    local minimized = false
    makeTopBtn("✕", -8, function()
        windowObj:Destroy()
    end)
    makeTopBtn("—", -38, function()
        minimized = not minimized
        if minimized then
            body.Visible = false
            tween(root, 0.2, { Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 42) })
        else
            tween(root, 0.2, { Size = size })
            task.delay(0.2, function() body.Visible = true end)
        end
    end)

    -- Tab activation
    windowObj._tabButtons = {}
    windowObj._tabPages = {}

    local function activate(name)
        for n, page in pairs(windowObj._tabPages) do
            page.Visible = (n == name)
        end
        for n, btn in pairs(windowObj._tabButtons) do
            local on = (n == name)
            tween(btn.Frame, 0.15, {
                BackgroundColor3 = on and Library.Theme.Element or Library.Theme.Sidebar,
            })
            btn.Label.TextColor3 = on and Library.Theme.Text or Library.Theme.SubText
            btn.Indicator.BackgroundTransparency = on and 0 or 1
        end
        windowObj.ActiveTab = name
    end

    function windowObj:CreateTab(tabOpts)
        tabOpts = tabOpts or {}
        local name = tabOpts.Title or ("Tab " .. (#windowObj.Tabs + 1))

        local tabBtn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = Library.Theme.Sidebar,
            Text = "",
            AutoButtonColor = false,
            Parent = tabList,
        })
        corner(tabBtn, 6)
        bindTheme(tabBtn, function(t)
            if windowObj.ActiveTab == name then
                return { BackgroundColor3 = t.Element }
            end
            return { BackgroundColor3 = t.Sidebar }
        end)

        local indicator = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 3, 0.6, 0),
            BackgroundColor3 = Library.Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = tabBtn,
        })
        corner(indicator, 2)
        bindTheme(indicator, function(t) return { BackgroundColor3 = t.Accent } end)

        local tabLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 0),
            Size = UDim2.new(1, -16, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = (tabOpts.Icon and (tabOpts.Icon .. "  ") or "") .. name,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = tabBtn,
        })

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.Theme.Outline,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            Parent = content,
        })
        new("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            Parent = page,
        })
        new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            Parent = page,
        })

        windowObj._tabButtons[name] = { Frame = tabBtn, Label = tabLabel, Indicator = indicator }
        windowObj._tabPages[name] = page

        track(tabBtn.MouseButton1Click:Connect(function()
            activate(name)
        end))

        local tabObj = setmetatable({ Page = page, Window = windowObj, Name = name }, { __index = Elements })
        table.insert(windowObj.Tabs, tabObj)

        if #windowObj.Tabs == 1 then
            activate(name)
        end

        return tabObj
    end

    function windowObj:Destroy()
        for i, w in ipairs(Library.Windows) do
            if w == windowObj then table.remove(Library.Windows, i) break end
        end
        root:Destroy()
    end

    function windowObj:Select(name)
        if windowObj._tabPages[name] then activate(name) end
    end

    table.insert(Library.Windows, windowObj)
    return windowObj
end

--========================================================--
--  Built-in Settings tab
--========================================================--

function Library:CreateSettingsTab(window, configName)
    configName = configName or "default"
    local tab = window:CreateTab({ Title = "Settings", Icon = "⚙" })

    tab:Section({ Title = "Appearance" })

    local themeNames = {}
    for name in pairs(Library.Themes) do table.insert(themeNames, name) end
    table.sort(themeNames)

    tab:Dropdown({
        Title = "Theme",
        Values = themeNames,
        Default = Library.CurrentThemeName,
        Callback = function(v)
            Library:SetTheme(v)
        end,
    })

    tab:Section({ Title = "Interface" })

    tab:Keybind({
        Title = "Toggle UI Key",
        Default = Library.ToggleKey,
        Callback = function()
            Library:ToggleVisible()
        end,
    })

    tab:Section({ Title = "Configuration" })

    local nameInput = tab:Input({
        Title = "Config Name",
        Default = configName,
        Placeholder = "config name",
    })

    tab:Button({
        Title = "Save Config",
        Callback = function()
            Library:SaveConfig(nameInput:Get())
        end,
    })
    tab:Button({
        Title = "Load Config",
        Callback = function()
            Library:LoadConfig(nameInput:Get())
        end,
    })

    tab:Section({ Title = "Danger" })
    tab:Button({
        Title = "Unload UI",
        Callback = function()
            Library:Unload()
        end,
    })

    return tab
end

--========================================================--
--  Global toggle key listener
--========================================================--

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if Library._bindingActive then return end
    if gpe then return end
    if input.KeyCode == Library.ToggleKey then
        Library:ToggleVisible()
    end
end))

return Library
