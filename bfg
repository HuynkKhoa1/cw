            CanvasSize = UDim2.new(0, 0, 0, 0),
            LayoutOrder = 2,
            ZIndex = 606,
            Parent = inner,
        })
        listLayout = vlist(listContainer, 4)

        -- T3.12: empty dropdown shows a tidy non-interactive "No options" row
        if #values == 0 then
            local emptyRow = new("Frame", {
                BackgroundColor3 = Library.Theme.Inset,
                Size = UDim2.new(1, 0, 0, 30),
                BorderSizePixel = 0,
                ZIndex = 607,
                Parent = listContainer,
