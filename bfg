Builders.Input = function(container, opts)
    local Input = {
        Type = "Input",
        Value = opts.Default ~= nil and opts.Default or "",
        Callback = opts.Callback,
        Flag = opts.Flag,
        IgnoreConfig = opts.IgnoreConfig,
        _changed = opts.OnChanged,
    }
    local base = BaseElement(container, opts, 38, 175)
    Input.Frame = base.Frame
    Input._conns = base.Conns

    local box = Themed(Create("TextBox", {
        AnchorPoint      = Vector2.new(1, 0.5),
        Position         = UDim2.new(1, -12, 0, base.Height / 2),
        Size             = UDim2.new(0, 150, 0, 24),
        BackgroundColor3 = Library.Theme.Background,
        Font             = Enum.Font.Gotham,
        Text             = tostring(Input.Value),
        PlaceholderText  = tostring(opts.Placeholder or ""),
        TextSize         = 12,
        ClearTextOnFocus = false,
        Parent           = base.Frame,
    }, {
        Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
    }), { BackgroundColor3 = "Background", TextColor3 = "Text", PlaceholderColor3 = "SubText" })
    Themed(Create("UIStroke", { Thickness = 1, Parent = box }), { Color = "Outline" })

    function Input:Set(v)
        if opts.Numeric then
            v = tonumber(v)
            if v == nil then
                box.Text = tostring(Input.Value)
                return
            end
        else
            v = tostring(v)
        end
        local changed = v ~= Input.Value
        Input.Value = v
        box.Text = tostring(v)
        if Input.Flag then Library.Flags[Input.Flag] = v end
        if changed then
            SafeCall(Input.Callback, v)
            SafeCall(Input._changed, v)
        end
    end

    Track(base.Conns, box.FocusLost:Connect(function(enterPressed)
        if opts.Finished and not enterPressed then
            box.Text = tostring(Input.Value)
            return
        end
        Input:Set(box.Text)
    end))

    function Input:OnChanged(fn) Input._changed = fn end
    function Input:GetSaveValue() return Input.Value end
    function Input:LoadSaveValue(v)
        if v ~= nil then Input:Set(v) end
    end
    Input.Destroy = ElementDestroy

    RegisterOption(Input, Input.Value)
    return Input
end

