function Elements:Keybind(opts)
    opts = opts or {}
    local flag = opts.Flag
    local mode = opts.Mode or "Toggle"
    local key = opts.Default
    local held = false

    local frame = makeElementBase(self.Page, 40)
    makeTitle(frame, opts.Title or "Keybind", 114)

    local keyBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 92, 0, 26),
        BackgroundColor3 = Library.Theme.Glass,
        BackgroundTransparency = 0.3,
        Font = Enum.Font.GothamMedium,
        Text = key and keyName(key) or "None",
        TextColor3 = Library.Theme.Text,
        TextSize = 13,
        AutoButtonColor = false,
        ZIndex = 2,
        Parent = frame,
    })
    corner(keyBtn, 8)
    local keyStroke = hairline(keyBtn, 0.85)
    bindTheme(keyBtn, function(t) return { BackgroundColor3 = t.Glass, TextColor3 = t.Text } end)
    bindTheme(keyStroke, function(t) return { Color = t.Outline } end)

    local object = {}
    local listening = false

    function object:Set(v)
        key = v
        keyBtn.Text = key and keyName(key) or "None"
        if flag then Library.Flags[flag] = key end
    end
    function object:Get() return key end

    track(keyBtn.MouseButton1Click:Connect(function()
        listening = true
        Library._bindingActive = true
        keyBtn.Text = "..."
        tween(keyStroke, 0.2, { Color = Library.Theme.Accent, Transparency = 0.2 })
    end))

    track(UserInputService.InputBegan:Connect(function(input, gpe)
        if listening then
            local v
            if input.UserInputType == Enum.UserInputType.Keyboard then
                v = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2 then
                v = input.UserInputType
            end
            if v then
                if v == Enum.KeyCode.Backspace then
                    object:Set(nil)
                else
                    object:Set(v)
                end
                listening = false
                tween(keyStroke, 0.2, { Color = Library.Theme.Outline, Transparency = 0.85 })
                task.defer(function() Library._bindingActive = false end)
            end
            return
        end
        if gpe then return end
        if key == nil then return end
        local match = (input.KeyCode == key) or (input.UserInputType == key)
        if match then
            if mode == "Hold" then
                held = true
                if opts.Callback then task.spawn(opts.Callback, true) end
            else
                if opts.Callback then task.spawn(opts.Callback) end
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if mode == "Hold" and held and key then
            local match = (input.KeyCode == key) or (input.UserInputType == key)
            if match then
                held = false
                if opts.Callback then task.spawn(opts.Callback, false) end
            end
        end
    end))

    if flag then
        Library.Flags[flag] = key
        Library.Options[flag] = object
    end
    return object
end

