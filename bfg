        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 802,
        Parent = card,
    })
    padding(holder, 12, 14, 0, 0)
    vlist(holder, 4)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Library._fontBold,
        Text = title,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        ZIndex = 802,
        Parent = holder,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if content ~= "" then
        local contentLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Library._font,
            Text = content,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            ZIndex = 802,
            Parent = holder,
        })
        bindTheme(contentLabel, function(t) return { TextColor3 = t.SubText } end)
    end

    local progress
    if duration > 0 then
        progress = new("Frame", {
            BackgroundColor3 = accent,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 2),
            BorderSizePixel = 0,
            BackgroundTransparency = 0.3,
            ZIndex = 803,
            Parent = card,
        })
    end

    local function resize()
        card.Size = UDim2.new(1, 0, 0, holder.AbsoluteSize.Y)
    end
    local resizeConn = holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    task.defer(resize)

    card.Position = UDim2.new(1, 20, 0, 0)
    tween(card, 0.3, { BackgroundTransparency = 0 })
    tween(cardStroke, 0.3, { Transparency = 0.85 })

    if progress then
        tween(progress, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
    end

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        if resizeConn then resizeConn:Disconnect() end
        tween(card, 0.25, { BackgroundTransparency = 1 })
        tween(cardStroke, 0.25, { Transparency = 1 })
        tween(card, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
        task.delay(0.28, function() if card then card:Destroy() end end)
    end

    local clickBtn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 804,
        Parent = card,
    })
    track(clickBtn.MouseButton1Click:Connect(function()
        dismiss()
        if opts.Callback then task.spawn(opts.Callback) end
    end))

    if duration > 0 then
        task.delay(duration, dismiss)
    end

    return { Dismiss = dismiss }
end

