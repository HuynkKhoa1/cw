--========================================================--
--  Utilities
--========================================================--

local function Create(class, props, children)
    local obj = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then obj[k] = v end
        end
    end
    if children then
        for _, child in ipairs(children) do child.Parent = obj end
    end
    if props and props.Parent then obj.Parent = props.Parent end
    return obj
end

local ThemeMap = setmetatable({}, { __mode = "k" })

local function Themed(obj, props)
    ThemeMap[obj] = props
    for prop, key in pairs(props) do
        obj[prop] = Library.Theme[key]
    end
    return obj
end

local function Tween(obj, props, time, style)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function SafeCall(fn, ...)
    if not fn then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[NebulaUI] Callback error: " .. tostring(err))
    end
end

local function Track(conns, conn)
    table.insert(conns, conn)
    table.insert(Library.Connections, conn)
    return conn
end

local OrderCounters = setmetatable({}, { __mode = "k" })
local function NextOrder(container)
    local n = (OrderCounters[container] or 0) + 1
    OrderCounters[container] = n
    return n
end

local function Round(v, inc)
    if not inc or inc <= 0 then return v end
    return math.floor(v / inc + 0.5) * inc
end

local function CountDecimals(n)
    local s = tostring(n)
    local d = s:match("%.(%d+)")
    if d then return math.min(#d, 4) end
    return 0
end

local function ColorToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function HexToColor(hex)
    hex = tostring(hex):gsub("#", "")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r, g, b)
end

local function ResolveKey(v)
    if v == nil then return nil end
    if typeof(v) == "EnumItem" then
        if v.EnumType == Enum.KeyCode or v.EnumType == Enum.UserInputType then
            return v
        end
        return nil
    end
    if type(v) == "string" then
        local ok, item = pcall(function() return Enum.KeyCode[v] end)
        if ok and item then return item end
        local ok2, item2 = pcall(function() return Enum.UserInputType[v] end)
        if ok2 and item2 then return item2 end
    end
    return nil
end

local MouseNames = {
    [Enum.UserInputType.MouseButton1] = "MB1",
    [Enum.UserInputType.MouseButton2] = "MB2",
    [Enum.UserInputType.MouseButton3] = "MB3",
}
local PrettyKeys = {
    LeftControl = "LCtrl", RightControl = "RCtrl",
    LeftShift = "LShift",  RightShift = "RShift",
    LeftAlt = "LAlt",      RightAlt = "RAlt",
}

local function KeyDisplay(key)
    if not key then return "None" end
    if key.EnumType == Enum.UserInputType then
        return MouseNames[key] or key.Name
    end
    return PrettyKeys[key.Name] or key.Name
end

local function InputMatches(input, key)
    if not key then return false end
    if key.EnumType == Enum.KeyCode then
        return input.KeyCode == key
    end
    return input.UserInputType == key
end

local function PointIn(gui)
    local p = UserInputService:GetMouseLocation()
    local ap, asz = gui.AbsolutePosition, gui.AbsoluteSize
    return p.X >= ap.X and p.X <= ap.X + asz.X
       and p.Y >= ap.Y and p.Y <= ap.Y + asz.Y
end

local function RelativeMouse(frame)
    local p = UserInputService:GetMouseLocation()
    local relX = (p.X - frame.AbsolutePosition.X) / math.max(frame.AbsoluteSize.X, 1)
    local relY = (p.Y - frame.AbsolutePosition.Y) / math.max(frame.AbsoluteSize.Y, 1)
    return math.clamp(relX, 0, 1), math.clamp(relY, 0, 1)
end

