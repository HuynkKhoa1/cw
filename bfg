-- silent unless Library.Debug; used by VERIFY-EMPIRICALLY probes (T0.1)
local function dprint(...)
    if Library.Debug then print(...) end
end
Library._dprint = dprint

local _flagStore = {}
Library._flagStore = _flagStore

local function queueSave()
    if not Library._autoSaveEnabled then return end
    Library._saveToken = (Library._saveToken or 0) + 1
    local token = Library._saveToken
    task.delay(0.6, function()
        if token == Library._saveToken and Library._autoSaveEnabled then
            Library:SaveConfig(Library._autoSaveName, true)
        end
    end)
end
Library._queueSave = queueSave

-- T1.7: if a config was loaded before this element was built, adopt the stored
-- value instead of the declared default (type-checked). Prevents constructors
-- from clobbering loaded values with their Default.
local function adoptFlag(flag, default, expectedType)
    if flag == nil then return default end
    local stored = _flagStore[flag]
    if stored == nil then return default end
    if expectedType == "boolean" and typeof(stored) ~= "boolean" then return default end
    if expectedType == "number"  and typeof(stored) ~= "number"  then return default end
    if expectedType == "string"  and typeof(stored) ~= "string"  then return default end
    if expectedType == "table"   and typeof(stored) ~= "table"   then return default end
    if expectedType == "Color3"  and typeof(stored) ~= "Color3"  then return default end
    return stored
end

-- write an initial flag value WITHOUT triggering queueSave (avoids autosave
-- storms that rewrite the file with half-built state while the UI is building).
local function seedFlag(flag, value)
    if flag ~= nil then _flagStore[flag] = value end
end

Library.Flags = setmetatable({}, {
    __index = function(_, k) return _flagStore[k] end,
    __newindex = function(_, k, v) _flagStore[k] = v; queueSave() end,
})

local function buildTheme(d)
    local function dim(c, f) return c:Lerp(Color3.new(0, 0, 0), f or 0.4) end
    return {
        Name             = d.Name,
        Accent           = d.Accent,
        AccentText       = d.AccentText or Color3.fromRGB(255, 255, 255),
        AcrylicMain      = d.AcrylicMain,
        AcrylicBorder    = d.AcrylicBorder,
        AcrylicGradient  = d.AcrylicGradient,
        AcrylicNoise     = d.AcrylicNoise or 0.92,
        ElementTransparency = d.ElementTransparency or 0.86,
        Background       = d.AcrylicMain,
        Topbar           = d.AcrylicMain,
        Sidebar          = d.AcrylicMain,
        Surface          = d.Element,
        SurfaceHi        = d.Hover or d.Element,
        Inset            = d.DropdownHolder or dim(d.AcrylicMain, 0.2),
        Stroke           = d.AcrylicBorder,
        Text             = d.Text,
        SubText          = d.SubText,
        Disabled         = d.ElementBorder or d.AcrylicBorder,
        Success          = d.Success or Color3.fromRGB(86, 196, 134),
        Warning          = d.Warning or Color3.fromRGB(232, 178, 78),
        Error            = d.Error or Color3.fromRGB(226, 96, 96),
        Info             = d.Info or d.Accent,
        Hover            = d.Hover or d.Element,
    }
end

