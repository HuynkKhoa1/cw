            corner(emptyRow, 8)
            new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Font = Library._font,
                Text = "No options",
                TextColor3 = Library.Theme.SubText,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = 608,
                Parent = emptyRow,
            })
        end

        for _, v in ipairs(values) do
            local optFrame = new("Frame", {
                BackgroundColor3 = Library.Theme.Inset,
                Size = UDim2.new(1, 0, 0, 30),
                BorderSizePixel = 0,
                ClipsDescendants = true,
                ZIndex = 607,
                Parent = listContainer,
            })
            corner(optFrame, 8)
            local optLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -38, 1, 0),
                Font = Library._font,
                Text = tostring(v),
                TextColor3 = Library.Theme.SubText,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 608,
                Parent = optFrame,
            })
            local tick = new("ImageLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14),
                Image = Library.Icons.check,
                ImageTransparency = 1,
                ZIndex = 608,
                Parent = optFrame,
            })
            local optBtn = new("TextButton", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Text = "",
                ZIndex = 609,
                Parent = optFrame,
            })
            optionButtons[v] = { frame = optFrame, label = optLabel, tick = tick }
            track(optBtn.MouseEnter:Connect(function()
                local on = multi and selected[v] or (selected == v)
                if not on then tween(optFrame, 0.12, { BackgroundColor3 = Library.Theme.Hover }) end
            end))
            track(optBtn.MouseLeave:Connect(function()
                local on = multi and selected[v] or (selected == v)
                if not on then tween(optFrame, 0.12, { BackgroundColor3 = Library.Theme.Inset }) end
            end))
            track(optBtn.MouseButton1Click:Connect(function()
                if multi then
                    selected[v] = (not selected[v]) or nil
                    local arr = {}
                    for _, val in ipairs(values) do
                        if selected[val] then table.insert(arr, val) end
                    end
                    object:Set(arr)
                else
                    object:Set(v)
                    object:Close()
                end
            end))
        end

        if searchBox then
            track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local q = searchBox.Text:lower()
                for v, b in pairs(optionButtons) do
                    b.frame.Visible = q == "" or tostring(v):lower():find(q, 1, true) ~= nil
                end
                -- T2.9: defer so the layout engine applies the Visible changes
                -- before _Reposition reads AbsoluteContentSize (was off by one keystroke)
                task.defer(function() if open then object:_Reposition() end end)
            end))
        end

        refreshHighlights()
    end

    local animating = false
    function object:_TotalHeight()
        local contentH = listLayout and listLayout.AbsoluteContentSize.Y or 0
        -- AbsoluteContentSize is 0 on the frame the popup is built, which makes
        -- the popup open too short and clips the last option. Estimate height
        -- from the visible option rows so every item (incl. the last) is clickable.
        if contentH <= 0 then
            local rows = 0
            for _, b in pairs(optionButtons) do
                if b.frame.Visible then rows += 1 end
            end
            contentH = rows * 30 + math.max(0, rows - 1) * 4
        end
        local listH = math.min(maxListHeight, contentH)
        if listContainer then
            listContainer.Size = UDim2.new(1, 0, 0, listH)
            listContainer.CanvasSize = UDim2.new(0, 0, 0, contentH)
        end
        local searchH = searchable and 33 or 0
        return listH + searchH + 12
    end

    -- T1.2: position via the self-calibrating abs->canvas conversion. The popup
    -- lives on PopupLayer (canvas space); AbsolutePosition is inset-excluded.
    -- Writing canvas Position straight from AbsolutePosition rendered the popup
    -- ~inset px too high (overlapping its own header). screenRectAbs() also
    -- gives the true visible rect for the flip-up decision on any topbar size.
    function object:_Reposition()
        if not popup or not open then return end
        local headerPos  = frame.AbsolutePosition
        local headerSize = frame.AbsoluteSize
        local totalH     = object:_TotalHeight()
        local origin, far = screenRectAbs()
        local screenBottom = far.Y
        local belowY  = headerPos.Y + headerSize.Y + 6          -- abs space
        local fitsBelow = (belowY + totalH) <= (screenBottom - 8)
        local finalYAbs = fitsBelow and belowY or (headerPos.Y - totalH - 6)
        local canvas  = Vector2.new(headerPos.X, finalYAbs) - origin -- abs -> canvas
        -- clamp X so the popup never overflows the screen edge (8 px margin)
        local maxX = far.X - origin.X - headerSize.X - 8
        canvas = Vector2.new(math.clamp(canvas.X, 8, math.max(8, maxX)), canvas.Y)
        if not animating then
            popup.Size = UDim2.new(0, headerSize.X, 0, totalH)
        end
        popup.Position = UDim2.fromOffset(canvas.X, canvas.Y)
    end

    local repoConn
    function object:Open()
        if open then return end
        if Library._openPopup then Library._openPopup() end
        open = true
        buildPopup()
        tween(arrow, SPEED, { Rotation = -90 })
        local sz = frame.AbsoluteSize
        local totalH = object:_TotalHeight()
        animating = true
        popup.Size = UDim2.new(0, sz.X, 0, 0)
        object:_Reposition()
        tween(popup, SPEED, { Size = UDim2.new(0, sz.X, 0, totalH) })
        task.delay(aspeed(SPEED), function() animating = false end)
        Library._openDropdown = object
        -- T1.5: store the closer per-object so a deferred close of dropdown A
        -- can't wipe dropdown B's registration after B opened in between.
        local myCloser = function() object:Close() end
        Library._openPopup = myCloser
        object._closer = myCloser
        -- reposition on layout changes only (no per-frame loop)
        repoConn = frame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            object:_Reposition()
        end)
    end

    function object:Close()
        if not open then return end
        open = false
        tween(arrow, SPEED, { Rotation = 90 })
        if repoConn then repoConn:Disconnect() repoConn = nil end
        if popup then
            tween(popup, SPEED * 0.8, { Size = UDim2.new(0, frame.AbsoluteSize.X, 0, 0) })
            local p = popup
            popup = nil
            task.delay(aspeed(SPEED), function() if p then p:Destroy() end end)
            optionButtons = {}
        end
        if Library._openDropdown == object then Library._openDropdown = nil end
        -- T1.5: only clear the global popup hook if it's still ours.
        if Library._openPopup == object._closer then Library._openPopup = nil end
    end

    function object:Toggle()
        if open then object:Close() else object:Open() end
    end

    -- T2.10: lookup so Set/Refresh reject values not in the list
    local function valueSet()
        local set = {}
        for _, val in ipairs(values) do set[val] = true end
        return set
    end

    function object:Set(v)
        local cbValue
        local known = valueSet()
        if multi then
            selected = {}
            if typeof(v) == "table" then
                for _, item in ipairs(v) do
                    if known[item] then selected[item] = true end -- T2.10: drop unknowns
                end
            end
            local arr = {}
            for _, val in ipairs(values) do
                if selected[val] then table.insert(arr, val) end
            end
            if flag then Library.Flags[flag] = arr end
            cbValue = arr
        else
            -- T2.10: single-select can't hold a value that isn't in the list
            if v ~= nil and not known[v] then
                dprint("[KoaUI] Dropdown:Set ignored unknown value", tostring(v))
                v = nil
            end
            selected = v
            if flag then Library.Flags[flag] = selected end
            cbValue = selected
        end
        if open then refreshHighlights() else valueLabel.Text = labelText() end
        if opts.Callback then task.spawn(opts.Callback, cbValue) end
    end
    function object:Get() return selected end

    function object:Refresh(newValues, keepSelection)
        values = newValues or values
        if not keepSelection then
            if multi then selected = {} else selected = nil end
        end
        if open then
            buildPopup()
            object:_Reposition()
        else
            valueLabel.Text = labelText()
        end
    end

    track(headBtn.MouseButton1Click:Connect(function() object:Toggle() end))

    object._frame = frame

    valueLabel.Text = labelText()
    if multi and opts.Default then
        object:Set(opts.Default)
    elseif not multi and opts.Default ~= nil then
        object:Set(opts.Default)
    end

    if flag then Library.Options[flag] = object end
    return object
end

