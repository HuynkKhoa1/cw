function Library:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "Notification"
    local content = opts.Content or ""
    local duration = opts.Duration or 4
    local kind = opts.Type or "Info"

    local accentColor = Library.Theme.Accent
    if kind == "Success" then accentColor = Library.Theme.Success
    elseif kind == "Warning" then accentColor = Library.Theme.Warning
    elseif kind == "Error" then accentColor = Library.Theme.Error end

    local card = new("Frame", {
        BackgroundColor3 = Library.Theme.Surface,
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 51,
        Parent = NotifHolder,
    })
    corner(card, 10)
    local cardStroke = stroke(card, 0.86)
    cardStroke.Transparency = 1
    bindTheme(card, function(t) return { BackgroundColor3 = t.Surface } end)

    local accentBar = new("Frame", {
        BackgroundColor3 = accentColor,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 3, 1, 0),
        BorderSizePixel = 0,
        ZIndex = 53,
        Parent = card,
    })

    local holder = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0),
        Size = UDim2.new(1, -30, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 52,
        Parent = card,
    })
    padding(holder, 12, 14, 0, 0)
    vlist(holder, 4)

    local titleLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        ZIndex = 52,
        Parent = holder,
    })
    bindTheme(titleLabel, function(t) return { TextColor3 = t.Text } end)

    if content ~= "" then
        local contentLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham,
            Text = content,
            TextColor3 = Library.Theme.SubText,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            ZIndex = 52,
            Parent = holder,
        })
        bindTheme(contentLabel, function(t) return { TextColor3 = t.SubText } end)
    end

    local progress = new("Frame", {
        BackgroundColor3 = accentColor,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BorderSizePixel = 0,
        BackgroundTransparency = 0.3,
        ZIndex = 53,
        Parent = card,
    })

    local function resize()
        local h = holder.AbsoluteSize.Y
        card.Size = UDim2.new(1, 0, 0, h)
    end
    local resizeConn = holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    task.defer(resize)

    card.Position = UDim2.new(1, 20, 0, 0)
    tween(card, 0.3, { BackgroundTransparency = 0 })
    tween(cardStroke, 0.3, { Transparency = 0.86 })

    tween(progress, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        if resizeConn then resizeConn:Disconnect() end
        tween(card, 0.25, { BackgroundTransparency = 1 })
        tween(cardStroke, 0.25, { Transparency = 1 })
        tween(card, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
        task.delay(0.28, function()
            if card then card:Destroy() end
        end)
    end

    local clickBtn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 54,
        Parent = card,
    })
    track(clickBtn.MouseButton1Click:Connect(dismiss))

    task.delay(duration, dismiss)

    return { Dismiss = dismiss }
end

local function ensureFolder()
    if not hasFS then return false end
    if not isfolder(Library.ConfigFolder) then
        pcall(makefolder, Library.ConfigFolder)
    end
    return true
end

function Library:SaveConfig(name)
    if not ensureFolder() then
        Library:Notify({ Title = "Config", Content = "No filesystem access.", Type = "Error" })
        return false
    end
    name = name or "default"
    local data = {}
    for flag, value in pairs(Library.Flags) do
        if typeof(value) == "Color3" then
            data[flag] = { __t = "Color3", r = value.R, g = value.G, b = value.B }
        elseif typeof(value) == "EnumItem" then
            data[flag] = { __t = "Enum", n = value.Name }
        else
            data[flag] = value
        end
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false end
    pcall(writefile, Library.ConfigFolder .. "/" .. name .. ".json", encoded)
    Library:Notify({ Title = "Config", Content = "Saved '" .. name .. "'.", Type = "Success" })
    return true
end

function Library:LoadConfig(name)
    if not hasFS then return false end
    name = name or "default"
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    if typeof(isfile) ~= "function" or not isfile(path) then
        Library:Notify({ Title = "Config", Content = "No config named '" .. name .. "'.", Type = "Warning" })
        return false
    end
    local ok, raw = pcall(readfile, path)
    if not ok then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 then return false end
    for flag, value in pairs(data) do
        local option = Library.Options[flag]
        if typeof(value) == "table" and value.__t == "Color3" then
            value = Color3.new(value.r, value.g, value.b)
        elseif typeof(value) == "table" and value.__t == "Enum" then
            value = Enum.KeyCode[value.n] or value.n
        end
        if option then option:Set(value) else Library.Flags[flag] = value end
    end
    Library:Notify({ Title = "Config", Content = "Loaded '" .. name .. "'.", Type = "Success" })
    return true
end

function Library:ListConfigs()
    local list = {}
    if not hasFS or typeof(listfiles) ~= "function" or not isfolder(Library.ConfigFolder) then
        return list
    end
    for _, file in ipairs(listfiles(Library.ConfigFolder)) do
        local fname = file:match("([^/\\]+)%.json$")
        if fname then table.insert(list, fname) end
    end
    return list
end

function Library:SetTheme(name)
    local theme = Library.Themes[name]
    if not theme then return end
    Library.Theme = theme
    Library.CurrentThemeName = name
    for _, apply in ipairs(Library._themeCallbacks) do
        pcall(apply)
    end
end

function Library:Unload()
    if Library.Unloaded then return end
    Library.Unloaded = true
    for _, conn in ipairs(Library.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Library.Connections)
    if ScreenGui then ScreenGui:Destroy() end
end

function Library:SetVisible(state)
    Library._hidden = not state
    for _, w in ipairs(Library.Windows) do
        w.Root.Visible = state
    end
end

function Library:ToggleVisible()
    Library:SetVisible(Library._hidden)
end

