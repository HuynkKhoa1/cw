            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
        }),
        Parent = hueBar,
    })
    local hueCursor = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.new(1, 4, 0, 4),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = hueBar,
    })
    corner(hueCursor, 2)

    local hexBox = new("TextBox", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 36, 0, 26),
        BackgroundColor3 = Library.Theme.Inset,
        Font = Library._font,
        Text = "FFFFFF",
        TextColor3 = Library.Theme.Text,
        TextSize = 11,
        ClearTextOnFocus = false,
        ZIndex = 3,
        Parent = panel,
    })
    corner(hexBox, 6)
    bindTheme(hexBox, function(t) return { BackgroundColor3 = t.Inset, TextColor3 = t.Text } end)

    local object = {}
    local open = false

    local function setHeight()
        tween(frame, SPEED, { Size = UDim2.new(1, 0, 0, open and 178 or 40) })
    end

    local function rebuild(skipCb)
        color = Color3.fromHSV(h, s, v)
        satMap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        preview.BackgroundColor3 = color
        satCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(0.5, 0, h, 0)
        hexBox.Text = string.format("%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5))
        if flag then Library.Flags[flag] = color end
        if opts.Callback and not skipCb then task.spawn(opts.Callback, color) end
    end

    function object:Set(c)
        color = c
        h, s, v = c:ToHSV()
        rebuild()
    end
    function object:Get() return color end

    track(hexBox.FocusLost:Connect(function()
        local hex = hexBox.Text:gsub("#", "")
        local r, g, b = hex:match("(%x%x)(%x%x)(%x%x)")
        if r and g and b then
            object:Set(Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)))
        else
            rebuild(true)
        end
    end))

    track(preview.MouseButton1Click:Connect(function()
        open = not open
        setHeight()
    end))

    local satDrag = false
    local function updateSat(input)
        local px = math.clamp((input.Position.X - satMap.AbsolutePosition.X) / satMap.AbsoluteSize.X, 0, 1)
        local py = math.clamp((input.Position.Y - satMap.AbsolutePosition.Y) / satMap.AbsoluteSize.Y, 0, 1)
        s = px
        v = 1 - py
        rebuild()
    end
    track(satMap.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            satDrag = true
            updateSat(input)
        end
    end))

    local hueDrag = false
    local function updateHue(input)
        h = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
        rebuild()
    end
    track(hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            hueDrag = true
            updateHue(input)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if satDrag then updateSat(input) end
            if hueDrag then updateHue(input) end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            satDrag = false
            hueDrag = false
        end
    end))

    if flag then
        seedFlag(flag, color) -- T1.7
        Library.Options[flag] = object
    end
    rebuild(true)
    return object
end

