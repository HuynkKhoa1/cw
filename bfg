local Elements = {}

function Elements:Button(opts)
    opts = opts or {}
    local frame = makeElementBase(self.Page, 40)
    makeTitle(frame, opts.Title or "Button")

    local btn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 3,
        Parent = frame,
    })

    local arrow = new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 20, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = "›",
        TextColor3 = Library.Theme.Accent,
        TextSize = 18,
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(arrow, function(t) return { TextColor3 = t.Accent } end)

    hoverLift(frame)
    track(btn.MouseButton1Click:Connect(function()
        tween(frame, 0.08, { BackgroundColor3 = Library.Theme.Accent }, Enum.EasingStyle.Quad)
        task.delay(0.1, function()
            tween(frame, 0.3, { BackgroundColor3 = Library.Theme.Surface })
        end)
        if opts.Callback then task.spawn(opts.Callback) end
    end))

    return frame
end

function Elements:Toggle(opts)
    opts = opts or {}
    local flag = opts.Flag
    local state = opts.Default == true
    local frame = makeElementBase(self.Page, 40)
    makeTitle(frame, opts.Title or "Toggle", 64)

    local pill = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 42, 0, 22),
        BackgroundColor3 = Library.Theme.Disabled,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(pill, 11)
    local pillGlow = makeGlow(pill, Library.Theme.Accent, 1)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = pill,
    })
    corner(knob, 8)

    local btn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 4,
        Parent = frame,
    })

    local object = {}

    local function visual()
        if state then
            tween(pill, 0.3, { BackgroundColor3 = Library.Theme.Accent })
            tween(knob, 0.3, { Position = UDim2.new(1, -19, 0.5, 0) })
            tween(pillGlow, 0.3, { ImageTransparency = 0.4 })
        else
            tween(pill, 0.3, { BackgroundColor3 = Library.Theme.Disabled })
            tween(knob, 0.3, { Position = UDim2.new(0, 3, 0.5, 0) })
            tween(pillGlow, 0.3, { ImageTransparency = 1 })
        end
    end

    function object:Set(v)
        state = v == true
        if flag then Library.Flags[flag] = state end
        pillGlow.ImageColor3 = Library.Theme.Accent
        visual()
        if opts.Callback then task.spawn(opts.Callback, state) end
    end
    function object:Get() return state end

    hoverLift(frame)
    track(btn.MouseButton1Click:Connect(function()
        object:Set(not state)
    end))

    if flag then
        Library.Flags[flag] = state
        Library.Options[flag] = object
    end
    object:Set(state)
    return object
end

function Elements:Slider(opts)
    opts = opts or {}
    local flag = opts.Flag
    local min = opts.Min or 0
    local max = opts.Max or 100
    local decimals = opts.Decimals or 0
    local value = math.clamp(opts.Default or min, min, max)
    local suffix = opts.Suffix or ""

    local frame = makeElementBase(self.Page, 54)
    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 9),
        Size = UDim2.new(1, -76, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = opts.Title or "Slider",
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(title, function(t) return { TextColor3 = t.Text } end)

    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, 9),
        Size = UDim2.new(0, 64, 0, 16),
        Font = Enum.Font.GothamBold,
        Text = tostring(value) .. suffix,
        TextColor3 = Library.Theme.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 2,
        Parent = frame,
    })
    bindTheme(valueLabel, function(t) return { TextColor3 = t.Accent } end)

    local barBack = new("Frame", {
        Position = UDim2.new(0, 14, 1, -18),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = Library.Theme.Disabled,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(barBack, 3)
    bindTheme(barBack, function(t) return { BackgroundColor3 = t.Disabled } end)

    local barFill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Library.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = barBack,
    })
    corner(barFill, 3)
    makeGlow(barFill, Library.Theme.Accent, 0.5)
    bindTheme(barFill, function(t) return { BackgroundColor3 = t.Accent } end)

    local object = {}

    local function round(v)
        local mult = 10 ^ decimals
        return math.floor(v * mult + 0.5) / mult
    end

    function object:Set(v)
        value = round(math.clamp(v, min, max))
        if flag then Library.Flags[flag] = value end
        local alpha = (max - min == 0) and 0 or (value - min) / (max - min)
        tween(barFill, 0.12, { Size = UDim2.new(alpha, 0, 1, 0) }, Enum.EasingStyle.Quad)
        valueLabel.Text = tostring(value) .. suffix
        if opts.Callback then task.spawn(opts.Callback, value) end
    end
    function object:Get() return value end

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - barBack.AbsolutePosition.X) / barBack.AbsoluteSize.X, 0, 1)
        object:Set(min + (max - min) * rel)
    end

    track(barBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    if flag then
        Library.Flags[flag] = value
        Library.Options[flag] = object
    end
    object:Set(value)
    return object
end

