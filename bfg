    end

    local headBtn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 40),
        Text = "",
        ZIndex = 8,
        Parent = frame,
    })

    local object = {}
    local open = false
    local optionButtons = {}

    local function labelText()
        if multi then
            local parts = {}
            for _, v in ipairs(values) do
                if selected[v] then table.insert(parts, tostring(v)) end
            end
            return #parts > 0 and table.concat(parts, ", ") or "None"
        else
            return selected ~= nil and tostring(selected) or "None"
        end
    end

    local function refreshHighlights()
        for v, b in pairs(optionButtons) do
            local on = multi and selected[v] or (selected == v)
            tween(b, 0.15, {
                BackgroundColor3 = on and Library.Theme.Accent or Library.Theme.Inset,
                BackgroundTransparency = on and 0 or 0,
            })
            b.TextColor3 = on and Library.Theme.AccentText or Library.Theme.SubText
        end
        valueLabel.Text = labelText()
    end

    local function visibleCount()
        local c = 0
        for _, b in pairs(optionButtons) do
            if b.Visible then c = c + 1 end
        end
        return c
    end

    local function setHeight()
        if open then
            local listH = math.min(maxListHeight, listLayout.AbsoluteContentSize.Y)
            listContainer.Size = UDim2.new(1, -16, 0, listH)
            listContainer.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
            local base = searchable and 78 or 46
            tween(frame, SPEED, { Size = UDim2.new(1, 0, 0, base + listH + 8) })
            tween(arrow, SPEED, { Rotation = 180 })
            frame.ZIndex = 15
        else
            tween(frame, SPEED, { Size = UDim2.new(1, 0, 0, 40) })
            tween(arrow, SPEED, { Rotation = 0 })
            frame.ZIndex = 5
        end
    end

    function object:Set(v)
        if multi then
            selected = {}
            if typeof(v) == "table" then
                for _, item in ipairs(v) do selected[item] = true end
            end
            if flag then
                local arr = {}
                for _, val in ipairs(values) do
                    if selected[val] then table.insert(arr, val) end
                end
                Library.Flags[flag] = arr
            end
        else
            selected = v
            if flag then Library.Flags[flag] = selected end
        end
        refreshHighlights()
        if opts.Callback then task.spawn(opts.Callback, selected) end
    end
    function object:Get() return selected end

    function object:Refresh(newValues, keepSelection)
        values = newValues or values
        for _, b in pairs(optionButtons) do b:Destroy() end
        table.clear(optionButtons)
        for _, v in ipairs(values) do
            local optBtn = new("TextButton", {
                BackgroundColor3 = Library.Theme.Inset,
                Size = UDim2.new(1, 0, 0, 28),
                Font = Enum.Font.Gotham,
                Text = tostring(v),
                TextColor3 = Library.Theme.SubText,
                TextSize = 13,
                AutoButtonColor = false,
                ZIndex = 7,
                Parent = listContainer,
            })
            corner(optBtn, 7)
            optionButtons[v] = optBtn
            track(optBtn.MouseEnter:Connect(function()
                local on = multi and selected[v] or (selected == v)
                if not on then tween(optBtn, 0.12, { BackgroundColor3 = Library.Theme.SurfaceHi }) end
            end))
            track(optBtn.MouseLeave:Connect(function()
                local on = multi and selected[v] or (selected == v)
                if not on then tween(optBtn, 0.12, { BackgroundColor3 = Library.Theme.Inset }) end
            end))
            track(optBtn.MouseButton1Click:Connect(function()
                if multi then
                    selected[v] = (not selected[v]) or nil
                    local arr = {}
                    for _, val in ipairs(values) do
                        if selected[val] then table.insert(arr, val) end
                    end
                    object:Set(arr)
                    setHeight()
                else
                    object:Set(v)
                    open = false
                    setHeight()
                end
            end))
        end
        if not keepSelection then
            if multi then selected = {} else selected = nil end
        end
        refreshHighlights()
        if open then setHeight() end
    end

    if searchBox then
        track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local q = searchBox.Text:lower()
            for v, b in pairs(optionButtons) do
                b.Visible = q == "" or tostring(v):lower():find(q, 1, true) ~= nil
            end
            if open then setHeight() end
        end))
    end

    track(headBtn.MouseButton1Click:Connect(function()
        open = not open
        if open and Library._openDropdown and Library._openDropdown ~= object then
            Library._openDropdown:Close()
        end
        Library._openDropdown = open and object or nil
        setHeight()
    end))

    function object:Close()
        if open then
            open = false
            setHeight()
        end
    end

    object:Refresh(values, true)
    if multi and opts.Default then
        object:Set(opts.Default)
    elseif not multi and opts.Default ~= nil then
        object:Set(opts.Default)
    else
        refreshHighlights()
    end

    if flag then Library.Options[flag] = object end
    return object
end

