        BackgroundColor3 = Library.Theme.Inset,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    corner(barBack, 3)
    bindTheme(barBack, function(t) return { BackgroundColor3 = t.Inset } end)

    local barFill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Library.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = barBack,
    })
    corner(barFill, 3)
    bindTheme(barFill, function(t) return { BackgroundColor3 = t.Accent } end)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = barFill,
    })
    corner(knob, 6)

    local object = {}
    local function round(v)
        local mult = 10 ^ decimals
        return math.floor(v * mult + 0.5) / mult
    end

    function object:Set(v, skipCb)
        value = round(math.clamp(v, min, max))
        if flag then Library.Flags[flag] = value end
        local alpha = (max - min == 0) and 0 or (value - min) / (max - min)
        tween(barFill, 0.1, { Size = UDim2.new(alpha, 0, 1, 0) }, Enum.EasingStyle.Quad)
        valueLabel.Text = tostring(value) .. suffix
        if opts.Callback and not skipCb then task.spawn(opts.Callback, value) end
    end
    function object:Get() return value end

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - barBack.AbsolutePosition.X) / barBack.AbsoluteSize.X, 0, 1)
        object:Set(min + (max - min) * rel)
    end

    track(barBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    if flag then
        Library.Flags[flag] = value
        Library.Options[flag] = object
    end
    object:Set(value, true)
    return object
end

